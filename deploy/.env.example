# Copy this file to .env and fill the required first-run values.
# Everything else has a default in docker-compose.yml.
# Full optional reference: ../docs/05-runbooks/configuration.md

# Required first-run values
POSTGRES_PASSWORD=
LUMINAPATH_ADMIN_EMAIL=
LUMINAPATH_ADMIN_PASSWORD=

# Optional Docker secrets overlay. Leave POSTGRES_PASSWORD and
# LUMINAPATH_ADMIN_PASSWORD blank when using these host-side secret files.
# POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password.txt
# LUMINAPATH_ADMIN_PASSWORD_SECRET_FILE=./secrets/admin_password.txt

# Common optional overrides
# BACKEND_HTTP_PORT=8080
# BACKEND_HTTP_BIND=127.0.0.1
# FRONTEND_HTTP_PORT=4200
# RUN_MIGRATIONS_ON_STARTUP=true
# AUTH_REQUIRE_ADMIN_APPROVAL=true

# Set only when browsers call the API from a different origin than the API host.
# The included frontend container uses /api and proxies internally, so this is usually blank.
# FRONTEND_PUBLIC_URL=https://luminapath.yourdomain.com

# Storage defaults to local file-system storage.
# STORAGE_PROVIDER=FileSystem
# STORAGE_PATH=/app/App_Data/storage
# STORAGE_PROVIDER=Azure
# AZURE_BLOB_CONNECTION_STRING=
# AZURE_BLOB_CONTAINER_NAME=media

# Optional pinning. Defaults use the latest prebuilt Docker Hub images.
# LUMINAPATH_API_IMAGE=sekijuo/luminapath-api:latest
# LUMINAPATH_FRONTEND_IMAGE=sekijuo/luminapath-frontend:latest

# Optional Angular frontend runtime values.
# LUMINAPATH_API_ENDPOINT=/api
# LUMINAPATH_API_PROXY_TARGET=http://luminapath-api:8080
