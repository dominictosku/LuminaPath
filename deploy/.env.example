# Copy this file to .env and change the passwords/domains before starting.

# Prebuilt images from Docker Hub
LUMINAPATH_API_IMAGE=dominictosku/luminapath-api:latest
LUMINAPATH_FRONTEND_IMAGE=dominictosku/luminapath-frontend:latest

# Public ports
BACKEND_HTTP_PORT=8080
FRONTEND_HTTP_PORT=4200
POSTGRES_PORT=5432

# PostgreSQL
POSTGRES_VERSION=17-alpine
POSTGRES_DB=luminapath
POSTGRES_USER=luminapath
POSTGRES_PASSWORD=change-me

# Backend runtime
ASPNETCORE_ENVIRONMENT=Production
RUN_MIGRATIONS_ON_STARTUP=true
HTTPS_REDIRECT=false
FRONTEND_PUBLIC_URL=http://localhost:4200
IONIC_PUBLIC_URL=capacitor://localhost
CAPACITOR_ANDROID_PUBLIC_URL=http://localhost
CAPACITOR_ANDROID_HTTPS_PUBLIC_URL=https://localhost
AUTH_COOKIE_SAMESITE=None
AUTH_COOKIE_SECURE_POLICY=Always

# Storage
STORAGE_PROVIDER=FileSystem
STORAGE_PATH=/app/App_Data/storage
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=media

# Angular frontend runtime
# Keep /api when using the included frontend container.
LUMINAPATH_API_ENDPOINT=/api
LUMINAPATH_API_PROXY_TARGET=http://luminapath-api:8080
