# Copy this file to .env and fill every blank secret/domain before starting.

# Prebuilt images from Docker Hub
LUMINAPATH_API_IMAGE=dominictosku/luminapath-api:latest
LUMINAPATH_FRONTEND_IMAGE=dominictosku/luminapath-frontend:latest

# Public ports
BACKEND_HTTP_PORT=8080
FRONTEND_HTTP_PORT=4200

# PostgreSQL
POSTGRES_VERSION=17-alpine
POSTGRES_DB=luminapath
POSTGRES_USER=luminapath
POSTGRES_PASSWORD=

# Backend runtime
ASPNETCORE_ENVIRONMENT=Production
RUN_MIGRATIONS_ON_STARTUP=true
HTTPS_REDIRECT=false
FRONTEND_PUBLIC_URL=https://luminapath.luminakeep.com
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE_POLICY=Always
# When true, new self-registrations land as IsActive=false and need an
# admin to flip the toggle from /Admin/Users before they can sign in.
# Defaults to true (production-safe). Set to false to allow immediate
# sign-in after self-registration.
AUTH_REQUIRE_ADMIN_APPROVAL=true

# Seed admin (used ONLY on first boot when no admin user exists yet).
# Password policy: >= 10 chars, >= 4 unique, must contain upper + lower
# + digit + non-alphanumeric.
LUMINAPATH_ADMIN_EMAIL=
LUMINAPATH_ADMIN_PASSWORD=

# Storage
STORAGE_PROVIDER=FileSystem
STORAGE_PATH=/app/App_Data/storage
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=media

# Angular frontend runtime
# Keep /api when using the included frontend container.
LUMINAPATH_API_ENDPOINT=/api
LUMINAPATH_API_PROXY_TARGET=http://luminapath-api:8080
