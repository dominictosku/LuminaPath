@page "/Games"
@using AutoMapper
@using LuminaPath.Core.Common.Entities
@using LuminaPath.MauiClientApp.Database
@using LuminaPath.MauiClientApp.Components.Media
@using LuminaPath.MauiClientApp.Models
@using LuminaPath.MauiClientApp.ViewModel
@using LuminaPath.UI.Shared.Interfaces
@using LuminaPath.UI.Shared.Media
@using Microsoft.EntityFrameworkCore
@using Core.Common.Enums
@inject NavigationManager navigation
@inject LuminaDatabase database
@inject IMapper mapper
@implements ITableActions<GameViewModel>

<PageTitle>Games</PageTitle>

<h1>Games</h1>
<MudButton OnClick="SwitchView" Variant="Variant.Filled" Color="Color.Primary">@ToggleText</MudButton>
<AdvancedSearch Model="_filter" OnConditionChanged="ReloadData" />
@if (IsGrid){
	<MudDataGrid ServerData="@(ServerReload)"
				 FixedHeader="true"
				 FixedFooter="true"
				 Virtualize="true"
				 Height="calc(100vh - 370px)"
				 Loading="@loading"
				 MultiSelection="true"
				 @bind-SelectedItems="selectedItems"
				 @bind-SelectedItem="_currentDto"
				 Hover="true" @ref="_table">
		<ToolBarContent>
			<TableActions TItem="GameViewModel" Page="this" loading="loading" selectedItems="selectedItems" />
		</ToolBarContent>
		<Columns>
			<SelectColumn ShowInFooter="false"></SelectColumn>
			<TemplateColumn CellStyle="width:60px" Title="Actions" Sortable="false">
				<CellTemplate>
					<MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" DisableElevation="true" Size="Size.Small"
							 Dense="true"
							 EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
						<MudMenuItem OnClick="@(() => OnUpdate(context.Item))">Edit</MudMenuItem>

						<MudMenuItem OnClick="@(() => Delete(context.Item))">Delete</MudMenuItem>
					</MudMenu>
				</CellTemplate>
			</TemplateColumn>

			<PropertyColumn Property="x => x.Name" Title="Title">
				<CellTemplate>
					<div class="d-flex flex-column">
						<MudText Typo="Typo.body2">@context.Item.Name</MudText>
							<MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Description</MudText>
						</div>
				</CellTemplate>
			</PropertyColumn>
			<PropertyColumn Property="x => x.Genre" Title="Genre" />
			<PropertyColumn Property="x => x.MyGame == null ? ProgressionStatus.Planned : x.MyGame.Status" Title="Status" />
		</Columns>
		<NoRecordsContent>
			<MudText>No items found</MudText>
		</NoRecordsContent>
		<LoadingContent>
			<MudText>Loading</MudText>
		</LoadingContent>
		<PagerContent>
			<MudDataGridPager />
		</PagerContent>
	</MudDataGrid>
}
else
{
	<MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="background-color:#121e2d;">
		<MudToolBar class="mud-table-toolbar">
			<TableActions Page="this" loading="loading" selectedItems="selectedItems" />
		</MudToolBar>
		<MudGrid Spacing="2">
			@foreach (var game in Games)
			{
				<MudItem>
					<MudCard Outlined="true">
						<MudCardMedia Image="@game.Image?.Path" Height="200" />
						<MudCardContent Style="height:80px;">
							<MudText Typo="Typo.h5">@game.Name</MudText>
								<MudText Typo="Typo.body2">@game.Description</MudText>
						</MudCardContent>
						<MudCardActions Style="height:50px;">
							<MudButton OnClick="@(() => OnUpdate(game))" Variant="Variant.Text" Color="Color.Primary">Edit</MudButton>
							<MudButton Variant="Variant.Text" Color="Color.Primary">Add To List</MudButton>
						</MudCardActions>
					</MudCard>
				</MudItem>
			}
		</MudGrid>
	</MudContainer>
}

<style>
	@@import url("https://cdn.jsdelivr.net/npm/@@fancyapps/ui@5.0/dist/fancybox/fancybox.css");

	.fancybox__container {
		--fancybox-bg: rgba(24, 24, 27, 0.85);
		z-index: 9999;
	}

	.mud-table-toolbar {
		height: 120px !important;
	}
</style>

@code{
	private List<GameViewModel> Games = new();
	private MudDataGrid<GameViewModel> _table = default!;
	private GameViewModel _currentDto = new();
	private MediaFilter _filter = new();

	public bool IsGrid = true;
	public bool loading;
	public HashSet<GameViewModel> selectedItems = new();
	public string ToggleText => IsGrid ? "Grid View" : "Table View";

	protected override async Task OnInitializedAsync()
	{
		await database.Init();
	}

	private async Task<GridData<GameViewModel>> ServerReload(GridState<GameViewModel> state)
	{
		selectedItems = new HashSet<GameViewModel>();
		loading = true;
		try
		{
			var result = await GetData(state.Page + 1);

			return new GridData<GameViewModel> { TotalItems = result.Count(), Items = result };
		}
		finally
		{
			loading = false;
		}
	}

	public async Task ReloadData()
	{
		if (IsGrid)
		{
			await _table.ReloadServerData();
		}
		else
		{
			Games = await GetData(1);
			StateHasChanged();
		}
	}

	private async Task SwitchView()
	{
		IsGrid = !IsGrid;
		await ReloadData();
	}

	private async Task<PaginatedList<GameViewModel>> GetData(int pageIndex)
	{
		_filter.Paging = new Paging(pageIndex, 15);
		var localGames = await database.Games.GetItemsAsync() ?? new List<LocalGame>();
		var games = localGames.Select(x => new GameViewModel(x)).ToList();
		var myGames = await database.MyGames.GetItemsAsync();
		games.ForEach(g => g.MyGame = myGames.FirstOrDefault(m => m.GameId == g.Id));
		return PaginatedList<GameViewModel>.Create(games, 0, 100);
	}

	public void Dummy()
	{

	}

	#region Events
	public async Task OnCreate()
	{
		var command = new GameViewModel();
		var parameters = new DialogParameters<MediaFormDialog>
		{
			{ x=>x.Refresh , new Action(async () => await ReloadData()) },
			{ x=>x.Model, command },
			{ x=>x.loading, loading },
			{ x=>x.EventCallBack, CreateGame }
		};
		var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
		var dialog = DialogService.Show<MediaFormDialog>("Create Game", parameters, options);
		var state = await dialog.Result;
		if (!state.Canceled)
			await ReloadData();
	}

	public async Task OnUpdate(GameViewModel g)
	{
		var command = g;
		var parameters = new DialogParameters<MediaFormDialog>
		{
			{ x=>x.Refresh , new Action(async () => await ReloadData()) },
			{ x=>x.Model, command },
			{ x=>x.loading, loading },
			{ x=>x.EventCallBack, UpdateGame }
		};
		var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
		var dialog = DialogService.Show<MediaFormDialog>("Update Game", parameters, options);
		var state = await dialog.Result;
		if (!state.Canceled)
			await ReloadData();
	}

	public async Task OnDeleteChecked()
	{
		var ids = selectedItems.Select(x => x.Id).ToArray();

		foreach (var id in ids)
		{
			LocalGame existing = await database.Games.GetItemAsync(id) ?? throw new Exception("id not found");
			await database.Games.DeleteItemAsync(existing);
		}
		await ReloadData();
	}

	#endregion

	#region CRUD Actions
	async Task CreateGame(GameViewModel game)
	{
		loading = true;
		try
		{
			var myGame = game.MyGame;
			var LocalGame = mapper.Map<LocalGame>(game);
			var gameId = await database.Games.SaveItemAsync(LocalGame);
			if (myGame is not null)
			{
				myGame.GameId = gameId;
				await database.MyGames.SaveItemAsync(myGame);
			}
			Snackbar.Add("Created Game", Severity.Success);
		}
		catch (Exception ex)
		{
			Snackbar.Add("Failed to create Game", Severity.Error);
			loading = false;
		}

		await ReloadData();
		loading = false;
	}

	async Task UpdateGame(GameViewModel game)
	{
		loading = true;
		try
		{
			var myGame = game.MyGame;
			var LocalGame = mapper.Map<LocalGame>(game);
			await database.Games.SaveItemAsync(LocalGame);
			if (myGame is not null)
			{
				myGame.GameId = game.Id;
				await database.MyGames.SaveItemAsync(myGame);
			}
			Snackbar.Add("Updated Game", Severity.Success);
		}
		catch (Exception ex)
		{
			Snackbar.Add("Failed to update Game", Severity.Error);
			loading = false;
		}

		await ReloadData();
		loading = false;
	}

	public async Task Delete(GameViewModel game)
	{
		var myGame = game.MyGame;
		var LocalGame = mapper.Map<LocalGame>(game);
		await database.Games.DeleteItemAsync(LocalGame);
		if (myGame is not null)
		{
			myGame.GameId = game.Id;
			await database.MyGames.DeleteItemAsync(myGame);
		}

		Snackbar.Add("Deleted Game", Severity.Info);
		await ReloadData();
	}
	#endregion
}

