@page "/Games"
@using AutoMapper
@using LuminaPath.MauiClientApp.Database
@using LuminaPath.MauiClientApp.Components.Media
@using Microsoft.EntityFrameworkCore
@inject NavigationManager navigation
@inject GamesDatabase database;
@inject IMapper mapper;

<PageTitle>Games</PageTitle>

<h1>Games</h1>
<MudButton OnClick="SwitchView" Variant="Variant.Filled" Color="Color.Primary">@ToggleText</MudButton>
<AdvancedSearch Model="_filter" OnConditionChanged="ReloadData" />
@if (IsGrid){
	<MudDataGrid ServerData="@(ServerReload)"
				 FixedHeader="true"
				 FixedFooter="true"
				 Virtualize="true"
				 Height="calc(100vh - 370px)"
				 Loading="@loading"
				 MultiSelection="true"
				 @bind-SelectedItems="selectedItems"
				 @bind-SelectedItem="_currentDto"
				 Hover="true" @ref="_table">
		<ToolBarContent>
			<TableActions Page="this" loading="loading" selectedItems="selectedItems" />
		</ToolBarContent>
		<Columns>
			<SelectColumn ShowInFooter="false"></SelectColumn>
			<TemplateColumn CellStyle="width:60px" Title="Actions" Sortable="false">
				<CellTemplate>
					<MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" DisableElevation="true" Size="Size.Small"
							 Dense="true"
							 EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
						<MudMenuItem OnClick="@(() => OnUpdate(context.Item))">Edit</MudMenuItem>

						<MudMenuItem OnClick="@(() => Delete(context.Item))">Delete</MudMenuItem>
					</MudMenu>
				</CellTemplate>
			</TemplateColumn>

			<PropertyColumn Property="x => x.Name" Title="Title">
				<CellTemplate>
					<div class="d-flex flex-column">
						<MudText Typo="Typo.body2">@context.Item.Name</MudText>
							<MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Description</MudText>
						</div>
				</CellTemplate>
			</PropertyColumn>
			<PropertyColumn Property="x => x.Genre" Title="Genre" />
		</Columns>
		<NoRecordsContent>
			<MudText>No items found</MudText>
		</NoRecordsContent>
		<LoadingContent>
			<MudText>Loading</MudText>
		</LoadingContent>
		<PagerContent>
			<MudDataGridPager />
		</PagerContent>
	</MudDataGrid>
}
else
{
	<MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="background-color:#121e2d;">
		<MudToolBar class="mud-table-toolbar">
			<TableActions Page="this" loading="loading" selectedItems="selectedItems" />
		</MudToolBar>
		<MudGrid Spacing="2">
			@foreach (var game in Games)
			{
				<MudItem>
					<MudCard Outlined="true">
						<MudCardMedia Image="@game.Image?.Uri" Height="200" />
						<MudCardContent Style="height:80px;">
							<MudText Typo="Typo.h5">@game.Name</MudText>
								<MudText Typo="Typo.body2">@game.Description</MudText>
						</MudCardContent>
						<MudCardActions Style="height:50px;">
							<MudButton OnClick="@(() => OnUpdate(game))" Variant="Variant.Text" Color="Color.Primary">Edit</MudButton>
							<MudButton Variant="Variant.Text" Color="Color.Primary">Add To List</MudButton>
						</MudCardActions>
					</MudCard>
				</MudItem>
			}
		</MudGrid>
	</MudContainer>
}

<style>
	@@import url("https://cdn.jsdelivr.net/npm/@@fancyapps/ui@5.0/dist/fancybox/fancybox.css");

	.fancybox__container {
		--fancybox-bg: rgba(24, 24, 27, 0.85);
		z-index: 9999;
	}

	.mud-table-toolbar {
		height: 120px !important;
	}
</style>

