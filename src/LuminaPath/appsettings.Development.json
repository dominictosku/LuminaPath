{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=luminapath;Username=luminapath;Password=dbuserpassword;",
    "Redis": "localhost:6379"
  },
  "Azure": {
    "BlobConnectionString": "DefaultEndpointsProtocol=https;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;",
    "BlobContainerName": "media"
  },
  "Storage": {
    "Provider": "FileSystem",
    "Path": "App_Data/storage"
  },
  "DatabaseBackup": {
    "Directory": "App_Data/storage/backups",
    "PgDumpPath": "pg_dump",
    "FilePrefix": "luminapath",
    "MaxListedBackups": 20
  },
  "BackgroundJobs": {
    "ScheduledBackupsEnabled": false,
    "BackupIntervalHours": 24,
    "BackupRetentionCount": 10,
    "JobHistoryRetentionDays": 30,
    "MaintenanceIntervalHours": 6
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8100",
      "https://localhost:8100",
      "http://localhost:4200",
      "https://localhost:4200",
      "http://localhost",
      "https://localhost",
      "capacitor://localhost",
      "ionic://localhost"
    ]
  },
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "Https": {
    "Redirect": true
  },
  "GameMetadata": {
    "Provider": "IgdbThenRawg",
    "IgdbClientId": "",
    "IgdbClientSecret": "",
    "TwitchTokenUrl": "https://id.twitch.tv/oauth2/token",
    "IgdbBaseUrl": "https://api.igdb.com/v4",
    "RawgApiKey": "",
    "RawgBaseUrl": "https://api.rawg.io/api"
  },
  "AiChat": {
    "Provider": "OpenAi"
  },
  "Anthropic": {
    "ApiKey": ""
  },
  "OpenAi": {
    "ApiKey": "",
    "BaseUrl": "http://localhost:1234/v1",
    "Model": "text-embedding-nomic-embed-text-v1.5"
  },
  "Mcp": {
    "Servers": [
      {
        "Name": "brave-search",
        "Enabled": true,
        "Command": "npx",
        "Args": [ "-y", "@modelcontextprotocol/server-brave-search" ],
        "Env": {
          "BRAVE_API_KEY": ""
        }
      }
    ]
  }
}
