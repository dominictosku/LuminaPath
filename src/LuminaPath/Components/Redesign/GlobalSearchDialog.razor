@using LuminaPath.Core.Dtos
@using LuminaPath.Core.Entities
@using LuminaPath.Infrastructure.Services.ModelServices
@inject GlobalSearchService GlobalSearchService
@inject GameService GameService
@inject MovieService MovieService
@inject SeriesService SeriesService
@inject AnimeService AnimeService
@inject NavigationManager NavigationManager

@if (IsOpen)
{
    <div class="lumina-modal-backdrop" @onclick="Close">
        <div class="search-card" role="dialog" aria-modal="true" aria-label="Search your universe" @onclick:stopPropagation="true">
            <div class="search-input-row">
                <input class="input"
                       type="search"
                       placeholder="Search games, movies, series, anime, quests…"
                       aria-label="Search your universe"
                       value="@_query"
                       @oninput="HandleInput"
                       autofocus />
                <button class="btn btn-ghost" type="button" @onclick="Close">Esc</button>
            </div>

            <div class="search-results">
                @if (_loading)
                {
                    <div class="search-row">
                        <span>Searching your universe…</span>
                        <small>✧</small>
                    </div>
                }
                else if (_entries.Count == 0)
                {
                    <div class="search-row">
                        <span>No matching worlds found.</span>
                        <small>Try another keyword</small>
                    </div>
                }
                else
                {
                    @foreach (var entry in _entries)
                    {
                        <button type="button" class="search-row" @onclick="@(() => SelectEntry(entry))">
                            <span>@entry.Icon <strong>@entry.Title</strong> · <small>@entry.Subtitle</small></span>
                            <small>@entry.RightLabel →</small>
                        </button>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string? UserId { get; set; }

    private string _query = string.Empty;
    private bool _loading;
    private bool _wasOpen;
    private List<SearchEntry> _entries = [];

    private sealed record SearchEntry(string Icon, string Title, string Subtitle, string RightLabel, string TargetUrl);

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _query = string.Empty;
            await LoadSuggestionsAsync();
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
        }
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_query) || _query.Trim().Length < 2)
        {
            await LoadSuggestionsAsync();
            return;
        }

        _loading = true;
        try
        {
            var term = _query.Trim();
            var list = new List<SearchEntry>();

            if (!string.IsNullOrWhiteSpace(UserId))
            {
                var userResults = await GlobalSearchService.SearchAsync(UserId, term, 8);
                foreach (var hit in userResults)
                {
                    var (icon, targetUrl) = hit.MediaKind switch
                    {
                        "games" => ("⌘", $"/library?type=game&q={Uri.EscapeDataString(hit.Title)}"),
                        "movies" => ("▻", $"/library?type=movie&q={Uri.EscapeDataString(hit.Title)}"),
                        "series" => ("▤", $"/library?type=series&q={Uri.EscapeDataString(hit.Title)}"),
                        "animes" => ("▤", $"/library?type=anime&q={Uri.EscapeDataString(hit.Title)}"),
                        "quests" => ("⚔", "/quests"),
                        _ => ("✧", "/library")
                    };
                    list.Add(new SearchEntry(icon, hit.Title, hit.Subtitle, hit.Kind == "quest" ? "Quest" : "Library", targetUrl));
                }
            }

            var filter = new MediaFilter
            {
                SearchString = term,
                Paging = new Paging(1, 4)
            };

            var games = await GameService.GetAllPaginated(filter, GameService.Includes);
            foreach (var g in games)
            {
                if (list.All(x => !string.Equals(x.Title, g.Name, StringComparison.OrdinalIgnoreCase)))
                {
                    list.Add(new SearchEntry("⌘", g.Name, $"Game · {(g.Genres.FirstOrDefault() ?? "Catalog")}", g.Source, $"/catalog?type=game&q={Uri.EscapeDataString(g.Name)}"));
                }
            }

            var movies = await MovieService.GetAllPaginated(filter, MovieService.Includes);
            foreach (var m in movies)
            {
                if (list.All(x => !string.Equals(x.Title, m.Name, StringComparison.OrdinalIgnoreCase)))
                {
                    list.Add(new SearchEntry("▻", m.Name, $"Movie · {(m.Genres.FirstOrDefault() ?? "Catalog")}", m.Source, $"/catalog?type=movie&q={Uri.EscapeDataString(m.Name)}"));
                }
            }

            var series = await SeriesService.GetAllPaginated(filter, SeriesService.Includes);
            foreach (var s in series)
            {
                if (list.All(x => !string.Equals(x.Title, s.Name, StringComparison.OrdinalIgnoreCase)))
                {
                    list.Add(new SearchEntry("▤", s.Name, $"Series · {(s.Genres.FirstOrDefault() ?? "Catalog")}", s.Source, $"/catalog?type=series&q={Uri.EscapeDataString(s.Name)}"));
                }
            }

            var animes = await AnimeService.GetAllPaginated(filter, AnimeService.Includes);
            foreach (var a in animes)
            {
                if (list.All(x => !string.Equals(x.Title, a.Name, StringComparison.OrdinalIgnoreCase)))
                {
                    list.Add(new SearchEntry("▤", a.Name, $"Anime · {(a.Genres.FirstOrDefault() ?? "Catalog")}", a.Source, $"/catalog?type=anime&q={Uri.EscapeDataString(a.Name)}"));
                }
            }

            _entries = list.Take(10).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSuggestionsAsync()
    {
        _loading = true;
        try
        {
            var list = new List<SearchEntry>();
            var filter = new MediaFilter { Paging = new Paging(1, 3) };

            var games = await GameService.GetAllPaginated(filter, GameService.Includes);
            foreach (var g in games)
            {
                list.Add(new SearchEntry("⌘", g.Name, $"Game · {(g.Genres.FirstOrDefault() ?? "Catalog")}", g.Source, $"/catalog?type=game&q={Uri.EscapeDataString(g.Name)}"));
            }

            var animes = await AnimeService.GetAllPaginated(filter, AnimeService.Includes);
            foreach (var a in animes)
            {
                list.Add(new SearchEntry("▤", a.Name, $"Anime · {(a.Genres.FirstOrDefault() ?? "Catalog")}", a.Source, $"/catalog?type=anime&q={Uri.EscapeDataString(a.Name)}"));
            }

            var movies = await MovieService.GetAllPaginated(filter, MovieService.Includes);
            foreach (var m in movies)
            {
                list.Add(new SearchEntry("▻", m.Name, $"Movie · {(m.Genres.FirstOrDefault() ?? "Catalog")}", m.Source, $"/catalog?type=movie&q={Uri.EscapeDataString(m.Name)}"));
            }

            var series = await SeriesService.GetAllPaginated(filter, SeriesService.Includes);
            foreach (var s in series)
            {
                list.Add(new SearchEntry("▤", s.Name, $"Series · {(s.Genres.FirstOrDefault() ?? "Catalog")}", s.Source, $"/catalog?type=series&q={Uri.EscapeDataString(s.Name)}"));
            }

            _entries = list.Take(8).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectEntry(SearchEntry entry)
    {
        await Close();
        NavigationManager.NavigateTo(entry.TargetUrl);
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
