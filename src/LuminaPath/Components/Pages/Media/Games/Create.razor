@page "/Media/Games/create"
@using Core.Models.Gaming
@inject LuminaPathDbContext context
@inject NavigationManager navManager

<h1>Create Game</h1>
<br />

<Form ButtonText="Add" Game="@Game" loading="@loading"
      OnValidSubmit="@CreateGame" />

@code {
    bool loading = false;

    Game Game = new Game();

    async Task CreateGame()
    {
        loading = true;
        try
        {
            await context.Games.AddAsync(Game);
            await context.SaveChangesAsync();
            navManager.NavigateTo("/Media/Games");
        }
        catch (Exception ex)
        {
            loading = false;
            StateHasChanged();
        }
    }
}