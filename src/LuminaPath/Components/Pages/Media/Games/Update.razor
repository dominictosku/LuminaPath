@page "/Media/Games/Update/{id}"
@using Core.Models.Gaming
@using AutoMapper
@using LuminaPath.ViewModel
@inject IMapper mapper
@inject LuminaPathDbContext context
@inject NavigationManager navManager

<h1>Edit Game</h1>
<br />

<Form ButtonText="Update" Game="@Game" loading="@loading"
      OnValidSubmit="@UpdateGame" />

@code {
    bool loading = false;

    [Parameter]
    public string Id { get; set; }

    GameViewModel Game = new GameViewModel();

    protected async override Task OnParametersSetAsync()
    {
        var game = await context.Games.FindAsync(int.Parse(Id)) ?? new Game();
        Game = mapper.Map<Game, GameViewModel>(game);
    }

    async Task UpdateGame()
    {
        loading = true;
        try
        {
            context.Games.Update(Game);
            await context.SaveChangesAsync();
            navManager.NavigateTo("/Media/Games");
        }
        catch (Exception ex)
        {
            loading = false;
            StateHasChanged();
        }
    }
}