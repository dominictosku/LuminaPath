@implements IDisposable
@inject NavigationManager NavigationManager

<a class="brand" href="" @onclick="HandleNavClick">
    <span class="brand-mark" aria-hidden="true">
        <img src="Images/luminapath-logo.png" alt="LuminaPath" />
    </span>
    <div>
        <strong>LuminaPath</strong>
        <small>MAKE TIME FOR YOUR WORLD</small>
    </div>
</a>

<div class="nav-label">YOUR UNIVERSE</div>
<nav aria-label="Universe navigation">
    <NavLink class="nav-button" href="" Match="NavLinkMatch.All" @onclick="HandleNavClick">
        <span aria-hidden="true">⌂</span><span>Overview</span>
    </NavLink>
    <a class="nav-button @(IsLibraryRoute ? "active" : "")" href="library" @onclick="HandleNavClick">
        <span aria-hidden="true">▦</span><span>My library</span>
    </a>
    <a class="nav-button @(IsCatalogRoute ? "active" : "")" href="catalog" @onclick="HandleNavClick">
        <span aria-hidden="true">✦</span><span>Discover</span>
    </a>

    <div class="nav-divider"></div>

    <NavLink class="nav-button" href="quests" @onclick="HandleNavClick">
        <span aria-hidden="true">⚔</span><span>Quest board</span>
    </NavLink>
    <NavLink class="nav-button" href="statistics" @onclick="HandleNavClick">
        <span aria-hidden="true">◔</span><span>Statistics</span>
    </NavLink>

    <AuthorizeView>
        <Authorized>
            <NavLink class="nav-button" href="import" @onclick="HandleNavClick">
                <span aria-hidden="true">⇄</span><span>Import &amp; sync</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Administrator, Editor">
        <Authorized>
            <NavLink class="nav-button" href="Documents" @onclick="HandleNavClick">
                <span aria-hidden="true">▤</span><span>Documents</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Administrator">
        <Authorized>
            <div class="nav-divider"></div>
            <div class="nav-label">ADMINISTRATION</div>
            <NavLink class="nav-button" href="Admin/Overview" @onclick="HandleNavClick">
                <span aria-hidden="true">⚙</span><span>Admin overview</span>
            </NavLink>
            <NavLink class="nav-button" href="Admin/Users" @onclick="HandleNavClick">
                <span aria-hidden="true">☺</span><span>Users</span>
            </NavLink>
            <NavLink class="nav-button" href="settings" @onclick="HandleNavClick">
                <span aria-hidden="true">⚡</span><span>Settings</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
</nav>

<div class="sidebar-bottom">
    <AuthorizeView>
        <Authorized Context="auth">
            <a class="profile" href="Account/Manage">
                <span class="avatar">@GetInitial(auth.User.Identity?.Name)</span>
                <span class="profile-info">
                    <strong>@GetShortName(auth.User.Identity?.Name)</strong>
                    <small><i class="dot"></i> Exploring</small>
                </span>
                <em aria-hidden="true">⋯</em>
            </a>
        </Authorized>
        <NotAuthorized>
            <a class="profile" href="Account/Login">
                <span class="avatar">G</span>
                <span class="profile-info">
                    <strong>Guest</strong>
                    <small><i class="dot"></i> Sign in</small>
                </span>
                <em aria-hidden="true">→</em>
            </a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    private string _currentPath = string.Empty;

    private bool IsLibraryRoute =>
        _currentPath.StartsWith("library", StringComparison.OrdinalIgnoreCase)
        || _currentPath.StartsWith("Media/Library", StringComparison.OrdinalIgnoreCase)
        || _currentPath.StartsWith("Media/My", StringComparison.OrdinalIgnoreCase);

    private bool IsCatalogRoute =>
        _currentPath.StartsWith("catalog", StringComparison.OrdinalIgnoreCase)
        || _currentPath.StartsWith("Media/Catalog", StringComparison.OrdinalIgnoreCase)
        || _currentPath.StartsWith("Media/Games", StringComparison.OrdinalIgnoreCase)
        || _currentPath.StartsWith("Media/Animes", StringComparison.OrdinalIgnoreCase)
        || _currentPath.StartsWith("Media/Movies", StringComparison.OrdinalIgnoreCase)
        || _currentPath.StartsWith("Media/Series", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        UpdatePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdatePath(e.Location);
        StateHasChanged();
    }

    private void UpdatePath(string uri)
    {
        var relative = NavigationManager.ToBaseRelativePath(uri);
        var qIndex = relative.IndexOf('?');
        _currentPath = qIndex >= 0 ? relative[..qIndex] : relative;
    }

    private Task HandleNavClick() => OnNavigate.InvokeAsync();

    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "L";
        return char.ToUpperInvariant(name.Trim()[0]).ToString();
    }

    private static string GetShortName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "Explorer";
        var atIndex = name.IndexOf('@');
        return atIndex > 0 ? name[..atIndex] : name;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
