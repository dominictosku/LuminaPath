@implements IDisposable

@inject NavigationManager NavigationManager

<div class="nav-highlight">
	<nav class="flex-column">
		<div class="nav-item px-3">
			<NavLink class="nav-link" href="" Match="NavLinkMatch.All">
				<MudIcon Icon="@Icons.Material.Filled.Home" Title="Home" />
				<span class="bi" aria-hidden="true"></span> Home
			</NavLink>
		</div>

		<div class="nav-item px-3">
			<NavLink class="nav-link" href="Media/Games">
				<MudIcon Icon="@Icons.Material.Filled.Games" Title="Games" />
				<span class="bi" aria-hidden="true"></span> Games
			</NavLink>
		</div>

		<AuthorizeView>
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="Media/MyGames">
						<MudIcon Icon="@Icons.Material.Filled.BookmarkAdd" Title="MyGames" />
						<span class="bi" aria-hidden="true"></span> My Games
					</NavLink>
				</div>

				<div class="nav-item px-3">
					<NavLink class="nav-link" href="Documents">
						<MudIcon Icon="@Icons.Material.Filled.FileOpen" Title="MyGames" />
						<span class="bi" aria-hidden="true"></span> Documents
					</NavLink>
				</div>

				<div class="nav-item px-3">
					<NavLink class="nav-link" href="import">
						<MudIcon Icon="@Icons.Material.Filled.Downloading" Title="Import" />
						<span class="bi" aria-hidden="true"></span> Import
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView Roles="Administrator">
			<Authorized>
				<MudNavGroup Class="nav-item px-3" Title="Admin" Expanded="true">
					<div class="nav-item px-3">
						<NavLink class="nav-link" href="Admin/Users">
							<MudIcon Icon="@Icons.Material.Filled.Group" Title="Users" />
							<span class="bi" aria-hidden="true"></span> Users
						</NavLink>
					</div>

					<div class="nav-item px-3">
						<NavLink class="nav-link" href="settings">
							<MudIcon Icon="@Icons.Material.Filled.Settings" Title="Settings" />
							<span class="bi" aria-hidden="true"></span> Settings
						</NavLink>
					</div>
				</MudNavGroup>
			</Authorized>
		</AuthorizeView>

		<MudDivider DividerType="DividerType.FullWidth" Light="true" Class="my-2" />


		<AuthorizeView>
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="Account/Manage">
						<MudIcon Icon="@Icons.Material.Filled.Person" Title="Me" />
						<span class="bi" aria-hidden="true"></span> @context.User.Identity?.Name
					</NavLink>
				</div>
				<div class="nav-item px-3">
					<form action="Account/Logout" method="post">
						<AntiforgeryToken />
						<input type="hidden" name="ReturnUrl" value="@currentUrl" />
						<button type="submit" class="nav-link">
							<MudIcon Icon="@Icons.Material.Filled.Logout" Title="Logout" />
							<span class="bi" aria-hidden="true"></span> Logout
						</button>
					</form>
				</div>
			</Authorized>
			<NotAuthorized>
@* 				<div class="nav-item px-3">
					<NavLink class="nav-link" href="Account/Register">
						<MudIcon Icon="@Icons.Material.Filled.AppRegistration" Title="Register" />
						<span class="bi" aria-hidden="true"></span> Register
					</NavLink>
				</div> *@
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="Account/Login">
						<MudIcon Icon="@Icons.Material.Filled.Login" Title="Login" />
						<span class="bi" aria-hidden="true"></span> Login
					</NavLink>
				</div>
			</NotAuthorized>
		</AuthorizeView>
	</nav>
</div>

@code {
	private string? currentUrl;

	protected override void OnInitialized()
	{
		currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
		NavigationManager.LocationChanged += OnLocationChanged;
	}

	private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
	{
		currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
		StateHasChanged();
	}

	public void Dispose()
	{
		NavigationManager.LocationChanged -= OnLocationChanged;
	}
}

