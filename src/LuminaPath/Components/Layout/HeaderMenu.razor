@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="topbar-popover-wrap">
    <button class="icon-btn @(_themeMenuOpen ? "active" : "")"
            type="button"
            title="Switch theme preset"
            aria-label="Switch theme preset"
            aria-expanded="@(_themeMenuOpen ? "true" : "false")"
            @onclick="ToggleThemeMenu">
        🎨
    </button>

    @if (_themeMenuOpen)
    {
        <div class="topbar-popover theme-popover" role="region" aria-label="Theme selector">
            <h4>Application theme</h4>
            <div class="theme-options">
                <button type="button"
                        class="theme-option @(_currentTheme == "default" ? "active" : "")"
                        @onclick="@(() => SelectThemeAsync("default"))">
                    <span class="theme-swatch theme-swatch--mint"></span>
                    <div class="theme-info">
                        <strong>Lumina Emerald</strong>
                        <small>Fresh mint &amp; obsidian (Current)</small>
                    </div>
                    @if (_currentTheme == "default")
                    {
                        <span class="theme-check">✓</span>
                    }
                </button>
                <button type="button"
                        class="theme-option @(_currentTheme == "blue" ? "active" : "")"
                        @onclick="@(() => SelectThemeAsync("blue"))">
                    <span class="theme-swatch theme-swatch--blue"></span>
                    <div class="theme-info">
                        <strong>Classic Sapphire</strong>
                        <small>Deep navy &amp; cool blue (Old blue)</small>
                    </div>
                    @if (_currentTheme == "blue")
                    {
                        <span class="theme-check">✓</span>
                    }
                </button>
            </div>
        </div>
    }
</div>

<div class="topbar-popover-wrap">
    <button class="icon-btn @(_notificationsOpen ? "active" : "")"
            type="button"
            aria-label="Notifications and quick actions"
            aria-expanded="@(_notificationsOpen ? "true" : "false")"
            @onclick="ToggleNotifications">
        🔔<span class="ping"></span>
    </button>

    @if (_notificationsOpen)
    {
        <div class="topbar-popover" role="region" aria-label="Quick universe updates">
            <h4>Universe pulse</h4>
            <div class="topbar-popover-list">
                <a class="topbar-popover-item" href="quests" @onclick="CloseNotifications">
                    <span>⚔ Check daily quests</span>
                    <strong>+XP →</strong>
                </a>
                <a class="topbar-popover-item" href="library" @onclick="CloseNotifications">
                    <span>▦ Continue active stories</span>
                    <strong>Library →</strong>
                </a>
                <a class="topbar-popover-item" href="import" @onclick="CloseNotifications">
                    <span>⇄ Sync Steam / PSN / Excel</span>
                    <strong>Sync →</strong>
                </a>
            </div>
        </div>
    }
</div>

<AuthorizeView>
    <Authorized Context="authContext">
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="account-menu">
            <ActivatorContent Context="menuContext">
                <button type="button"
                        class="top-avatar"
                        title="@(authContext.User.Identity?.Name ?? "Account")"
                        aria-label="Account menu"
                        @onclick="menuContext.ToggleAsync">
                    @GetInitial(authContext.User.Identity?.Name)
                </button>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="NavigateToAccountManage" Icon="@Icons.Material.Filled.Person">
                    @(authContext.User.Identity?.Name ?? "Account")
                </MudMenuItem>
                <MudDivider />
                <div class="account-menu-form">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit">
                            <MudIcon Icon="@Icons.Material.Filled.Logout" />
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </ChildContent>
        </MudMenu>
    </Authorized>
    <NotAuthorized>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="account-menu">
            <ActivatorContent Context="menuContext">
                <button type="button"
                        class="top-avatar"
                        title="Guest account"
                        aria-label="Guest account menu"
                        @onclick="menuContext.ToggleAsync">
                    G
                </button>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="NavigateToLogin" Icon="@Icons.Material.Filled.Login">Login</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </NotAuthorized>
</AuthorizeView>

<style>
    .account-menu-form {
        padding: 4px;
    }

    .account-menu-form form {
        margin: 0;
    }

    .account-menu-form button {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        min-height: 36px;
        padding: 6px 14px;
        border: 0;
        border-radius: 6px;
        color: var(--mud-palette-error);
        background: transparent;
        font: inherit;
        text-align: left;
        cursor: pointer;
    }

    .account-menu-form button:hover {
        background: rgba(255, 156, 156, .12);
    }
</style>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? currentUrl;
    private bool _notificationsOpen;
    private bool _themeMenuOpen;
    private string _currentTheme = "default";

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        var cookie = HttpContext?.Request?.Cookies["luminapath-theme"];
        if (!string.IsNullOrWhiteSpace(cookie))
        {
            _currentTheme = cookie;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("luminaUi.getTheme");
                if (!string.IsNullOrWhiteSpace(theme) && theme != _currentTheme)
                {
                    _currentTheme = theme;
                    StateHasChanged();
                }
            }
            catch
            {
                // Ignore prerender
            }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        _notificationsOpen = false;
        _themeMenuOpen = false;
        StateHasChanged();
    }

    private void ToggleNotifications()
    {
        _notificationsOpen = !_notificationsOpen;
        if (_notificationsOpen) _themeMenuOpen = false;
    }

    private void CloseNotifications() => _notificationsOpen = false;

    private void ToggleThemeMenu()
    {
        _themeMenuOpen = !_themeMenuOpen;
        if (_themeMenuOpen) _notificationsOpen = false;
    }

    private void CloseThemeMenu() => _themeMenuOpen = false;

    private async Task SelectThemeAsync(string themeName)
    {
        _currentTheme = themeName;
        _themeMenuOpen = false;
        try
        {
            await JS.InvokeVoidAsync("luminaUi.applyTheme", themeName);
        }
        catch
        {
            // Ignore JS error
        }
    }

    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "L";
        return char.ToUpperInvariant(name.Trim()[0]).ToString();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void NavigateAccountPage(string uri)
    {
        NavigationManager.NavigateTo(uri, forceLoad: true);
    }

    private void NavigateToAccountManage() => NavigateAccountPage("Account/Manage");
    private void NavigateToLogin() => NavigateAccountPage("Account/Login");
}
