@using LuminaPath.Constants
@inherits LayoutComponentBase

<div class="page">
    <MudThemeProvider Theme="@_theme" IsDarkMode="@true" />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 bg-dark">
            <HeaderMenu />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code{
    private MudTheme _theme = Theme.ApplicationTheme();
    private bool _isDarkMode = true;
}
