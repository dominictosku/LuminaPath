@using LuminaPath.Constants
@using Radzen.Blazor
@inherits LayoutComponentBase
@inject IHostEnvironment HostEnvironment

<div class="page">
    <MudThemeProvider Theme="@_theme" IsDarkMode="@true" />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <MudPopoverProvider />

    <RadzenComponents @rendermode="InteractiveAuto" />

    <ErrorBoundary @ref="errorBoundary">
        <ChildContent>
            <main>
                <MudLayout>
                    <MudAppBar Elevation="1" Class="border-bottom">
                        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
                        <MudSpacer />
                        <HeaderMenu />
                        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
                    </MudAppBar>
                    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
                        <MudDrawerHeader Class="border-bottom top-row navbar navbar-dark">
							<div class="container-fluid">
								<a class="navbar-brand" href="">LuminaPath</a>
							</div>
                        </MudDrawerHeader>
                        <NavMenu />
                    </MudDrawer>
                    <MudMainContent>
                        <article class="content px-4">
                            <div id="components-reconnect-modal">
                                <p class="alert alert-danger">
                                    Connection to the server lost
                                </p>
                            </div>
                            @Body
                        </article>
                    </MudMainContent>
                </MudLayout>
            </main>
        </ChildContent>
        <ErrorContent Context="Exception">
            @if (HostEnvironment.IsProduction())
            {
                <p class="alert alert-danger">
                    An error occured
                </p>
            }
            else
            {
                <div class="alert alert-danger container">
                    @Exception.Message
                    @Exception.StackTrace
                    @Exception.InnerException
                </div>
            }
        </ErrorContent>
    </ErrorBoundary>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override void OnParametersSet()
    {
        errorBoundary?.Recover();
    }
    private MudTheme _theme = Theme.ApplicationTheme();
    private bool _isDarkMode = true;
}
