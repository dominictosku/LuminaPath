@using LuminaPath.Constants
@using Radzen.Blazor
@inherits LayoutComponentBase
@inject IHostEnvironment HostEnvironment

<div class="page">
    <MudThemeProvider Theme="@_theme" IsDarkMode="@true" />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <MudPopoverProvider />

    <RadzenComponents @rendermode="InteractiveServer" />

    <ErrorBoundary @ref="errorBoundary">
        <ChildContent>
            <main>
                <MudLayout>
                    <MudAppBar Elevation="0" Class="app-header">
                        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="header-icon-button" OnClick="@((e) => DrawerToggle())" />
                        <div class="header-title">
                            <span class="header-orb"></span>
                            <div>
                                <span class="header-kicker">LuminaPath</span>
                                <strong>@HeaderTitle</strong>
                            </div>
                        </div>
                        <MudSpacer />
                        <HeaderMenu />
                    </MudAppBar>
                    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Class="app-drawer">
                        <MudDrawerHeader Class="drawer-brand">
                            <a class="brand-lockup" href="">
                                <span class="brand-mark">
                                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" />
                                </span>
                                <span>
                                    <strong>LuminaPath</strong>
                                    <small>Game life tracker</small>
                                </span>
                            </a>
                        </MudDrawerHeader>
                        <NavMenu />
                    </MudDrawer>
                    <MudMainContent>
                        <article class="content px-4">
                            <div id="components-reconnect-modal">
                                <p class="alert alert-danger">
                                    Connection to the server lost
                                </p>
                            </div>
                            @Body
                        </article>
                    </MudMainContent>
                </MudLayout>
            </main>
        </ChildContent>
        <ErrorContent Context="Exception">
            @if (HostEnvironment.IsProduction())
            {
                <p class="alert alert-danger">
                    An error occured
                </p>
            }
            else
            {
                <div class="alert alert-danger container">
                    @Exception.Message
                    @Exception.StackTrace
                    @Exception.InnerException
                </div>
            }
        </ErrorContent>
    </ErrorBoundary>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    bool _drawerOpen = true;
    private string HeaderTitle => "Command Center";

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override void OnParametersSet()
    {
        errorBoundary?.Recover();
    }
    private MudTheme _theme = Theme.ApplicationTheme();
}
