<MudDialog>
    <TitleContent>
        <div class="confirmation-title">
            <MudIcon Icon="@Icon" Color="@ConfirmColor" />
            <div>
                <MudText Typo="Typo.h6">@TitleText</MudText>
                @if (!string.IsNullOrWhiteSpace(SubtitleText))
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@SubtitleText</MudText>
                }
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="confirmation-body">
            <MudAlert Severity="@Severity" Variant="Variant.Outlined" Dense="true" Class="confirmation-alert">
                @ContentText
            </MudAlert>

            @if (!string.IsNullOrWhiteSpace(DetailText))
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary confirmation-detail">@DetailText</MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton StartIcon="@ConfirmIcon" Color="@ConfirmColor" Variant="Variant.Filled" OnClick="Submit">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .confirmation-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .confirmation-body {
        display: grid;
        gap: 14px;
        min-width: min(420px, 82vw);
    }

    .confirmation-alert {
        border-radius: 8px;
    }

    .confirmation-detail {
        line-height: 1.55;
    }
</style>


@code 
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? ContentText { get; set; }

    [Parameter]
    public string TitleText { get; set; } = "Confirm delete";

    [Parameter]
    public string? SubtitleText { get; set; }

    [Parameter]
    public string? DetailText { get; set; }

    [Parameter]
    public string ConfirmText { get; set; } = "Delete";

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.WarningAmber;

    [Parameter]
    public string ConfirmIcon { get; set; } = Icons.Material.Filled.Delete;

    [Parameter]
    public Color ConfirmColor { get; set; } = Color.Error;

    [Parameter]
    public Severity Severity { get; set; } = Severity.Error;

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
