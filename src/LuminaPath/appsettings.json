{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200",
      "http://localhost",
      "https://localhost",
      "capacitor://localhost",
      "ionic://localhost"
    ]
  },
  "Database": {
    "RunMigrationsOnStartup": false
  },
  "Https": {
    "Redirect": false
  },
  "Storage": {
    "Provider": "FileSystem",
    "Path": "App_Data/storage"
  },
  "Azure": {
    "BlobConnectionString": "",
    "BlobContainerName": "media"
  }
}
