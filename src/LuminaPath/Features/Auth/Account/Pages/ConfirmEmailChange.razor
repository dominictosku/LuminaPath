@page "/Account/ConfirmEmailChange"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities


@inject UserManager<LuminaUser> UserManager
@inject SignInManager<LuminaUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject AuditLogService AuditLog

<PageTitle>Confirm email change</PageTitle>

<h1>Confirm email change</h1>

<StatusMessage Message="@message" />

@code {
    private string? message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Email is null || Code is null)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login", "Error: Invalid email change confirmation link.", HttpContext);
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            await AuditLog.RecordAsync(new AuditLogEntry
            {
                Category = AuditCategories.Account,
                Action = AuditActions.EmailChanged,
                Outcome = AuditOutcomes.Failure,
                TargetType = "User",
                TargetId = UserId,
                TargetName = Email,
                Metadata = new { source = "Blazor", reason = "Unknown user" },
                ErrorMessage = "User was not found."
            });
            message = "Unable to find user with Id '{userId}'";
            return;
        }

        var previousEmail = user.Email;
        var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        var result = await UserManager.ChangeEmailAsync(user, Email, code);
        if (!result.Succeeded)
        {
            await AuditLog.RecordAsync(new AuditLogEntry
            {
                Category = AuditCategories.Account,
                Action = AuditActions.EmailChanged,
                Outcome = AuditOutcomes.Failure,
                Actor = new AuditActor(user.Id, user.Email),
                TargetType = "User",
                TargetId = user.Id,
                TargetName = previousEmail,
                Changes = AuditLogService.Changes(("Email", previousEmail, Email)),
                Metadata = new { source = "Blazor" },
                ErrorMessage = "Error changing email."
            });
            message = "Error changing email.";
            return;
        }

        // In our UI email and user name are one and the same, so when we update the email
        // we need to update the user name.
        var setUserNameResult = await UserManager.SetUserNameAsync(user, Email);
        if (!setUserNameResult.Succeeded)
        {
            await AuditLog.RecordAsync(new AuditLogEntry
            {
                Category = AuditCategories.Account,
                Action = AuditActions.EmailChanged,
                Outcome = AuditOutcomes.Failure,
                Actor = new AuditActor(user.Id, user.Email),
                TargetType = "User",
                TargetId = user.Id,
                TargetName = Email,
                Changes = AuditLogService.Changes(("Email", previousEmail, Email)),
                Metadata = new { source = "Blazor", reason = "Username update failed" },
                ErrorMessage = "Error changing user name."
            });
            message = "Error changing user name.";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        await AuditLog.RecordAsync(new AuditLogEntry
        {
            Category = AuditCategories.Account,
            Action = AuditActions.EmailChanged,
            Outcome = AuditOutcomes.Success,
            Actor = new AuditActor(user.Id, Email),
            TargetType = "User",
            TargetId = user.Id,
            TargetName = Email,
            Changes = AuditLogService.Changes(("Email", previousEmail, Email)),
            Metadata = new { source = "Blazor" }
        });
        message = "Thank you for confirming your email change.";
    }
}
