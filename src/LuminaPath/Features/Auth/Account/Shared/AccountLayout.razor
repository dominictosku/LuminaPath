@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<main class="account-page-shell">
    <section class="account-page-panel">
        <a class="account-page-brand" href="/">
            <span class="account-page-brand__mark">
                <img src="/Images/luminapath-logo.png" alt="" />
            </span>
            <span>
                <strong>LuminaPath</strong>
                <small>Account center</small>
            </span>
        </a>

        @if (HttpContext is null)
        {
            <div class="account-page-loading">
                <span class="account-page-spinner"></span>
                <p>Loading account page...</p>
            </div>
        }
        else
        {
            @Body
        }
        <footer class="account-page-footer">
            <a href="/legal/index.html">License &amp; source</a>
        </footer>
    </section>
</main>

<style>
    .account-page-shell {
        min-height: 100vh;
        padding: clamp(24px, 4vw, 56px) clamp(16px, 3vw, 32px);
        color: var(--text, #f0f4f1);
        background: transparent;
    }

    .account-page-panel {
        width: min(1120px, 100%);
        margin: 0 auto;
        padding: 0;
        border: none;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
    }

    .account-page-panel > .row,
    .account-page-panel > form {
        padding: clamp(20px, 3vw, 34px);
        border: 1px solid var(--line, #252c2d);
        border-radius: 18px;
        background: var(--panel, #13191a);
        box-shadow: 0 16px 46px rgba(0, 0, 0, .2);
    }

    .account-page-brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        color: inherit;
        text-decoration: none;
    }

    .account-page-brand__mark {
        display: grid;
        width: 38px;
        height: 38px;
        place-items: center;
        overflow: hidden;
        border-radius: 12px;
    }

    .account-page-brand__mark img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .account-page-brand span:last-child {
        display: grid;
        gap: 2px;
    }

    .account-page-brand strong {
        color: #f8fbff;
        font-size: 15px;
        line-height: 1;
    }

    .account-page-brand small {
        color: var(--mint, #b2f5cf);
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .account-page-footer {
        margin-top: 36px;
        text-align: center;
        font-size: 12px;
    }

    .account-page-footer a {
        color: var(--muted, #858e8e);
        text-decoration: none;
        transition: color .18s ease;
    }

    .account-page-footer a:hover {
        color: var(--mint, #b2f5cf);
    }

    .account-page-panel h1,
    .account-page-panel h2,
    .account-page-panel h3,
    .account-page-panel label {
        color: #f8fbff;
    }

    .account-page-panel hr {
        border-color: var(--line, #252c2d);
        opacity: 1;
    }

    .account-page-panel .btn-primary {
        background: var(--mint, #b2f5cf);
        color: var(--mint-contrast, #082419);
        border-color: var(--mint, #b2f5cf);
        font-weight: 800;
        border-radius: 8px;
    }

    .account-page-panel .btn-primary:hover {
        background: var(--accent, #c0ffd9);
        border-color: var(--accent, #c0ffd9);
        color: var(--mint-contrast, #082419);
    }

    .account-page-panel .form-control {
        color: var(--text, #f0f4f1);
        border-color: var(--line, #252c2d);
        background-color: var(--bg-subtle, #101617);
    }

    .account-page-panel .form-control:disabled {
        color: var(--muted, #858e8e);
        background-color: rgba(255, 255, 255, .03);
    }

    .account-page-panel .form-floating > label {
        color: var(--muted, #858e8e);
    }

    .account-page-panel .nav-pills {
        gap: 6px;
    }

    .account-page-panel .nav-pills .nav-link {
        color: var(--muted-light, #b8c3c0);
        border-radius: 12px;
    }

    .account-page-panel .nav-pills .nav-link.active {
        color: #fff;
        background: var(--accent-gradient, linear-gradient(135deg, #184b39, #2cb57e));
    }

    .account-page-loading {
        display: grid;
        min-height: 220px;
        place-items: center;
        gap: 12px;
        color: var(--mint, #b2f5cf);
    }

    .account-page-spinner {
        width: 38px;
        height: 38px;
        border: 3px solid rgba(178, 245, 207, .2);
        border-top-color: var(--mint, #b2f5cf);
        border-radius: 50%;
        animation: account-spin .9s linear infinite;
    }

    @@keyframes account-spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnParametersSet()
    {
        if (HttpContext is null)
        {
            NavigationManager.Refresh(forceReload: true);
        }
    }
}
