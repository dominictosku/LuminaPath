@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<main class="account-page-shell">
    <section class="account-page-panel">
        <a class="account-page-brand" href="/">
            <span class="account-page-brand__mark">
                <img src="/Images/luminapath-logo.png" alt="" />
            </span>
            <span>
                <strong>LuminaPath</strong>
                <small>Account center</small>
            </span>
        </a>

        @if (HttpContext is null)
        {
            <div class="account-page-loading">
                <span class="account-page-spinner"></span>
                <p>Loading account page...</p>
            </div>
        }
        else
        {
            @Body
        }
        <p><a href="/legal/index.html">License &amp; source</a></p>
    </section>
</main>

<style>
    .account-page-shell {
        min-height: 100vh;
        padding: clamp(24px, 5vw, 64px);
        color: var(--text, #f0f4f1);
        background:
            radial-gradient(circle at 20% 10%, var(--accent-glow, rgba(178, 245, 207, .16)), transparent 38%),
            radial-gradient(circle at 84% 12%, rgba(95, 224, 163, .10), transparent 30%),
            linear-gradient(180deg, #0d1314 0%, #0b0f10 100%);
    }

    .account-page-panel {
        width: min(1120px, 100%);
        margin: 0 auto;
        padding: clamp(20px, 3vw, 34px);
        border: 1px solid var(--line, #252c2d);
        border-radius: 26px;
        background: var(--panel, #13191a);
        box-shadow: 0 24px 80px rgba(0, 0, 0, .45);
    }

    .account-page-brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 26px;
        color: inherit;
        text-decoration: none;
    }

    .account-page-brand__mark {
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        overflow: hidden;
        border-radius: 14px;
    }

    .account-page-brand__mark img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .account-page-brand span:last-child {
        display: grid;
        gap: 2px;
    }

    .account-page-brand strong {
        color: #f8fbff;
        line-height: 1;
    }

    .account-page-brand small {
        color: var(--mint, #b2f5cf);
        font-size: .78rem;
        font-weight: 700;
    }

    .account-page-panel h1,
    .account-page-panel h2,
    .account-page-panel h3,
    .account-page-panel label {
        color: #f8fbff;
    }

    .account-page-panel hr {
        border-color: var(--line, #252c2d);
        opacity: 1;
    }

    .account-page-panel .form-control {
        color: var(--text, #f0f4f1);
        border-color: var(--line, #252c2d);
        background-color: var(--bg-subtle, #101617);
    }

    .account-page-panel .form-control:disabled {
        color: var(--muted, #858e8e);
        background-color: rgba(255, 255, 255, .03);
    }

    .account-page-panel .form-floating > label {
        color: var(--muted, #858e8e);
    }

    .account-page-panel .nav-pills {
        gap: 6px;
    }

    .account-page-panel .nav-pills .nav-link {
        color: var(--muted-light, #b8c3c0);
        border-radius: 12px;
    }

    .account-page-panel .nav-pills .nav-link.active {
        color: #fff;
        background: var(--accent-gradient, linear-gradient(135deg, #184b39, #2cb57e));
    }

    .account-page-loading {
        display: grid;
        min-height: 220px;
        place-items: center;
        gap: 12px;
        color: var(--mint, #b2f5cf);
    }

    .account-page-spinner {
        width: 38px;
        height: 38px;
        border: 3px solid rgba(178, 245, 207, .2);
        border-top-color: var(--mint, #b2f5cf);
        border-radius: 50%;
        animation: account-spin .9s linear infinite;
    }

    @@keyframes account-spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnParametersSet()
    {
        if (HttpContext is null)
        {
            NavigationManager.Refresh(forceReload: true);
        }
    }
}
