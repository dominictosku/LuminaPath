@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<main class="account-page-shell">
    <section class="account-page-panel">
        <a class="account-page-brand" href="/">
            <span class="account-page-brand__mark">
                <img src="/Images/luminapath-logo.png" alt="" />
            </span>
            <span>
                <strong>LuminaPath</strong>
                <small>Account center</small>
            </span>
        </a>

        @if (HttpContext is null)
        {
            <div class="account-page-loading">
                <span class="account-page-spinner"></span>
                <p>Loading account page...</p>
            </div>
        }
        else
        {
            @Body
        }
        <p><a href="/legal/index.html">License &amp; source</a></p>
    </section>
</main>

<style>
    .account-page-shell {
        min-height: 100vh;
        padding: clamp(24px, 5vw, 64px);
        color: #dbeafe;
        background:
            radial-gradient(circle at 20% 10%, rgba(14, 165, 233, .22), transparent 34%),
            radial-gradient(circle at 84% 12%, rgba(34, 197, 94, .14), transparent 28%),
            linear-gradient(135deg, #071426, #0f223d 58%, #102a45);
    }

    .account-page-panel {
        width: min(1120px, 100%);
        margin: 0 auto;
        padding: clamp(20px, 3vw, 34px);
        border: 1px solid rgba(147, 197, 253, .18);
        border-radius: 26px;
        background: rgba(8, 21, 40, .82);
        box-shadow: 0 24px 80px rgba(0, 0, 0, .34);
    }

    .account-page-brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 26px;
        color: inherit;
        text-decoration: none;
    }

    .account-page-brand__mark {
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        overflow: hidden;
        border-radius: 14px;
    }

    .account-page-brand__mark img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .account-page-brand span:last-child {
        display: grid;
        gap: 2px;
    }

    .account-page-brand strong {
        color: #f8fbff;
        line-height: 1;
    }

    .account-page-brand small {
        color: #93c5fd;
        font-size: .78rem;
        font-weight: 700;
    }

    .account-page-panel h1,
    .account-page-panel h2,
    .account-page-panel h3,
    .account-page-panel label {
        color: #f8fbff;
    }

    .account-page-panel hr {
        border-color: rgba(147, 197, 253, .18);
        opacity: 1;
    }

    .account-page-panel .form-control {
        color: #e5f1ff;
        border-color: rgba(147, 197, 253, .24);
        background-color: rgba(15, 35, 62, .82);
    }

    .account-page-panel .form-control:disabled {
        color: #a9bfdc;
        background-color: rgba(15, 35, 62, .48);
    }

    .account-page-panel .form-floating > label {
        color: #a9bfdc;
    }

    .account-page-panel .nav-pills {
        gap: 6px;
    }

    .account-page-panel .nav-pills .nav-link {
        color: #b8d4f5;
        border-radius: 12px;
    }

    .account-page-panel .nav-pills .nav-link.active {
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #0284c7);
    }

    .account-page-loading {
        display: grid;
        min-height: 220px;
        place-items: center;
        gap: 12px;
        color: #93c5fd;
    }

    .account-page-spinner {
        width: 38px;
        height: 38px;
        border: 3px solid rgba(147, 197, 253, .2);
        border-top-color: #38bdf8;
        border-radius: 50%;
        animation: account-spin .9s linear infinite;
    }

    @@keyframes account-spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnParametersSet()
    {
        if (HttpContext is null)
        {
            NavigationManager.Refresh(forceReload: true);
        }
    }
}
