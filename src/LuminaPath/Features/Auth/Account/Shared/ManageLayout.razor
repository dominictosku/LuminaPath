@inherits LayoutComponentBase
@layout AccountLayout

<div class="manage-account">
    <header class="manage-account__header">
        <div>
            <h1>Account</h1>
            <p>Manage your profile, email, password and security settings.</p>
        </div>
        <a class="manage-account__back" href="/">Back to app</a>
    </header>

    <div class="manage-account__content">
        <aside class="manage-account__nav">
            <ManageNavMenu />
        </aside>
        <section class="manage-account__body">
            @Body
        </section>
    </div>
</div>

<style>
    .manage-account {
        display: grid;
        gap: 24px;
    }

    .manage-account__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
    }

    .manage-account__header h1 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 900;
    }

    .manage-account__header p {
        max-width: 620px;
        margin: 8px 0 0;
        color: var(--muted-light, #b8c3c0);
    }

    .manage-account__back {
        flex: 0 0 auto;
        padding: 9px 16px;
        border: 1px solid var(--line, #252c2d);
        border-radius: 999px;
        color: var(--text, #f0f4f1);
        text-decoration: none;
        background: var(--panel, #13191a);
        font-size: 13px;
        font-weight: 700;
        transition: border-color .16s ease, background-color .16s ease, color .16s ease;
    }

    .manage-account__back:hover {
        color: #fff;
        border-color: var(--mint, #b2f5cf);
        background: var(--panel-hover, #182022);
    }

    .manage-account__content {
        display: grid;
        grid-template-columns: minmax(190px, 250px) minmax(0, 1fr);
        gap: 20px;
        align-items: start;
    }

    .manage-account__nav,
    .manage-account__body {
        min-width: 0;
        padding: 24px;
        border: 1px solid var(--line, #252c2d);
        border-radius: 18px;
        background: var(--panel, #13191a);
        box-shadow: 0 16px 46px rgba(0, 0, 0, .2);
    }

    .manage-account__body h3 {
        margin-top: 0;
    }

    @@media (max-width: 820px) {
        .manage-account__header,
        .manage-account__content {
            grid-template-columns: 1fr;
        }

        .manage-account__header {
            display: grid;
        }
    }
</style>
