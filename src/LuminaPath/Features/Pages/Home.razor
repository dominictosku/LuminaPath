@page "/"
@using System.Globalization
@using LuminaPath.Core.Dtos
@using LuminaPath.Core.Entities
@using LuminaPath.Features.Media
@using LuminaPath.Features.Media.Models
@using LuminaPath.Infrastructure.Services.ModelServices
@inherits UnifiedMediaPageBase
@inject QuestService QuestService
@inject FriendsService FriendsService
@attribute [AllowAnonymous]

<PageTitle>LuminaPath — Overview</PageTitle>

<section class="view active">
    <PageIntro Eyebrow="A LITTLE TIME. A WHOLE NEW WORLD."
               Title="@WelcomeHeading"
               Subtitle="Your next great story is waiting. Pick up where you left off.">
        <div class="date-pill">@DateTime.Now.ToString("ddd, dd MMM yyyy", CultureInfo.InvariantCulture)</div>
    </PageIntro>

    <div class="hero-grid">
        <article class="feature-hero tilt-light">
            @if (!string.IsNullOrWhiteSpace(FeaturedItem?.CoverUrl) && FeaturedItem.CoverUrl != "/Images/Placeholder.png")
            {
                <img src="@FeaturedItem.CoverUrl" alt="@(FeaturedItem.Title)" />
            }
            <div class="hero-scrim"></div>
            <div class="hero-content">
                <p class="feature-label"><span class="pulse"></span> YOUR NEXT ADVENTURE</p>
                <h2>Get lost. Find your next world.</h2>
                <p>Every game you play, movie you watch, and story you love — all in one quiet, beautiful place. No rush. Just your universe.</p>
                <div class="hero-actions">
                    @if (FeaturedItem is not null)
                    {
                        <button class="btn btn-primary" type="button" @onclick="@(() => OpenDetail(FeaturedItem))">Jump back in</button>
                    }
                    else
                    {
                        <a class="btn btn-primary" href="library">Jump back in</a>
                    }
                    <a class="btn btn-ghost" href="catalog">Explore catalog ↗</a>
                </div>
            </div>
            <div class="hero-bottom">
                <div class="now-playing">
                    <span class="status-chip">@(FeaturedItem?.StatusDisplayLabel.ToUpperInvariant() ?? "UNIVERSE")</span>
                    <strong>@(FeaturedItem?.Title ?? "Choose your next story")</strong>
                    <em>· @(FeaturedItem is not null ? $"{FeaturedItem.PrimaryGenre} · {FeaturedItem.Platform}" : "Browse games, movies, series, and anime")</em>
                </div>
                @if (FeaturedItem is not null)
                {
                    <button class="link-btn" type="button" @onclick="@(() => OpenDetail(FeaturedItem))">@FeaturedItem.CardFootText →</button>
                }
                else
                {
                    <a class="link-btn" href="catalog">Discover →</a>
                }
            </div>
        </article>

        <aside class="quest-spotlight">
            <div class="quest-copy">
                <p class="eyebrow">✧ THE ADVENTURE IS YOU</p>
                <h2>Level up your everyday.</h2>
                <p>Turn small routines, reading goals, and creative habits into gentle daily quests.</p>
            </div>
            <div class="orbit" aria-hidden="true">
                <div class="ring r1"></div>
                <div class="ring r2"></div>
                <div class="orbit-core">✧</div>
            </div>
            <div class="quest-foot">
                <span>+XP TO DISCOVER</span>
                <a class="btn btn-ghost" href="quests">Quest board ↗</a>
            </div>
        </aside>
    </div>

    <section class="stats" aria-label="Universe summary">
        <div class="stat">
            <span>In your library</span>
            <strong>@_libraryItems.Count</strong>
            <small class="up">@ActiveJourneyCount active right now</small>
        </div>
        <div class="stat">
            <span>Time well spent</span>
            <strong>@($"{Math.Round(TotalHours, 0)}h")</strong>
            <small class="up">@($"{Math.Round(ManualHoursTotal, 0)}h manual · {Math.Round(TrackedHoursTotal, 0)}h tracked")</small>
        </div>
        <div class="stat">
            <span>Stories completed</span>
            <strong>@CompletedCount</strong>
            <small class="up">Across games &amp; media</small>
        </div>
        <div class="stat">
            <span>Active quests</span>
            <strong>@ActiveQuestCount</strong>
            <small>@(_questBoard.CurrentStreakDays > 0 ? $"{_questBoard.CurrentStreakDays}d streak · Level {QuestLevel}" : $"Level {QuestLevel} · +{_questBoard.Xp} XP")</small>
        </div>
    </section>

    <section class="section-block">
        <div class="section-head">
            <div class="title-row">
                <h2>Continue your journey</h2>
                <span class="count-badge">@ContinueItems.Count active</span>
            </div>
            <a class="link-btn" href="library">View library →</a>
        </div>

        <MediaTypeTabs SelectedKind="@_continueKind"
                       SelectedKindChanged="OnContinueKindChanged"
                       AriaLabel="Continue media filter" />

        @if (_loading)
        {
            <div class="empty-state">
                <strong>Loading your universe…</strong>
                <span>Gathering your active games, movies, series, and anime.</span>
            </div>
        }
        else if (ContinueItems.Count == 0)
        {
            <div class="empty-state">
                <strong>No active stories in this tab yet</strong>
                <p style="margin:6px 0 14px">Start a game, movie, series, or anime in your library or explore the catalog.</p>
                <a class="btn btn-primary" href="catalog">Explore the catalog →</a>
            </div>
        }
        else
        {
            <div class="continue-grid">
                @foreach (var item in ContinueItems.Take(5))
                {
                    <MediaCard Item="item" OnSelect="OpenDetail" />
                }
            </div>
        }
    </section>

    <div class="lower-grid">
        <section class="panel friends-panel">
            <p class="eyebrow">✧ SHARED WORLDS</p>
            <h2>Better together</h2>
            <p>Share recommendations, compare libraries, and celebrate milestones with friends.</p>

            @if (_friends.Count == 0)
            {
                <div class="friends-empty">
                    <div class="empty-icon">✦</div>
                    <strong>Your circle starts here</strong>
                    <p>Connect with friends to see what worlds they're exploring right now.</p>
                    @if (!IsAuthenticated)
                    {
                        <a class="btn btn-primary" href="Account/Login">Sign in to connect</a>
                    }
                    else
                    {
                        <a class="btn btn-ghost" href="catalog">Explore community favorites</a>
                    }
                </div>
            }
            else
            {
                <div class="friends-list-compact">
                    @foreach (var friend in _friends.Take(4))
                    {
                        var displayName = !string.IsNullOrWhiteSpace(friend.User.FullName) ? friend.User.FullName : friend.User.UserName;
                        <div class="friend-row">
                            <span class="avatar">@GetInitial(displayName)</span>
                            <span>
                                <strong>@displayName</strong>
                                <small>@(string.Equals(friend.Status, "Accepted", StringComparison.OrdinalIgnoreCase) ? "Connected explorer" : "Pending invite")</small>
                            </span>
                            <span class="status-chip">@friend.Status.ToUpperInvariant()</span>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="panel journey-panel">
            <div class="journey-head">
                <div>
                    <p class="eyebrow">✧ YOUR JOURNEY</p>
                    <h2>A little progress, every day.</h2>
                </div>
                <span class="xp-pill">+@_questBoard.Xp XP</span>
            </div>
            <p>Small steps count. Check off a quest to earn XP right from your overview.</p>

            @if (_questBoard.Quests.Count == 0)
            {
                <div class="friends-empty" style="margin-bottom:12px">
                    <strong>No quests on your board yet</strong>
                    <p>Create daily or main quests to track habits alongside your backlog.</p>
                    <a class="btn btn-ghost" href="quests">Create your first quest →</a>
                </div>
            }
            else
            {
                <ul class="quest-list">
                    @foreach (var quest in OverviewQuests)
                    {
                        <li class="quest-item @(quest.Completed ? "done" : "")"
                            role="checkbox"
                            aria-checked="@(quest.Completed ? "true" : "false")"
                            tabindex="0"
                            @onclick="@(() => ToggleQuestAsync(quest))">
                            <span class="quest-check">@(quest.Completed ? "✓" : "")</span>
                            <span>@quest.Title</span>
                            <b>+@quest.RewardXp XP</b>
                        </li>
                    }
                </ul>
            }

            <a class="link-btn" href="quests">Open full quest board →</a>
        </section>
    </div>

    <section class="discovery-strip">
        <div>
            <p class="eyebrow">✧ LOOKING FOR SOMETHING NEW?</p>
            <h3>Your next favorite is out there.</h3>
        </div>
        <a class="btn btn-primary" href="catalog">Browse the catalog →</a>
    </section>
</section>

<MediaDetailDialog Item="@ActiveDetailItem"
                   IsAuthenticated="@IsAuthenticated"
                   CanUserEdit="@CanUserEdit"
                   Busy="@IsDetailBusy"
                   OnClose="CloseDetail"
                   OnAddToLibrary="HandleAddToLibraryAsync"
                   OnRemoveFromLibrary="HandleRemoveFromLibraryAsync"
                   OnUpdateGameStatus="HandleUpdateGameStatusAsync"
                   OnUpdateMediaStatus="HandleUpdateMediaStatusAsync"
                   OnUpdateRating="HandleUpdateRatingAsync"
                   OnLogSession="HandleLogSessionAsync"
                   OnEditLibraryEntry="OpenEditLibraryEntryDialogAsync"
                   OnEditCatalogEntry="OpenEditCatalogEntryDialogAsync"
                   OnDeleteCatalogEntry="HandleDeleteCatalogEntryAsync"
                   OnRefreshMetadata="HandleRefreshGameMetadataAsync" />

@code {
    private bool _loading = true;
    private string _continueKind = "all";
    private List<UnifiedMediaItem> _libraryItems = [];
    private List<UnifiedMediaItem> _catalogPreviewItems = [];
    private QuestBoardDto _questBoard = new();
    private List<FriendshipDto> _friends = [];

    private bool IsAuthenticated => !string.IsNullOrWhiteSpace(UserId);

    private string WelcomeHeading
    {
        get
        {
            if (string.IsNullOrWhiteSpace(User?.UserName))
            {
                return "Welcome to LuminaPath.";
            }

            var name = User.UserName;
            var at = name.IndexOf('@');
            var shortName = at > 0 ? name[..at] : name;
            return $"Welcome back, {shortName}.";
        }
    }

    private UnifiedMediaItem? FeaturedItem =>
        _libraryItems.FirstOrDefault(i => i.IsActiveJourney)
        ?? _libraryItems.FirstOrDefault()
        ?? _catalogPreviewItems.FirstOrDefault();

    private int ActiveJourneyCount => _libraryItems.Count(i => i.IsActiveJourney);
    private int CompletedCount => _libraryItems.Count(i => i.IsCompleted);
    private double ManualHoursTotal => _libraryItems.Sum(i => i.ManualHours);
    private double TrackedHoursTotal => _libraryItems.Sum(i => i.TrackedHours);
    private double TotalHours => _libraryItems.Sum(i => i.TotalHours);
    private int ActiveQuestCount => _questBoard.Quests.Count(q => !q.Completed);
    private int QuestLevel => Math.Max(1, (_questBoard.Xp / 200) + 1);

    private List<UnifiedMediaItem> ContinueItems
    {
        get
        {
            var activeSource = _libraryItems.Where(i => i.IsActiveJourney).ToList();
            if (activeSource.Count == 0)
            {
                activeSource = _libraryItems.Count > 0 ? _libraryItems : _catalogPreviewItems;
            }

            return _continueKind == "all"
                ? activeSource
                : activeSource.Where(i => string.Equals(i.Kind, _continueKind, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private IEnumerable<QuestDto> OverviewQuests =>
        _questBoard.Quests
            .OrderBy(q => q.Completed)
            .ThenByDescending(q => q.Priority)
            .ThenBy(q => q.SortOrder)
            .Take(4);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadOverviewDataAsync();
    }

    protected override async Task OnMediaDataMutatedAsync()
    {
        await LoadOverviewDataAsync();
        StateHasChanged();
    }

    private async Task LoadOverviewDataAsync()
    {
        _loading = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(UserId))
            {
                var myGames = await MyGameService.GetMyMedia(UserId);
                var myMovies = await MyMovieService.GetMyMedia(UserId);
                var mySeries = await MySeriesService.GetMyMedia(UserId);
                var myAnimes = await MyAnimeService.GetMyMedia(UserId);

                var items = new List<UnifiedMediaItem>(myGames.Count + myMovies.Count + mySeries.Count + myAnimes.Count);
                items.AddRange(myGames.Select(UnifiedMediaItem.FromMyGame));
                items.AddRange(myMovies.Select(UnifiedMediaItem.FromMyMovie));
                items.AddRange(mySeries.Select(UnifiedMediaItem.FromMySeries));
                items.AddRange(myAnimes.Select(UnifiedMediaItem.FromMyAnime));

                _libraryItems = items
                    .OrderByDescending(i => i.IsActiveJourney)
                    .ThenByDescending(i => i.TotalHours)
                    .ThenBy(i => i.Title)
                    .ToList();

                _questBoard = await QuestService.GetBoardAsync(UserId);
                _friends = await FriendsService.GetForUserAsync(UserId);
            }

            if (_libraryItems.Count == 0)
            {
                var filter = new MediaFilter { Paging = new Paging(1, 5) };
                var games = await GameService.GetAllPaginated(filter, GameService.Includes);
                var animes = await AnimeService.GetAllPaginated(filter, AnimeService.Includes);
                _catalogPreviewItems = games.Select(g => UnifiedMediaItem.FromGame(g))
                    .Concat(animes.Select(a => UnifiedMediaItem.FromAnime(a)))
                    .Take(5)
                    .ToList();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnContinueKindChanged(string kind)
    {
        _continueKind = kind;
    }

    private async Task ToggleQuestAsync(QuestDto quest)
    {
        if (string.IsNullOrWhiteSpace(UserId))
        {
            return;
        }

        var nextCompleted = !quest.Completed;
        var res = await QuestService.UpdateAsync(UserId, quest.Id, new QuestUpdateDto
        {
            Completed = nextCompleted
        });

        res.Match(
            mutation =>
            {
                var idx = _questBoard.Quests.FindIndex(q => q.Id == quest.Id);
                if (idx >= 0)
                {
                    _questBoard.Quests[idx] = mutation.Quest;
                }
                _questBoard.Xp = mutation.TotalXp;
                _questBoard.CurrentStreakDays = mutation.CurrentStreakDays;
                Snackbar.Add(nextCompleted ? $"+{mutation.Quest.RewardXp} XP earned" : "Quest reopened", Severity.Success);
                return 0;
            },
            err =>
            {
                Snackbar.Add(string.Join(", ", err.errorMessage), Severity.Error);
                return 0;
            });
    }

    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "E";
        return char.ToUpperInvariant(name.Trim()[0]).ToString();
    }
}
