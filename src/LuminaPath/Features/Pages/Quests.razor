@page "/quests"
@using LuminaPath.Core.Enums
@using LuminaPath.Features.Auth
@using LuminaPath.Infrastructure.Services.ModelServices
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits BaseAuth
@inject QuestService QuestService
@inject MyGameService MyGameService
@inject ISnackbar Snackbar

<PageTitle>Quest Board</PageTitle>

<div class="quest-page">
    @if (_loading)
    {
        <div class="loading-panel">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <p class="loading-text">Summoning your quest board...</p>
        </div>
    }
    else
    {
        <!-- Modern Hero Header -->
        <header class="quest-hero-card">
            <div class="hero-main">
                <div class="hero-badge-wrap">
                    <div class="level-orb">
                        <span class="level-orb-num">@Level</span>
                        <span class="level-orb-label">LVL</span>
                    </div>
                    <div class="hero-titles">
                        <div class="hero-eyebrow">
                            <span class="hero-sparkle">✧</span> LIFE RPG
                            @if (_board.CurrentStreakDays > 0)
                            {
                                <span class="streak-badge">
                                    <span class="streak-flame">🔥</span> @_board.CurrentStreakDays-day streak
                                </span>
                            }
                        </div>
                        <h1 class="hero-rank-title">@Title</h1>
                        <p class="hero-subtitle">Conquer daily objectives, earn XP, and level up your life.</p>
                    </div>
                </div>

                <!-- Mode switcher tabs -->
                <div class="mode-tabs">
                    <button type="button" class="mode-tab @(_mode == PageMode.Quests ? "active" : "")" @onclick="@(() => _mode = PageMode.Quests)">
                        <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Small" />
                        <span>Quests</span>
                    </button>
                    <button type="button" class="mode-tab @(_mode == PageMode.Skills ? "active" : "")" @onclick="@(() => _mode = PageMode.Skills)">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                        <span>Skills</span>
                    </button>
                </div>
            </div>

            <!-- XP Progression Bar -->
            <div class="xp-banner">
                <div class="xp-banner-info">
                    <span class="xp-label">EXPERIENCE PROGRESS</span>
                    <span class="xp-values"><strong>@_board.Xp Total XP</strong> · @XpIntoLevel / 200 XP to Level @(Level + 1)</span>
                </div>
                <div class="xp-track">
                    <div class="xp-fill" style="width: @(XpProgress)%"></div>
                </div>
            </div>

            <!-- Quick Stat Tiles -->
            <div class="stat-tiles">
                <div class="stat-tile @(TodayCount > 0 ? "highlight-amber" : "")">
                    <div class="stat-icon-wrap amber">
                        <MudIcon Icon="@Icons.Material.Filled.Today" />
                    </div>
                    <div class="stat-meta">
                        <span class="stat-num">@TodayCount</span>
                        <span class="stat-label">Focus Today</span>
                    </div>
                </div>

                <div class="stat-tile @(OverdueCount > 0 ? "highlight-red" : "")">
                    <div class="stat-icon-wrap red">
                        <MudIcon Icon="@(OverdueCount > 0 ? Icons.Material.Filled.WarningAmber : Icons.Material.Filled.CheckCircleOutline)" />
                    </div>
                    <div class="stat-meta">
                        <span class="stat-num">@OverdueCount</span>
                        <span class="stat-label">Overdue</span>
                    </div>
                </div>

                <div class="stat-tile">
                    <div class="stat-icon-wrap emerald">
                        <MudIcon Icon="@Icons.Material.Filled.TaskAlt" />
                    </div>
                    <div class="stat-meta">
                        <span class="stat-num">@CompletedQuestCount</span>
                        <span class="stat-label">Completed</span>
                    </div>
                </div>

                <div class="stat-tile">
                    <div class="stat-icon-wrap purple">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" />
                    </div>
                    <div class="stat-meta">
                        <span class="stat-num">@_board.Achievements.Count</span>
                        <span class="stat-label">Achievements</span>
                    </div>
                </div>
            </div>
        </header>

        @if (_mode == PageMode.Quests)
        {
            <!-- Quick Add Quest Card -->
            <section class="capture-card">
                <div class="capture-main-row">
                    <div class="capture-input-box">
                        <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="capture-icon" />
                        <input class="capture-input"
                               placeholder="Capture a new quest (e.g., Beat the Hydra, Study algorithms)..."
                               @bind="_quickAddTitle"
                               @bind:event="oninput"
                               @onkeydown="OnQuickAddKeyDown" />
                    </div>
                    <button type="button" class="capture-submit-btn" @onclick="AddQuest" disabled="@string.IsNullOrWhiteSpace(_quickAddTitle)">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        <span>Add Quest</span>
                    </button>
                </div>

                <div class="capture-footer-row">
                    <div class="preset-chips">
                        <button type="button" class="preset-chip @(IsQuickAddDueToday ? "selected" : "")" @onclick="SetQuickAddToday">
                            <MudIcon Icon="@Icons.Material.Filled.Today" Size="Size.Small" />
                            <span>Today</span>
                        </button>
                        <button type="button" class="preset-chip @(IsQuickAddDueTomorrow ? "selected" : "")" @onclick="SetQuickAddTomorrow">
                            <MudIcon Icon="@Icons.Material.Filled.WbSunny" Size="Size.Small" />
                            <span>Tomorrow</span>
                        </button>
                        <button type="button" class="preset-chip @(_quickAddDue is null ? "selected" : "")" @onclick="ResetQuickAddDue">
                            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Small" />
                            <span>Inbox</span>
                        </button>
                    </div>

                    <button type="button" class="more-options-toggle @(_quickAddAdvancedOpen ? "open" : "")" @onclick="@(() => _quickAddAdvancedOpen = !_quickAddAdvancedOpen)">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
                        <span>@(_quickAddAdvancedOpen ? "Less options" : "More options")</span>
                    </button>
                </div>

                @if (_quickAddAdvancedOpen)
                {
                    <div class="capture-drawer">
                        <div class="drawer-field">
                            <label>QUEST TYPE</label>
                            <select @bind="_quickAddType">
                                @foreach (var type in Enum.GetValues<QuestType>())
                                {
                                    <option value="@type">@TypeLabel(type)</option>
                                }
                            </select>
                        </div>
                        <div class="drawer-field">
                            <label>PRIORITY</label>
                            <select @bind="_quickAddPriority">
                                @foreach (var priority in Enum.GetValues<QuestPriority>())
                                {
                                    <option value="@priority">@PriorityLabel(priority)</option>
                                }
                            </select>
                        </div>
                        <div class="drawer-field">
                            <label>RECURRENCE</label>
                            <select @bind="_quickAddRecurrence">
                                @foreach (var recurrence in Enum.GetValues<QuestRecurrence>())
                                {
                                    <option value="@recurrence">@RecurrenceLabel(recurrence)</option>
                                }
                            </select>
                        </div>
                        <div class="drawer-field">
                            <label>DUE DATE</label>
                            <input type="date" @bind="_quickAddDue" />
                        </div>
                        @if (_library.Count > 0)
                        {
                            <div class="drawer-field">
                                <label>LINK GAME</label>
                                <select @bind="_quickAddGameId">
                                    <option value="">No game linked</option>
                                    @foreach (var game in _library)
                                    {
                                        <option value="@game.Id">@game.Game?.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (_board.Skills.Count > 0)
                        {
                            <div class="drawer-field">
                                <label>LINK SKILL</label>
                                <select @bind="_quickAddSkillId">
                                    <option value="">No skill linked</option>
                                    @foreach (var skill in _board.Skills)
                                    {
                                        <option value="@skill.Id">@skill.Name</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- Board Navigation & Filter Toolbar -->
            <nav class="board-nav-toolbar">
                <div class="filter-lanes">
                    @foreach (var filter in Enum.GetValues<QuestFilter>())
                    {
                        <button type="button" class="lane-tab @(_filter == filter ? "active" : "")" @onclick="@(() => _filter = filter)">
                            <MudIcon Icon="@FilterIcon(filter)" Size="Size.Small" />
                            <span class="lane-name">@FilterLabel(filter)</span>
                            <span class="lane-counter">@FilterCount(filter)</span>
                        </button>
                    }
                </div>

                <div class="search-box">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="search-icon" Size="Size.Small" />
                    <input class="search-input" placeholder="Search quests, notes, tags..." @bind="_searchQuery" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_searchQuery))
                    {
                        <button type="button" class="search-clear-btn" @onclick="@(() => _searchQuery = string.Empty)">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        </button>
                    }
                </div>
            </nav>

            @if (AvailableTags.Count > 0)
            {
                <div class="tag-strip">
                    <span class="tag-strip-label"><MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" /> TAGS:</span>
                    @foreach (var tag in AvailableTags)
                    {
                        <button type="button" class="tag-pill @(_tagFilter == tag ? "active" : "")" @onclick="@(() => ToggleTag(tag))">
                            #@tag
                        </button>
                    }
                    @if (_tagFilter is not null)
                    {
                        <button type="button" class="tag-clear-pill" @onclick="@(() => _tagFilter = null)">
                            Clear filter
                        </button>
                    }
                </div>
            }

            <!-- Quest Board Main -->
            <main class="quest-board-main">
                @if (!VisibleQuests.Any())
                {
                    <div class="board-empty-state">
                        <div class="empty-icon-glow">
                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" />
                        </div>
                        <h3>The realm is calm</h3>
                        <p>No quests match your current view. Capture a new quest above, or pull from your backlog.</p>
                        @if (NextQueuedQuest is not null)
                        {
                            <button type="button" class="empty-pull-btn" @onclick="PullNextQuestToToday">
                                <MudIcon Icon="@Icons.Material.Filled.NorthEast" Size="Size.Small" />
                                <span>Pull "@NextQueuedQuest.Title" into today</span>
                            </button>
                        }
                    </div>
                }

                @foreach (var questSection in QuestSections)
                {
                    <section class="quest-section @questSection.Tone">
                        <header class="section-title-bar">
                            <div class="section-icon-badge">
                                <MudIcon Icon="@questSection.Icon" Size="Size.Small" />
                            </div>
                            <div class="section-titles">
                                <h2>@questSection.Title</h2>
                                <span class="section-subtitle">@questSection.Subtitle</span>
                            </div>
                            <span class="section-badge">@questSection.Quests.Count</span>
                        </header>

                        <div class="quest-cards-stack">
                            @foreach (var quest in questSection.Quests)
                            {
                                <article class="quest-item-card @(quest.Completed ? "is-completed" : "") @(quest.Id == _expandedQuestId ? "is-expanded" : "") @(quest.Id == _celebratingQuestId ? "is-celebrating" : "")"
                                         style="--card-type-color: @TypeColor(quest.Type);">

                                    <!-- Floating XP reward badge -->
                                    <div class="quest-xp-badge" title="Completion Reward">
                                        <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                                        <span>+@(GetDisplayRewardXp(quest)) XP</span>
                                    </div>

                                    <div class="card-inner-grid">
                                        <!-- Checkbox button -->
                                        <button type="button"
                                                class="quest-checkbox-btn @(quest.Completed ? "checked" : "")"
                                                title="@(quest.Completed ? "Reopen quest" : "Complete quest")"
                                                @onclick="@(() => ToggleQuest(quest))">
                                            <MudIcon Icon="@(quest.Completed ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                                                     Class="@(quest.Completed ? "check-icon completed" : "check-icon")" />
                                        </button>

                                        <!-- Quest Clickable Body -->
                                        <div class="quest-content-area" @onclick="@(() => ToggleExpand(quest))">
                                            <div class="quest-kicker-line">
                                                <span class="type-chip" style="color: @TypeColor(quest.Type);">
                                                    <MudIcon Icon="@TypeIcon(quest.Type)" Size="Size.Small" />
                                                    @TypeLabel(quest.Type).ToUpperInvariant()
                                                </span>

                                                <span class="priority-pill @quest.Priority.ToString().ToLowerInvariant()">
                                                    @PriorityLabel(quest.Priority)
                                                </span>
                                            </div>

                                            <h3 class="quest-title-text">@quest.Title</h3>

                                            @if (!string.IsNullOrWhiteSpace(quest.Notes))
                                            {
                                                <p class="quest-notes-text">@quest.Notes</p>
                                            }

                                            <!-- Metadata Pills -->
                                            <div class="quest-badges-row">
                                                <span class="badge-pill due @DueState(quest)">
                                                    <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
                                                    @DueDateLabel(quest)
                                                </span>

                                                @if (quest.Recurrence != QuestRecurrence.None)
                                                {
                                                    <span class="badge-pill recurrence">
                                                        <MudIcon Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" />
                                                        @RecurrenceLabel(quest.Recurrence)
                                                    </span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(quest.GameName))
                                                {
                                                    <span class="badge-pill game">
                                                        <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Small" />
                                                        @quest.GameName
                                                    </span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(quest.SkillName))
                                                {
                                                    <span class="badge-pill skill">
                                                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Small" />
                                                        @quest.SkillName
                                                    </span>
                                                }

                                                @if (quest.Subtasks.Count > 0)
                                                {
                                                    <span class="badge-pill subtasks">
                                                        <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" />
                                                        @SubtaskCompletedCount(quest)/@quest.Subtasks.Count
                                                    </span>
                                                }
                                            </div>

                                            @if (quest.Tags.Count > 0)
                                            {
                                                <div class="quest-tag-chips">
                                                    @foreach (var tag in quest.Tags)
                                                    {
                                                        <span class="card-tag">#@tag</span>
                                                    }
                                                </div>
                                            }

                                            @if (quest.Subtasks.Count > 0)
                                            {
                                                <div class="card-subtask-progress">
                                                    <div class="progress-bar-track">
                                                        <div class="progress-bar-fill" style="width: @(SubtaskProgress(quest))%"></div>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Card Quick Actions -->
                                        <div class="card-action-column">
                                            <button type="button" class="card-action-btn edit" title="Edit quest" @onclick="@(() => ToggleExpand(quest))">
                                                <MudIcon Icon="@(quest.Id == _expandedQuestId ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.Edit)" Size="Size.Small" />
                                            </button>
                                            <button type="button" class="card-action-btn delete" title="Delete quest" @onclick="@(() => DeleteQuest(quest))">
                                                <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Expanded In-Card Editor -->
                                    @if (quest.Id == _expandedQuestId && _editDraft is not null)
                                    {
                                        <div class="expanded-editor-panel">
                                            <div class="editor-header">
                                                <MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" />
                                                <span>EDIT QUEST DETAILS</span>
                                            </div>

                                            <div class="editor-grid">
                                                <div class="editor-field span-full">
                                                    <label>TITLE</label>
                                                    <input @bind="_editDraft.Title" @bind:event="oninput" class="editor-input" />
                                                </div>

                                                <div class="editor-field span-full">
                                                    <label>NOTES</label>
                                                    <textarea @bind="_editDraft.Notes" @bind:event="oninput" class="editor-textarea" rows="2"></textarea>
                                                </div>

                                                <div class="editor-field">
                                                    <label>TYPE</label>
                                                    <select @bind="_editDraft.Type" class="editor-select">
                                                        @foreach (var type in Enum.GetValues<QuestType>())
                                                        {
                                                            <option value="@type">@TypeLabel(type)</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="editor-field">
                                                    <label>PRIORITY</label>
                                                    <select @bind="_editDraft.Priority" class="editor-select">
                                                        @foreach (var priority in Enum.GetValues<QuestPriority>())
                                                        {
                                                            <option value="@priority">@PriorityLabel(priority)</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="editor-field">
                                                    <label>REPEAT</label>
                                                    <select @bind="_editDraft.Recurrence" class="editor-select">
                                                        @foreach (var recurrence in Enum.GetValues<QuestRecurrence>())
                                                        {
                                                            <option value="@recurrence">@RecurrenceLabel(recurrence)</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="editor-field">
                                                    <label>DUE DATE</label>
                                                    <input type="date" @bind="_editDraft.DueDate" class="editor-input" />
                                                </div>

                                                @if (_library.Count > 0)
                                                {
                                                    <div class="editor-field">
                                                        <label>LINK GAME</label>
                                                        <select @bind="_editDraft.MyGameId" class="editor-select">
                                                            <option value="">No game</option>
                                                            @foreach (var game in _library)
                                                            {
                                                                <option value="@game.Id">@game.Game?.Name</option>
                                                            }
                                                        </select>
                                                    </div>
                                                }

                                                @if (_board.Skills.Count > 0)
                                                {
                                                    <div class="editor-field">
                                                        <label>LINK SKILL</label>
                                                        <select @bind="_editDraft.SkillId" class="editor-select">
                                                            <option value="">No skill</option>
                                                            @foreach (var skill in _board.Skills)
                                                            {
                                                                <option value="@skill.Id">@skill.Name</option>
                                                            }
                                                        </select>
                                                    </div>
                                                }

                                                <div class="editor-field span-full">
                                                    <label>TAGS (comma-separated)</label>
                                                    <input placeholder="errand, focus, boss-fight" @bind="_editDraft.Tags" @bind:event="oninput" class="editor-input" />
                                                </div>
                                            </div>

                                            <!-- Subtask Checklist Manager -->
                                            <div class="editor-subtask-section">
                                                <div class="subtask-header-row">
                                                    <span class="subtask-title"><MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" /> SUBTASKS</span>
                                                    <span class="subtask-count">@SubtaskCompletedCount(quest) / @quest.Subtasks.Count completed</span>
                                                </div>

                                                <div class="subtask-items-list">
                                                    @foreach (var subtask in quest.Subtasks.OrderBy(s => s.SortOrder))
                                                    {
                                                        <div class="subtask-row @(subtask.Completed ? "done" : "")">
                                                            <button type="button" class="subtask-check-btn" @onclick="@(() => ToggleSubtask(quest, subtask))">
                                                                <MudIcon Icon="@(subtask.Completed ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" Size="Size.Small" />
                                                            </button>
                                                            <span class="subtask-title-label">@subtask.Title</span>
                                                            <button type="button" class="subtask-del-btn" title="Remove subtask" @onclick="@(() => DeleteSubtask(quest, subtask))">
                                                                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                                                            </button>
                                                        </div>
                                                    }
                                                </div>

                                                <div class="subtask-add-bar">
                                                    <input class="subtask-input"
                                                           placeholder="Add next subtask..."
                                                           value="@SubtaskDraft(quest.Id)"
                                                           @oninput="@(e => SetSubtaskDraft(quest.Id, e.Value?.ToString() ?? string.Empty))"
                                                           @onkeydown="@(e => OnSubtaskKeyDown(e, quest))" />
                                                    <button type="button" class="subtask-add-btn" @onclick="@(() => AddSubtask(quest))">
                                                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Quick Date Scheduling & Action Controls -->
                                            <div class="editor-controls-bar">
                                                <div class="quick-reschedule-group">
                                                    <button type="button" class="reschedule-btn" @onclick="@(() => ScheduleToday(quest))">Today</button>
                                                    <button type="button" class="reschedule-btn" @onclick="@(() => ScheduleTomorrow(quest))">Tomorrow</button>
                                                    <button type="button" class="reschedule-btn" @onclick="@(() => ClearDueDate(quest))">Inbox</button>
                                                </div>

                                                <div class="editor-save-group">
                                                    <button type="button" class="editor-btn cancel" @onclick="CancelEdit">Cancel</button>
                                                    <button type="button" class="editor-btn save" @onclick="@(() => SaveEdit(quest))">
                                                        <MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Small" />
                                                        <span>Save Changes</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    </section>
                }
            </main>
        }
        else
        {
            <!-- Modern Skills View -->
            <section class="skills-layout">
                <div class="skills-heading">
                    <div>
                        <p class="eyebrow">SKILL TREE</p>
                        <h2>Real Life Mastery</h2>
                        <p class="skills-desc">Level up your real-world disciplines by completing tasks and milestones.</p>
                    </div>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="SaveSkill">
                        @(_editingSkillId is null ? "Create Skill" : "Update Skill")
                    </MudButton>
                </div>

                <div class="skill-create-bar">
                    <input class="skill-name-input" placeholder="@(_editingSkillId is null ? "New discipline name (e.g. Piano, Python, Fitness)..." : "Edit skill name")" @bind="_newSkillName" @bind:event="oninput" />
                    <select class="skill-icon-select" @bind="_newSkillIcon">
                        <option value="@Icons.Material.Filled.Code">Code</option>
                        <option value="@Icons.Material.Filled.Brush">Art</option>
                        <option value="@Icons.Material.Filled.Restaurant">Cook</option>
                        <option value="@Icons.Material.Filled.MenuBook">Study</option>
                    </select>
                    <input type="color" class="skill-color-picker" @bind="_newSkillColor" title="Select skill aura color" />
                    @if (_editingSkillId is not null)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="CancelSkillEdit" title="Cancel editing" />
                    }
                </div>

                <div class="skill-grid">
                    @foreach (var skill in _board.Skills)
                    {
                        <article class="skill-card" style="--skill-color: @skill.Color;">
                            <header class="skill-card-header">
                                <div class="skill-icon-shield">
                                    <MudIcon Icon="@ToMudIcon(skill.Icon)" />
                                </div>
                                <div class="skill-card-titles">
                                    <h3>@skill.Name</h3>
                                    <div class="skill-level-row">
                                        <span class="skill-level-badge">LVL @SkillLevel(skill)</span>
                                        <span class="skill-xp-text">@skill.Xp XP</span>
                                    </div>
                                </div>
                                <div class="skill-card-actions">
                                    <button type="button" class="skill-action-btn edit" title="Edit skill" @onclick="@(() => EditSkill(skill))">
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                    </button>
                                    <button type="button" class="skill-action-btn delete" title="Delete skill" @onclick="@(() => DeleteSkill(skill))">
                                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />
                                    </button>
                                </div>
                            </header>

                            <div class="skill-progress-bar-wrap">
                                <div class="skill-progress-track">
                                    <div class="skill-progress-fill" style="width: @(SkillProgress(skill))%;"></div>
                                </div>
                                <span class="skill-progress-percent">@(SkillProgress(skill))% to next rank</span>
                            </div>

                            <div class="skill-quick-actions">
                                <button type="button" class="skill-train-btn" @onclick="@(() => TrainSkill(skill))">
                                    <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                                    <span>Train (+40 XP)</span>
                                </button>
                                <div class="node-add-row">
                                    <input placeholder="Add node..." @bind="_newNodeName" @bind:event="oninput" class="node-input-field" />
                                    <button type="button" class="node-add-btn" @onclick="@(() => AddNode(skill))">
                                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                    </button>
                                </div>
                            </div>

                            <div class="node-constellation">
                                @foreach (var node in skill.Nodes.OrderBy(node => node.SortOrder))
                                {
                                    <button type="button" class="node-chip @(node.Unlocked ? "unlocked" : "locked")" @onclick="@(() => UnlockNode(skill, node))">
                                        <MudIcon Icon="@(node.Unlocked ? Icons.Material.Filled.Star : Icons.Material.Filled.Lock)" Size="Size.Small" />
                                        <span>@node.Name</span>
                                    </button>
                                }
                            </div>

                            <footer class="skill-card-footer">
                                <span>@skill.Nodes.Count(node => node.Unlocked) of @skill.Nodes.Count nodes mastered</span>
                            </footer>
                        </article>
                    }
                </div>
            </section>
        }
    }
</div>
