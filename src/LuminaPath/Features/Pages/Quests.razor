@page "/quests"
@using LuminaPath.Core.Dtos
@using LuminaPath.Core.Enums
@using LuminaPath.Core.Models
@using LuminaPath.Features.Auth
@using LuminaPath.Infrastructure.Services.ModelServices
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits BaseAuth
@inject QuestService QuestService
@inject MyGameService MyGameService
@inject ISnackbar Snackbar

<PageTitle>Quest Board</PageTitle>

<div class="quest-page">
    @if (_loading)
    {
        <div class="loading-panel">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        <section class="quest-hero">
            <div>
                <p class="eyebrow">Life RPG</p>
                <h1>@Title Level @Level</h1>
                <p class="hero-copy">Turn tasks into quests and real-life practice into a skill tree.</p>
            </div>
            <div class="rank-panel">
                <div class="rank-row">
                    <div>
                        <span>Total XP</span>
                        <strong>@_board.Xp</strong>
                    </div>
                    <span class="xp-pill">@XpIntoLevel / 200 XP</span>
                </div>
                <div class="progress-track">
                    <div class="progress-fill" style="width: @(XpProgress)%"></div>
                </div>
                <div class="stat-row">
                    <span>@TodayCount today</span>
                    <span>@OverdueCount overdue</span>
                    <span>@CompletedQuestCount complete</span>
                </div>
                @if (_board.CurrentStreakDays > 0 || _board.LongestStreakDays > 0)
                {
                    <div class="stat-row">
                        <span>@_board.CurrentStreakDays-day streak</span>
                        <span>best @_board.LongestStreakDays</span>
                    </div>
                }
                @if (_board.Achievements.Count > 0)
                {
                    <div class="achievement-pulse">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" />
                        <span>@_board.Achievements.Count achievements unlocked</span>
                    </div>
                }
            </div>
        </section>

        <div class="mode-panel">
            <MudButtonGroup Variant="Variant.Filled" Color="Color.Primary">
                <MudButton OnClick="@(() => _mode = PageMode.Quests)" Variant="@(_mode == PageMode.Quests ? Variant.Filled : Variant.Outlined)">Quests</MudButton>
                <MudButton OnClick="@(() => _mode = PageMode.Skills)" Variant="@(_mode == PageMode.Skills ? Variant.Filled : Variant.Outlined)">Skills</MudButton>
            </MudButtonGroup>
        </div>

        @if (_mode == PageMode.Quests)
        {
            <section class="quick-add-card">
                <div class="quest-input quick-add-row">
                    <input placeholder="Capture a quest" @bind="_quickAddTitle" @bind:event="oninput" @onkeydown="OnQuickAddKeyDown" />
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AddQuest" />
                </div>

                <div class="quick-date-row">
                    <button type="button" class="quick-date @(IsQuickAddDueToday ? "active" : "")" @onclick="SetQuickAddToday">Today</button>
                    <button type="button" class="quick-date @(IsQuickAddDueTomorrow ? "active" : "")" @onclick="SetQuickAddTomorrow">Tomorrow</button>
                    <button type="button" class="quick-date @(_quickAddDue is null ? "active" : "")" @onclick="ResetQuickAddDue">Inbox</button>
                    <button type="button" class="quick-date tools" @onclick="@(() => _quickAddAdvancedOpen = !_quickAddAdvancedOpen)">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" />
                        More
                    </button>
                </div>

                @if (_quickAddAdvancedOpen)
                {
                    <div class="quick-add-meta">
                        <label>
                            <span>Type</span>
                            <select @bind="_quickAddType">
                                @foreach (var type in Enum.GetValues<QuestType>())
                                {
                                    <option value="@type">@TypeLabel(type)</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Priority</span>
                            <select @bind="_quickAddPriority">
                                @foreach (var priority in Enum.GetValues<QuestPriority>())
                                {
                                    <option value="@priority">@PriorityLabel(priority)</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Repeat</span>
                            <select @bind="_quickAddRecurrence">
                                @foreach (var recurrence in Enum.GetValues<QuestRecurrence>())
                                {
                                    <option value="@recurrence">@RecurrenceLabel(recurrence)</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Due</span>
                            <input type="date" @bind="_quickAddDue" />
                        </label>
                        @if (_library.Count > 0)
                        {
                            <label>
                                <span>Game</span>
                                <select @bind="_quickAddGameId">
                                    <option value="">No game</option>
                                    @foreach (var game in _library)
                                    {
                                        <option value="@game.Id">@game.Game?.Name</option>
                                    }
                                </select>
                            </label>
                        }
                        @if (_board.Skills.Count > 0)
                        {
                            <label>
                                <span>Skill</span>
                                <select @bind="_quickAddSkillId">
                                    <option value="">No skill</option>
                                    @foreach (var skill in _board.Skills)
                                    {
                                        <option value="@skill.Id">@skill.Name</option>
                                    }
                                </select>
                            </label>
                        }
                    </div>
                }
            </section>

            <section class="board-toolbar">
                <div class="lane-tabs">
                    @foreach (var filter in Enum.GetValues<QuestFilter>())
                    {
                        <button type="button" class="@(_filter == filter ? "active" : "")" @onclick="@(() => _filter = filter)">
                            <MudIcon Icon="@FilterIcon(filter)" />
                            <span>@FilterLabel(filter)</span>
                            <strong>@FilterCount(filter)</strong>
                        </button>
                    }
                </div>

                <label class="search-field">
                    <MudIcon Icon="@Icons.Material.Filled.Search" />
                    <input placeholder="Search quests, notes, tags" @bind="_searchQuery" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_searchQuery))
                    {
                        <button type="button" @onclick="@(() => _searchQuery = string.Empty)">
                            <MudIcon Icon="@Icons.Material.Filled.Close" />
                        </button>
                    }
                </label>

                @if (AvailableTags.Count > 0)
                {
                    <div class="tag-filter-strip">
                        @foreach (var tag in AvailableTags)
                        {
                            <button type="button" class="@(_tagFilter == tag ? "active" : "")" @onclick="@(() => ToggleTag(tag))">#@tag</button>
                        }
                        @if (_tagFilter is not null)
                        {
                            <button type="button" class="clear" @onclick="@(() => _tagFilter = null)">Clear</button>
                        }
                    </div>
                }
            </section>

            <section class="quest-board">
                @if (!VisibleQuests.Any())
                {
                    <div class="empty-state empty-state-wide">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" />
                        <strong>Nothing needs your attention here</strong>
                        <span>Capture a quest above, or switch lanes to see what is scheduled elsewhere.</span>
                        @if (NextQueuedQuest is not null)
                        {
                            <button type="button" class="inline-action" @onclick="PullNextQuestToToday">Pull "@NextQueuedQuest.Title" into today</button>
                        }
                    </div>
                }

                @foreach (var questSection in QuestSections)
                {
                    <article class="quest-section @questSection.Tone">
                        <header class="section-header">
                            <MudIcon Icon="@questSection.Icon" />
                            <div>
                                <h2>@questSection.Title</h2>
                                <p>@questSection.Subtitle</p>
                            </div>
                            <span>@questSection.Quests.Count</span>
                        </header>

                        <div class="quest-list">
                            @foreach (var quest in questSection.Quests)
                            {
                                <article class="quest-card @(quest.Completed ? "done" : "") @(quest.Id == _expandedQuestId ? "selected" : "")">
                                    <button type="button" class="icon-button" @onclick="@(() => ToggleQuest(quest))">
                                        <MudIcon Icon="@(quest.Completed ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.CheckCircle)" />
                                    </button>
                                    <button type="button" class="quest-body" @onclick="@(() => ToggleExpand(quest))">
                                        <span class="quest-kicker">
                                            <MudIcon Icon="@TypeIcon(quest.Type)" />
                                            @TypeLabel(quest.Type)
                                            <span class="dot"></span>
                                            @PriorityLabel(quest.Priority)
                                        </span>
                                        <h3>@quest.Title</h3>
                                        @if (!string.IsNullOrWhiteSpace(quest.Notes))
                                        {
                                            <p>@quest.Notes</p>
                                        }
                                        <div class="quest-meta">
                                            <span class="@($"meta-pill {DueState(quest)}")"><MudIcon Icon="@Icons.Material.Filled.Event" /> @DueDateLabel(quest)</span>
                                            @if (quest.Recurrence != QuestRecurrence.None)
                                            {
                                                <span class="meta-pill"><MudIcon Icon="@Icons.Material.Filled.Autorenew" /> @RecurrenceLabel(quest.Recurrence)</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(quest.GameName))
                                            {
                                                <span class="meta-pill"><MudIcon Icon="@Icons.Material.Filled.SportsEsports" /> @quest.GameName</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(quest.SkillName))
                                            {
                                                <span class="meta-pill"><MudIcon Icon="@Icons.Material.Filled.EmojiEvents" /> @quest.SkillName</span>
                                            }
                                            @if (quest.Subtasks.Count > 0)
                                            {
                                                <span class="meta-pill"><MudIcon Icon="@Icons.Material.Filled.Checklist" /> @SubtaskCompletedCount(quest)/@quest.Subtasks.Count</span>
                                            }
                                        </div>
                                        @if (quest.Tags.Count > 0)
                                        {
                                            <div class="quest-tags">
                                                @foreach (var tag in quest.Tags)
                                                {
                                                    <span>#@tag</span>
                                                }
                                            </div>
                                        }
                                        @if (quest.Subtasks.Count > 0)
                                        {
                                            <div class="progress-track small">
                                                <div class="progress-fill" style="width: @(SubtaskProgress(quest))%"></div>
                                            </div>
                                        }
                                    </button>
                                    <button type="button" class="delete-button" @onclick="@(() => DeleteQuest(quest))">
                                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" />
                                    </button>

                                    @if (quest.Id == _expandedQuestId && _editDraft is not null)
                                    {
                                        <div class="quest-editor">
                                            <label class="wide">
                                                <span>Title</span>
                                                <input @bind="_editDraft.Title" @bind:event="oninput" />
                                            </label>
                                            <label class="wide">
                                                <span>Notes</span>
                                                <textarea @bind="_editDraft.Notes" @bind:event="oninput"></textarea>
                                            </label>
                                            <label>
                                                <span>Type</span>
                                                <select @bind="_editDraft.Type">
                                                    @foreach (var type in Enum.GetValues<QuestType>())
                                                    {
                                                        <option value="@type">@TypeLabel(type)</option>
                                                    }
                                                </select>
                                            </label>
                                            <label>
                                                <span>Priority</span>
                                                <select @bind="_editDraft.Priority">
                                                    @foreach (var priority in Enum.GetValues<QuestPriority>())
                                                    {
                                                        <option value="@priority">@PriorityLabel(priority)</option>
                                                    }
                                                </select>
                                            </label>
                                            <label>
                                                <span>Repeat</span>
                                                <select @bind="_editDraft.Recurrence">
                                                    @foreach (var recurrence in Enum.GetValues<QuestRecurrence>())
                                                    {
                                                        <option value="@recurrence">@RecurrenceLabel(recurrence)</option>
                                                    }
                                                </select>
                                            </label>
                                            <label>
                                                <span>Due</span>
                                                <input type="date" @bind="_editDraft.DueDate" />
                                            </label>
                                            @if (_library.Count > 0)
                                            {
                                                <label>
                                                    <span>Game</span>
                                                    <select @bind="_editDraft.MyGameId">
                                                        <option value="">No game</option>
                                                        @foreach (var game in _library)
                                                        {
                                                            <option value="@game.Id">@game.Game?.Name</option>
                                                        }
                                                    </select>
                                                </label>
                                            }
                                            @if (_board.Skills.Count > 0)
                                            {
                                                <label>
                                                    <span>Skill</span>
                                                    <select @bind="_editDraft.SkillId">
                                                        <option value="">No skill</option>
                                                        @foreach (var skill in _board.Skills)
                                                        {
                                                            <option value="@skill.Id">@skill.Name</option>
                                                        }
                                                    </select>
                                                </label>
                                            }
                                            <label class="wide">
                                                <span>Tags</span>
                                                <input placeholder="errand, focus, deep-work" @bind="_editDraft.Tags" @bind:event="oninput" />
                                            </label>

                                            <div class="subtask-editor wide">
                                                <span>Subtasks</span>
                                                @foreach (var subtask in quest.Subtasks.OrderBy(s => s.SortOrder))
                                                {
                                                    <div class="subtask @(subtask.Completed ? "done" : "")">
                                                        <button type="button" @onclick="@(() => ToggleSubtask(quest, subtask))">
                                                            <MudIcon Icon="@(subtask.Completed ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.CheckCircle)" />
                                                        </button>
                                                        <span>@subtask.Title</span>
                                                        <button type="button" @onclick="@(() => DeleteSubtask(quest, subtask))">
                                                            <MudIcon Icon="@Icons.Material.Filled.Close" />
                                                        </button>
                                                    </div>
                                                }
                                                <div class="subtask-add">
                                                    <input placeholder="Add a subtask" value="@SubtaskDraft(quest.Id)" @oninput="@(e => SetSubtaskDraft(quest.Id, e.Value?.ToString() ?? string.Empty))" @onkeydown="@(e => OnSubtaskKeyDown(e, quest))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="@(() => AddSubtask(quest))" />
                                                </div>
                                            </div>

                                            <div class="editor-actions wide">
                                                <button type="button" @onclick="@(() => ScheduleToday(quest))">Today</button>
                                                <button type="button" @onclick="@(() => ScheduleTomorrow(quest))">Tomorrow</button>
                                                <button type="button" @onclick="@(() => ClearDueDate(quest))">Inbox</button>
                                                <span></span>
                                                <button type="button" @onclick="CancelEdit">Cancel</button>
                                                <button type="button" class="primary" @onclick="@(() => SaveEdit(quest))">Save</button>
                                            </div>
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    </article>
                }
            </section>
        }
        else
        {
            <section class="skills-layout">
                <div class="skills-heading">
                    <div>
                        <p class="eyebrow">Skill tree</p>
                        <h2>Real Life Mastery</h2>
                    </div>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="SaveSkill">@(_editingSkillId is null ? "Add Skill" : "Save Skill")</MudButton>
                </div>

                <div class="skill-create">
                    <input placeholder="@(_editingSkillId is null ? "New skill name" : "Edit skill name")" @bind="_newSkillName" @bind:event="oninput" />
                    <select @bind="_newSkillIcon">
                        <option value="@Icons.Material.Filled.Code">Code</option>
                        <option value="@Icons.Material.Filled.Brush">Art</option>
                        <option value="@Icons.Material.Filled.Restaurant">Cook</option>
                        <option value="@Icons.Material.Filled.MenuBook">Study</option>
                    </select>
                    <input type="color" @bind="_newSkillColor" />
                    @if (_editingSkillId is not null)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="CancelSkillEdit" />
                    }
                </div>

                <div class="skill-grid">
                    @foreach (var skill in _board.Skills)
                    {
                        <article class="skill-card" style="--skill-color:@skill.Color">
                            <header>
                                <div class="skill-icon">
                                    <MudIcon Icon="@ToMudIcon(skill.Icon)" />
                                </div>
                                <div>
                                    <h3>@skill.Name</h3>
                                    <p>Level @SkillLevel(skill) · @skill.Xp XP</p>
                                </div>
                                <div class="skill-card-actions">
                                    <button type="button" class="skill-action edit" @onclick="@(() => EditSkill(skill))">
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                                    </button>
                                    <button type="button" class="skill-action" @onclick="@(() => DeleteSkill(skill))">
                                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" />
                                    </button>
                                </div>
                            </header>

                            <div class="progress-track small">
                                <div class="progress-fill skill" style="width: @(SkillProgress(skill))%"></div>
                            </div>

                            <div class="skill-actions">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Style="@($"background:{skill.Color}; color:white;")" StartIcon="@Icons.Material.Filled.Bolt" OnClick="@(() => TrainSkill(skill))">Train</MudButton>
                                <div class="node-input">
                                    <input placeholder="New node" @bind="_newNodeName" @bind:event="oninput" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="@(() => AddNode(skill))" />
                                </div>
                            </div>

                            <div class="node-list">
                                @foreach (var node in skill.Nodes.OrderBy(node => node.SortOrder))
                                {
                                    <button type="button" class="node @(node.Unlocked ? "unlocked" : "")" @onclick="@(() => UnlockNode(skill, node))">
                                        <MudIcon Icon="@(node.Unlocked ? Icons.Material.Filled.Star : Icons.Material.Filled.Lock)" />
                                        <span>@node.Name</span>
                                    </button>
                                }
                            </div>

                            <small>@skill.Nodes.Count(node => node.Unlocked) of @skill.Nodes.Count nodes unlocked</small>
                        </article>
                    }
                </div>
            </section>
        }
    }
</div>

<style>
    .quest-page {
        display: grid;
        gap: 18px;
        padding-bottom: 40px;
    }

    .loading-panel {
        min-height: 420px;
        display: grid;
        place-items: center;
    }

    .quest-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(320px, .8fr);
        gap: 22px;
        align-items: end;
        min-height: 300px;
        padding: clamp(24px, 4vw, 42px);
        border-radius: 8px;
        color: #fff;
        background: linear-gradient(135deg, rgba(12, 20, 34, .98), rgba(37, 99, 235, .82), rgba(8, 145, 178, .72));
        box-shadow: 0 18px 54px rgba(0, 0, 0, .2);
    }

    .eyebrow {
        margin: 0 0 6px;
        color: #76e4c4;
        font-size: .76rem;
        font-weight: 800;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .quest-hero h1 {
        margin: 0;
        font-size: clamp(2.5rem, 5vw, 4.8rem);
        line-height: .95;
        letter-spacing: 0;
    }

    .hero-copy {
        max-width: 520px;
        margin: 12px 0 0;
        color: #dbeafe;
    }

    .rank-panel {
        display: grid;
        gap: 13px;
        padding: 18px;
        border: 1px solid rgba(255, 255, 255, .16);
        border-radius: 8px;
        background: rgba(255, 255, 255, .12);
    }

    .rank-row,
    .stat-row,
    .column-progress,
    .skills-heading,
    .skill-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .rank-row span,
    .stat-row {
        color: #dbeafe;
        font-size: .86rem;
    }

    .rank-row strong {
        display: block;
        font-size: 2.4rem;
        line-height: 1;
    }

    .xp-pill {
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .15);
        font-weight: 800;
    }

    .progress-track {
        height: 10px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .18);
        overflow: hidden;
    }

    .progress-track.small {
        height: 8px;
        flex: 1;
        background: rgba(117, 167, 255, .16);
    }

    .progress-fill {
        height: 100%;
        min-width: 4px;
        border-radius: 999px;
        background: linear-gradient(90deg, #fff, #76e4c4);
    }

    .progress-fill.skill,
    .column-progress .progress-fill {
        background: linear-gradient(90deg, #75a7ff, #76e4c4);
    }

    .mode-panel,
    .quest-column,
    .quick-add-card,
    .board-toolbar,
    .quest-section,
    .skill-card {
        padding: 16px;
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: 8px;
        background: var(--mud-palette-surface);
        box-shadow: 0 14px 34px rgba(0, 0, 0, .12);
    }

    .mode-panel {
        display: flex;
        justify-content: center;
    }

    .quest-grid,
    .skill-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        align-items: start;
    }

    .quick-add-card,
    .board-toolbar,
    .quest-board,
    .quest-section {
        display: grid;
        gap: 12px;
    }

    .quick-add-row input {
        height: 54px;
        font-size: 1.03rem;
        font-weight: 700;
    }

    .quick-date-row,
    .tag-filter-strip,
    .quest-meta,
    .quest-tags,
    .editor-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .quick-date,
    .lane-tabs button,
    .tag-filter-strip button,
    .inline-action,
    .editor-actions button {
        min-height: 38px;
        padding: 0 13px;
        border: 1px solid rgba(117, 167, 255, .18);
        border-radius: 8px;
        color: var(--mud-palette-text-primary);
        background: rgba(117, 167, 255, .07);
        cursor: pointer;
        font: inherit;
        font-weight: 800;
    }

    .quick-date.active,
    .lane-tabs button.active,
    .tag-filter-strip button.active,
    .editor-actions button.primary {
        color: #06101f;
        background: #75a7ff;
        border-color: #75a7ff;
    }

    .quick-date.tools,
    .lane-tabs button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

    .quick-add-meta,
    .quest-editor {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
    }

    .quick-add-meta label,
    .quest-editor label,
    .subtask-editor {
        display: grid;
        gap: 6px;
        color: var(--mud-palette-text-secondary);
        font-size: .78rem;
        font-weight: 800;
    }

    .quick-add-meta label span,
    .quest-editor label span,
    .subtask-editor > span {
        text-transform: uppercase;
    }

    .lane-tabs {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
    }

    .lane-tabs button {
        justify-content: center;
        min-height: 58px;
    }

    .lane-tabs strong {
        color: #76e4c4;
    }

    .search-field {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 8px;
        align-items: center;
        padding: 0 12px;
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: 8px;
        background: rgba(255, 255, 255, .04);
    }

    .search-field input {
        border: 0;
        background: transparent;
    }

    .search-field button {
        border: 0;
        color: var(--mud-palette-text-secondary);
        background: transparent;
        cursor: pointer;
    }

    .section-header {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 12px;
        align-items: center;
    }

