@page "/import"
@using LuminaPath.Core.Dtos
@using LuminaPath.Core.Models.ThirdParty
@using LuminaPath.Features.Auth
@using LuminaPath.Infrastructure.Services
@using LuminaPath.Infrastructure.Services.Imports
@using LuminaPath.Infrastructure.Services.ModelServices
@using LuminaPath.Infrastructure.Services.ThirdParty
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@using static LuminaPath.Core.Entities.PSN.PSNTitles
@inherits BaseAuth
@inject PSNService psnService
@inject SteamService steamService
@inject AchievementSyncService achievementSyncService
@inject LuminaUserService userService
@inject ApplicationSettingsService applicationSettingsService
@inject ExcelService excelService
@inject Radzen.DialogService dialogService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize]

@{
	var baseInclude = nameof(MyGameDto.Game) + ".";
	var infoInclude = nameof(MyGameDto.MyGameInfo)  + ".";
	var nameInclude = baseInclude + nameof(Game.Name);
	var psnIdInclude = baseInclude + nameof(GamesNoIncludeDto.PsnId);
	var include1 = infoInclude + nameof(MyGameInfo.FirstPlayed);
	var include2 = infoInclude + nameof(MyGameInfo.LastPlayed);
	var include3 = infoInclude + nameof(MyGameInfo.TrackedHours);

}
<PageTitle>Import</PageTitle>

<section class="import-page">
	<div class="import-hero">
		<div class="import-hero__copy">
			<MudText Typo="Typo.overline" Class="import-eyebrow">Import center</MudText>
			<MudText Typo="Typo.h3" Class="import-title">Bring your play history into LuminaPath</MudText>
			<MudText Typo="Typo.body1" Class="import-subtitle">
				Connect your PlayStation or Steam profile, preview tracked games, and keep Excel backups flowing without leaving your library.
			</MudText>
		</div>
		<div class="import-hero__status">
			<div class="import-status-card">
				<MudIcon Icon="@Icons.Material.Filled.SportsEsports" />
				<span>PSN games ready</span>
				<strong>@ImportedGameCount</strong>
			</div>
			<div class="import-status-card">
				<MudIcon Icon="@Icons.Material.Filled.EmojiEvents" />
				<span>Trophy level</span>
				<strong>@TrophyLevelLabel</strong>
			</div>
		</div>
	</div>

<RadzenTabs Class="import-tabs">
	<Tabs>
		<RadzenTabsItem Text="PSN">
			<div class="psn-workspace">
				<section class="psn-panel psn-profile-panel">
					<div class="psn-panel__header">
						<div>
							<MudText Typo="Typo.overline">Step 1</MudText>
							<MudText Typo="Typo.h5">Find PlayStation profile</MudText>
							<MudText Typo="Typo.body2">Enter your PSN online ID and let LuminaPath resolve your account and trophy summary.</MudText>
						</div>
						<div class="psn-emblem">
							<MudIcon Icon="@Icons.Material.Filled.SportsEsports" />
						</div>
					</div>

					<div class="psn-search">
						<RadzenTextBox @bind-Value="model.PSNOnlineId"
									   Placeholder="PSN online ID"
									   Class="psn-search__input" />
						<MudButton OnClick="ImportProfile"
								   Variant="MudBlazor.Variant.Filled"
								   Color="Color.Primary"
								   StartIcon="@Icons.Material.Filled.ManageSearch">
							Check Profile
						</MudButton>
					</div>

					<div class="psn-profile-grid">
						<div class="psn-profile-stat psn-profile-stat--wide">
							<span>Account ID</span>
							<strong>@ProfileAccountLabel</strong>
						</div>
						<div class="psn-profile-stat">
							<span>Level</span>
							<strong>@TrophyLevelLabel</strong>
						</div>
						<div class="psn-profile-stat trophy-platinum">
							<span>Platinum</span>
							<strong>@model.PSNPlatinum</strong>
						</div>
						<div class="psn-profile-stat trophy-gold">
							<span>Gold</span>
							<strong>@model.PSNGold</strong>
						</div>
						<div class="psn-profile-stat trophy-silver">
							<span>Silver</span>
							<strong>@model.PSNSilver</strong>
						</div>
						<div class="psn-profile-stat trophy-bronze">
							<span>Bronze</span>
							<strong>@model.PSNBronze</strong>
						</div>
					</div>
				</section>

				<section class="psn-panel psn-games-panel">
					<div class="psn-panel__header">
						<div>
							<MudText Typo="Typo.overline">Step 2</MudText>
							<MudText Typo="Typo.h5">Preview tracked games</MudText>
							<MudText Typo="Typo.body2">Check your PSN play history before adding the shown games to your LuminaPath library.</MudText>
						</div>
						<div class="psn-panel__actions">
							<MudButton OnClick="ImportGames"
									   Variant="MudBlazor.Variant.Outlined"
									   Color="Color.Primary"
									   StartIcon="@Icons.Material.Filled.Sync">
								Check Games
							</MudButton>
							<MudButton OnClick="AddGamesToLibrary"
									   Variant="MudBlazor.Variant.Filled"
									   Color="Color.Secondary"
									   StartIcon="@Icons.Material.Filled.LibraryAdd"
									   Disabled="@(!(games?.Any() ?? false))">
								Import Games
							</MudButton>
							<MudButton OnClick="SyncPsnAchievements"
									   Variant="MudBlazor.Variant.Outlined"
									   Color="Color.Secondary"
									   StartIcon="@Icons.Material.Filled.EmojiEvents"
									   Disabled="@psnAchievementSyncing">
								Sync Trophies
							</MudButton>
						</div>
					</div>

					@if (psnAchievementSyncing)
					{
						<MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="steam-progress" />
					}
					@if (psnAchievementSyncResult is not null)
					{
						<MudAlert Severity="Severity.Success" Variant="MudBlazor.Variant.Outlined" Class="steam-alert">
							PSN trophies synced for @psnAchievementSyncResult.GamesScanned games.
							@psnAchievementSyncResult.TotalDefinitionsTouched definitions touched, @psnAchievementSyncResult.UnlocksAdded new unlocks.
						</MudAlert>
					}

					<div class="psn-grid-shell">
						@if (games?.Any() ?? false)
						{
							<RadzenDataGrid AllowFiltering="true"
											AllowColumnResize="true"
											AllowAlternatingRows="false"
											AllowSorting="true"
											PageSize="8"
											AllowPaging="true"
											PagerHorizontalAlign="HorizontalAlign.Left"
											ShowPagingSummary="true"
											Data="@games"
											Class="psn-games-grid">
								<Columns>
									<RadzenDataGridColumn Width="80px" Property="@nameof(MyGameDto.Id)" Title="ID" />
									<RadzenDataGridColumn Width="260px" Property="@nameInclude" Title="Title" />
									<RadzenDataGridColumn Width="130px" Title="Change">
										<Template Context="game">
											@{
												var change = GetPsnChangeType(game);
											}
											<MudChip T="string"
													 Size="Size.Small"
													 Variant="MudBlazor.Variant.Outlined"
													 Color="@GetImportChangeColor(change)">
												@change
											</MudChip>
										</Template>
									</RadzenDataGridColumn>
									<RadzenDataGridColumn Width="160px" Property="@include1" Title="First played" />
									<RadzenDataGridColumn Width="160px" Property="@include2" Title="Last played" />
									<RadzenDataGridColumn Width="150px" Property="@include3" Title="Tracked hours" />
									<RadzenDataGridColumn Width="180px" Property="@psnIdInclude" Title="PSN ID" />
								</Columns>
							</RadzenDataGrid>
						}
						else
						{
							<div class="psn-empty-state">
								<MudIcon Icon="@Icons.Material.Filled.TravelExplore" />
								<MudText Typo="Typo.h6">No PSN games loaded yet</MudText>
								<MudText Typo="Typo.body2">Check your profile first, then load your tracked games for review.</MudText>
							</div>
						}
					</div>
				</section>
			</div>
		</RadzenTabsItem>
		<RadzenTabsItem Text="Steam">
			<div class="steam-workspace">
				<section class="psn-panel steam-profile-panel">
					<div class="psn-panel__header">
						<div>
							<MudText Typo="Typo.overline">Step 1</MudText>
							<MudText Typo="Typo.h5">Find Steam profile</MudText>
							<MudText Typo="Typo.body2">Enter a steamID64, vanity name, or full steamcommunity.com profile URL.</MudText>
						</div>
						<div class="steam-emblem">
							<MudIcon Icon="@Icons.Material.Filled.DesktopWindows" />
						</div>
					</div>

					@if (!steamConfigured)
					{
						<MudAlert Severity="Severity.Warning" Variant="MudBlazor.Variant.Outlined" Class="steam-alert">
							Steam imports need an API key saved by an administrator.
						</MudAlert>
					}

					<div class="psn-search">
						<RadzenTextBox @bind-Value="steamIdentifier"
									   Placeholder="steamID64, vanity name, or profile URL"
									   Class="psn-search__input" />
						<MudButton OnClick="PreviewSteamLibrary"
								   Variant="MudBlazor.Variant.Filled"
								   Color="Color.Primary"
								   StartIcon="@Icons.Material.Filled.ManageSearch"
								   Disabled="@(!steamConfigured || steamPreviewing)">
							Preview Library
						</MudButton>
					</div>

					<div class="steam-profile-card">
						@if (!string.IsNullOrWhiteSpace(SteamAvatarUrl))
						{
							<MudAvatar Size="Size.Large">
								<MudImage Src="@SteamAvatarUrl" />
							</MudAvatar>
						}
						else
						{
							<MudAvatar Size="Size.Large" Color="Color.Primary">
								<MudIcon Icon="@Icons.Material.Filled.Person" />
							</MudAvatar>
						}
						<div>
							<span>@SteamProfileLabel</span>
							<strong>@SteamIdLabel</strong>
						</div>
					</div>

					<div class="psn-profile-grid">
						<div class="psn-profile-stat">
							<span>API</span>
							<strong>@SteamConfiguredLabel</strong>
						</div>
						<div class="psn-profile-stat">
							<span>Games</span>
							<strong>@SteamGameCountLabel</strong>
						</div>
					</div>
				</section>

				<section class="psn-panel steam-games-panel">
					<div class="psn-panel__header">
						<div>
							<MudText Typo="Typo.overline">Step 2</MudText>
							<MudText Typo="Typo.h5">Preview owned games</MudText>
							<MudText Typo="Typo.body2">Steam imports create PC games and add them to your library with tracked Steam playtime.</MudText>
						</div>
						<div class="psn-panel__actions">
							<MudButton OnClick="ImportSteamLibrary"
									   Variant="MudBlazor.Variant.Filled"
									   Color="Color.Secondary"
									   StartIcon="@Icons.Material.Filled.LibraryAdd"
									   Disabled="@(!CanImportSteam)">
								Import Games
							</MudButton>
							<MudButton OnClick="SyncSteamAchievements"
									   Variant="MudBlazor.Variant.Outlined"
									   Color="Color.Secondary"
									   StartIcon="@Icons.Material.Filled.EmojiEvents"
									   Disabled="@(!steamConfigured || steamAchievementSyncing)">
								Sync Achievements
							</MudButton>
						</div>
					</div>

					@if (steamImporting || steamPreviewing || steamAchievementSyncing)
					{
						<MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="steam-progress" />
					}

					@if (steamImportResult is not null)
					{
						<MudAlert Severity="Severity.Success" Variant="MudBlazor.Variant.Filled" Class="steam-alert">
							Imported @steamImportResult.Total Steam games. Added @steamImportResult.Added, updated @steamImportResult.Updated.
						</MudAlert>
					}
					@if (steamAchievementSyncResult is not null)
					{
						<MudAlert Severity="Severity.Success" Variant="MudBlazor.Variant.Outlined" Class="steam-alert">
							Steam achievements synced for @steamAchievementSyncResult.GamesScanned games.
							@steamAchievementSyncResult.TotalDefinitionsTouched definitions touched, @steamAchievementSyncResult.UnlocksAdded new unlocks.
						</MudAlert>
					}

					<div class="psn-grid-shell">
						@if (SteamPreviewGames.Any())
						{
							<RadzenDataGrid AllowFiltering="true"
											AllowColumnResize="true"
											AllowAlternatingRows="false"
											AllowSorting="true"
											PageSize="8"
											AllowPaging="true"
											PagerHorizontalAlign="HorizontalAlign.Left"
											ShowPagingSummary="true"
											Data="@SteamPreviewGames"
											Class="psn-games-grid">
								<Columns>
									<RadzenDataGridColumn Width="100px" Property="@nameof(SteamOwnedGame.AppId)" Title="App ID" />
									<RadzenDataGridColumn Width="300px" Property="@nameof(SteamOwnedGame.Name)" Title="Title" />
									<RadzenDataGridColumn Width="160px" Property="@nameof(SteamOwnedGame.PlaytimeMinutes)" Title="Minutes played" />
									<RadzenDataGridColumn Width="180px" Property="@nameof(SteamOwnedGame.LastPlayed)" Title="Last played" />
								</Columns>
							</RadzenDataGrid>
						}
						else
						{
							<div class="psn-empty-state">
								<MudIcon Icon="@Icons.Material.Filled.TravelExplore" />
								<MudText Typo="Typo.h6">No Steam games loaded yet</MudText>
								<MudText Typo="Typo.body2">Preview a public Steam library before importing it.</MudText>
							</div>
						}
					</div>
				</section>
			</div>
		</RadzenTabsItem>
		<RadzenTabsItem Text="Excel">
			<div class="excel-workspace">
				<section class="psn-panel excel-profile-panel">
					<div class="psn-panel__header">
						<div>
							<MudText Typo="Typo.overline">Step 1</MudText>
							<MudText Typo="Typo.h5">Load workbook</MudText>
							<MudText Typo="Typo.body2">Upload an .xlsx or .ods export to preview which games and library entries will be created, updated, or skipped as duplicates.</MudText>
						</div>
						<div class="excel-emblem">
							<MudIcon Icon="@Icons.Material.Filled.TableView" />
						</div>
					</div>

					<div class="excel-action-stack">
						<MudButton OnClick="DownloadExcel"
								   Variant="MudBlazor.Variant.Filled"
								   Color="Color.Primary"
								   StartIcon="@Icons.Material.Filled.Download">
							Export Library
						</MudButton>

						<MudFileUpload T="IBrowserFile"
									   Accept=".xlsx,.ods"
									   FilesChanged="PreviewExcel">
							<CustomContent Context="fileUpload">
								<MudButton OnClick="@fileUpload.OpenFilePickerAsync"
										   Variant="MudBlazor.Variant.Filled"
										   Color="Color.Secondary"
										   StartIcon="@Icons.Material.Filled.UploadFile"
										   Disabled="@(_excelImporting || _excelSaving)">
									Preview Excel
								</MudButton>
							</CustomContent>
						</MudFileUpload>
					</div>

					@if (_excelImporting || _excelSaving)
					{
						<MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="steam-progress" />
					}

					<div class="psn-profile-grid">
						<div class="psn-profile-stat psn-profile-stat--wide">
							<span>File</span>
							<strong>@ExcelFileLabel</strong>
						</div>
						<div class="psn-profile-stat">
							<span>Rows</span>
							<strong>@ExcelRowsLabel</strong>
						</div>
						<div class="psn-profile-stat">
							<span>Warnings</span>
							<strong>@ExcelWarningsLabel</strong>
						</div>
					</div>
				</section>

				<section class="psn-panel excel-games-panel">
					<div class="psn-panel__header">
						<div>
							<MudText Typo="Typo.overline">Step 2</MudText>
							<MudText Typo="Typo.h5">Preview changes</MudText>
							<MudText Typo="Typo.body2">Review the workbook rows before saving them into LuminaPath.</MudText>
						</div>
						<div class="psn-panel__actions">
							<MudButton OnClick="SaveExcelImport"
									   Variant="MudBlazor.Variant.Filled"
									   Color="Color.Secondary"
									   StartIcon="@Icons.Material.Filled.LibraryAdd"
									   Disabled="@(!CanSaveExcelImport)">
								Import Games
							</MudButton>
						</div>
					</div>

					@if (_excelPreview is not null)
					{
						<MudAlert Severity="@(_excelPreview.Errors.Any() ? Severity.Warning : Severity.Info)" Variant="MudBlazor.Variant.Outlined" Class="steam-alert">
							Detected @_excelPreview.RowsDetected rows. Games: @_excelPreview.CreatedGames created, @_excelPreview.UpdatedGames updated.
							My games: @_excelPreview.CreatedMyGames created, @_excelPreview.UpdatedMyGames updated.
							Duplicates skipped: @_excelPreview.DuplicateRows.
						</MudAlert>
					}

					@if (_excelResult is not null)
					{
						<MudAlert Severity="@(_excelResult.Errors.Any() ? Severity.Warning : Severity.Success)" Variant="MudBlazor.Variant.Filled" Class="steam-alert">
							Imported @_excelResult.RowsImported rows. Games: @_excelResult.CreatedGames created, @_excelResult.UpdatedGames updated.
							My games: @_excelResult.CreatedMyGames created, @_excelResult.UpdatedMyGames updated.
						</MudAlert>
					}

					<div class="psn-grid-shell">
						@if (_excelPreview?.Rows.Any() == true)
						{
							<RadzenDataGrid AllowFiltering="false"
											AllowColumnResize="true"
											AllowAlternatingRows="false"
											AllowSorting="true"
											PageSize="8"
											AllowPaging="true"
											PagerHorizontalAlign="HorizontalAlign.Left"
											ShowPagingSummary="true"
											Data="@_excelPreview.Rows"
											Class="psn-games-grid">
								<Columns>
									<RadzenDataGridColumn Width="90px" Property="@nameof(ExcelService.GameExcelPreviewRow.RowNumber)" Title="Row" />
									<RadzenDataGridColumn Width="260px" Property="@nameof(ExcelService.GameExcelPreviewRow.Name)" Title="Title" />
									<RadzenDataGridColumn Width="130px" Property="@nameof(ExcelService.GameExcelPreviewRow.GameAction)" Title="Game" />
									<RadzenDataGridColumn Width="130px" Property="@nameof(ExcelService.GameExcelPreviewRow.LibraryAction)" Title="Library" />
									<RadzenDataGridColumn Width="130px" Title="Change">
										<Template Context="row">
											<MudChip T="string"
													 Size="Size.Small"
													 Variant="MudBlazor.Variant.Outlined"
													 Color="@GetImportChangeColor(row.ChangeType)">
												@row.ChangeType
											</MudChip>
										</Template>
									</RadzenDataGridColumn>
									<RadzenDataGridColumn Width="140px" Property="@nameof(ExcelService.GameExcelPreviewRow.Status)" Title="Status" />
									<RadzenDataGridColumn Width="140px" Property="@nameof(ExcelService.GameExcelPreviewRow.Platform)" Title="Platform" />
									<RadzenDataGridColumn Width="150px" Property="@nameof(ExcelService.GameExcelPreviewRow.TrackedHours)" Title="Tracked hours" />
									<RadzenDataGridColumn Width="180px" Property="@nameof(ExcelService.GameExcelPreviewRow.PsnId)" Title="PSN ID" />
								</Columns>
							</RadzenDataGrid>
						}
						else
						{
							<div class="psn-empty-state">
								<MudIcon Icon="@Icons.Material.Filled.TableView" />
								<MudText Typo="Typo.h6">No Excel preview loaded yet</MudText>
								<MudText Typo="Typo.body2">Upload a workbook to inspect the rows before importing.</MudText>
							</div>
						}
					</div>

					@if (_excelPreview?.Errors.Any() == true || _excelResult?.Errors.Any() == true)
					{
						<MudList T="string" Dense="true" Class="excel-errors">
							@foreach (var error in ExcelErrors.Take(10))
							{
								<MudListItem>@error</MudListItem>
							}
						</MudList>
					}
				</section>
			</div>
		</RadzenTabsItem>
	</Tabs>
</RadzenTabs>
</section>

<script>
	window.downloadFileFromStream = async (fileName, contentStreamReference) => {
		const arrayBuffer = await contentStreamReference.arrayBuffer();
		const blob = new Blob([arrayBuffer]);
		const url = URL.createObjectURL(blob);
		const anchorElement = document.createElement('a');
		anchorElement.href = url;
		anchorElement.download = fileName ?? '';
		anchorElement.click();
		anchorElement.remove();
		URL.revokeObjectURL(url);
	}
</script>
