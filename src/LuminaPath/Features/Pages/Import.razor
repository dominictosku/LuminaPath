@page "/import"
@using LuminaPath.Core.Dtos
@using LuminaPath.Core.Models.Third_Party
@using LuminaPath.Features.Auth
@using LuminaPath.Infrastructure.Services
@using LuminaPath.Infrastructure.Services.ModelServices
@using LuminaPath.Infrastructure.Services.Third_Party
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@using static LuminaPath.Core.Entities.PSN.PSNTitles
@inherits BaseAuth
@inject PSNService psnService
@inject LuminaUserService userService
@inject FileSystemService fileSystemService
@inject ExcelService excelService
@inject Radzen.DialogService dialogService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize]

@{
	var baseInclude = nameof(MyGameDto.Game) + ".";
	var infoInclude = nameof(MyGameDto.MyGameInfo)  + ".";
	var nameInclude = baseInclude + nameof(Game.Name);
	var psnIdInclude = baseInclude + nameof(GamesNoIncludeDto.GameInfo) + nameof(GameInfo.PsnId);
	var include1 = infoInclude + nameof(MyGameInfo.FirstPlayed);
	var include2 = infoInclude + nameof(MyGameInfo.LastPlayed);
	var include3 = infoInclude + nameof(MyGameInfo.TrackedHours);

}
<PageTitle>Import</PageTitle>

<section class="import-page">
	<div class="import-hero">
		<div class="import-hero__copy">
			<MudText Typo="Typo.overline" Class="import-eyebrow">Import center</MudText>
			<MudText Typo="Typo.h3" Class="import-title">Bring your play history into LuminaPath</MudText>
			<MudText Typo="Typo.body1" Class="import-subtitle">
				Connect your PlayStation profile, preview tracked games, and keep Excel backups flowing without leaving your library.
			</MudText>
		</div>
		<div class="import-hero__status">
			<div class="import-status-card">
				<MudIcon Icon="@Icons.Material.Filled.SportsEsports" />
				<span>PSN games ready</span>
				<strong>@ImportedGameCount</strong>
			</div>
			<div class="import-status-card">
				<MudIcon Icon="@Icons.Material.Filled.EmojiEvents" />
				<span>Trophy level</span>
				<strong>@TrophyLevelLabel</strong>
			</div>
		</div>
	</div>

<RadzenTabs Class="import-tabs">
	<Tabs>
		<RadzenTabsItem Text="PSN">
			<div class="psn-workspace">
				<section class="psn-panel psn-profile-panel">
					<div class="psn-panel__header">
						<div>
							<MudText Typo="Typo.overline">Step 1</MudText>
							<MudText Typo="Typo.h5">Find PlayStation profile</MudText>
							<MudText Typo="Typo.body2">Enter your PSN online ID and let LuminaPath resolve your account and trophy summary.</MudText>
						</div>
						<div class="psn-emblem">
							<MudIcon Icon="@Icons.Material.Filled.SportsEsports" />
						</div>
					</div>

					<div class="psn-search">
						<RadzenTextBox @bind-Value="model.PSNOnlineId"
									   Placeholder="PSN online ID"
									   Class="psn-search__input" />
						<MudButton OnClick="ImportProfile"
								   Variant="MudBlazor.Variant.Filled"
								   Color="Color.Primary"
								   StartIcon="@Icons.Material.Filled.ManageSearch">
							Check Profile
						</MudButton>
					</div>

					<div class="psn-profile-grid">
						<div class="psn-profile-stat psn-profile-stat--wide">
							<span>Account ID</span>
							<strong>@ProfileAccountLabel</strong>
						</div>
						<div class="psn-profile-stat">
							<span>Level</span>
							<strong>@TrophyLevelLabel</strong>
						</div>
						<div class="psn-profile-stat trophy-platinum">
							<span>Platinum</span>
							<strong>@model.PSNPlatinum</strong>
						</div>
						<div class="psn-profile-stat trophy-gold">
							<span>Gold</span>
							<strong>@model.PSNGold</strong>
						</div>
						<div class="psn-profile-stat trophy-silver">
							<span>Silver</span>
							<strong>@model.PSNSilver</strong>
						</div>
						<div class="psn-profile-stat trophy-bronze">
							<span>Bronze</span>
							<strong>@model.PSNBronze</strong>
						</div>
					</div>
				</section>

				<section class="psn-panel psn-games-panel">
					<div class="psn-panel__header">
						<div>
							<MudText Typo="Typo.overline">Step 2</MudText>
							<MudText Typo="Typo.h5">Preview tracked games</MudText>
							<MudText Typo="Typo.body2">Check your PSN play history before adding the shown games to your LuminaPath library.</MudText>
						</div>
						<div class="psn-panel__actions">
							<MudButton OnClick="ImportGames"
									   Variant="MudBlazor.Variant.Outlined"
									   Color="Color.Primary"
									   StartIcon="@Icons.Material.Filled.Sync">
								Check Games
							</MudButton>
							<MudButton OnClick="AddGamesToLibrary"
									   Variant="MudBlazor.Variant.Filled"
									   Color="Color.Secondary"
									   StartIcon="@Icons.Material.Filled.LibraryAdd"
									   Disabled="@(!(games?.Any() ?? false))">
								Import Games
							</MudButton>
						</div>
					</div>

					<div class="psn-grid-shell">
						@if (games?.Any() ?? false)
						{
							<RadzenDataGrid AllowFiltering="true"
											AllowColumnResize="true"
											AllowAlternatingRows="false"
											AllowSorting="true"
											PageSize="8"
											AllowPaging="true"
											PagerHorizontalAlign="HorizontalAlign.Left"
											ShowPagingSummary="true"
											Data="@games"
											Class="psn-games-grid">
								<Columns>
									<RadzenDataGridColumn Width="80px" Property="@nameof(MyGameDto.Id)" Title="ID" />
									<RadzenDataGridColumn Width="260px" Property="@nameInclude" Title="Title" />
									<RadzenDataGridColumn Width="160px" Property="@include1" Title="First played" />
									<RadzenDataGridColumn Width="160px" Property="@include2" Title="Last played" />
									<RadzenDataGridColumn Width="150px" Property="@include3" Title="Tracked hours" />
									<RadzenDataGridColumn Width="180px" Property="@psnIdInclude" Title="PSN ID" />
								</Columns>
							</RadzenDataGrid>
						}
						else
						{
							<div class="psn-empty-state">
								<MudIcon Icon="@Icons.Material.Filled.TravelExplore" />
								<MudText Typo="Typo.h6">No PSN games loaded yet</MudText>
								<MudText Typo="Typo.body2">Check your profile first, then load your tracked games for review.</MudText>
							</div>
						}
					</div>
				</section>
			</div>
		</RadzenTabsItem>
		<RadzenTabsItem Text="Steam">
			<div class="import-coming-soon">
				<MudIcon Icon="@Icons.Material.Filled.Construction" />
				<MudText Typo="Typo.h6">Steam import is coming soon</MudText>
				<MudText Typo="Typo.body2">This importer will live here once the integration is ready.</MudText>
			</div>
		</RadzenTabsItem>
		<RadzenTabsItem Text="Excel">
			<MudStack Spacing="3" Class="excel-panel">
				<MudStack Row="true" Spacing="2">
					<MudButton OnClick="DownloadExcel"
							   Variant="MudBlazor.Variant.Filled"
							   Color="Color.Primary"
							   StartIcon="@Icons.Material.Filled.Download">
						Export Games
					</MudButton>

					<MudFileUpload T="IBrowserFile"
								   Accept=".xlsx"
								   FilesChanged="ImportExcel">
						<CustomContent Context="fileUpload">
							<MudButton OnClick="@fileUpload.OpenFilePickerAsync"
									   Variant="MudBlazor.Variant.Filled"
									   Color="Color.Secondary"
									   StartIcon="@Icons.Material.Filled.Upload"
									   Disabled="_excelImporting">
								Import Excel
							</MudButton>
						</CustomContent>
					</MudFileUpload>
				</MudStack>

				@if (_excelImporting)
				{
					<MudProgressLinear Indeterminate="true" Color="Color.Primary" />
				}

				@if (_excelResult is not null)
				{
					<MudAlert Severity="@(_excelResult.Errors.Any() ? Severity.Warning : Severity.Success)">
						Imported @_excelResult.RowsImported rows.
						Games: @_excelResult.CreatedGames created, @_excelResult.UpdatedGames updated.
						My games: @_excelResult.CreatedMyGames created, @_excelResult.UpdatedMyGames updated.
					</MudAlert>

					@if (_excelResult.Errors.Any())
					{
						<MudList T="string" Dense="true">
							@foreach (var error in _excelResult.Errors.Take(10))
							{
								<MudListItem Text="@error" />
							}
						</MudList>
					}
				}
			</MudStack>
		</RadzenTabsItem>
	</Tabs>
</RadzenTabs>
</section>

<script>
	window.downloadFileFromStream = async (fileName, contentStreamReference) => {
		const arrayBuffer = await contentStreamReference.arrayBuffer();
		const blob = new Blob([arrayBuffer]);
		const url = URL.createObjectURL(blob);
		const anchorElement = document.createElement('a');
		anchorElement.href = url;
		anchorElement.download = fileName ?? '';
		anchorElement.click();
		anchorElement.remove();
		URL.revokeObjectURL(url);
	}
</script>

@code {
	const long MaxExcelFileSize = 10 * 1024 * 1024;
	IQueryable<MyGameDto>? games;
	LuminaUserInfo model = new();
	ExcelService.GameExcelImportResult? _excelResult;
	bool _excelImporting;
	int ImportedGameCount => games?.Count() ?? 0;
	string TrophyLevelLabel => model.PSNTrophyLevel > 0 ? model.PSNTrophyLevel.ToString() : "-";
	string ProfileAccountLabel => string.IsNullOrWhiteSpace(model.PSNAccountId) ? "Not connected" : model.PSNAccountId;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		if (User?.LuminaUserInfo != null)
		{
			model = User.LuminaUserInfo;
		}

		var bearer = fileSystemService.GetBearer();
		psnService.SetBearer(bearer);
	}

	async Task ImportProfile()
	{
		if (string.IsNullOrWhiteSpace(UserId))
		{
			Snackbar.Add("Please sign in before importing a profile", Severity.Info);
			return;
		}

		try
		{
			var profile = await psnService.GetProfile(model.PSNOnlineId);
			model.PSNAccountId = profile.Profile.AccountId;
			var trophies = await psnService.GetUserProfileTrophy(model.PSNAccountId);
			model.PSNTrophyLevel = trophies.TrophyLevel;
			model.PSNPlatinum = trophies.EarnedTrophies.Platinum;
			model.PSNGold = trophies.EarnedTrophies.Gold;
			model.PSNSilver = trophies.EarnedTrophies.Silver;
			model.PSNBronze = trophies.EarnedTrophies.Bronze;
			await userService.UpdateThirdParty(UserId, model);
			Snackbar.Add("Imported Profile", Severity.Success);
		}
		catch
		{
			Snackbar.Add("Profile not found", Severity.Warning);
		}
	}

	async Task AddGamesToLibrary()
	{
		bool? confirm = await dialogService.Confirm("Add shown games to library?", "Add to Library");
		if(confirm is not null && confirm.Value)
		{
			if (User is null || games is null)
			{
				Snackbar.Add("No games available to import", Severity.Info);
				return;
			}

			await psnService.ImportGames(User, games.ToList());
			Snackbar.Add("Added games to library", Severity.Success);
		}
	}

	async Task ImportGames()
	{
		if (model.PSNAccountId == null || model.PSNAccountId == string.Empty)
		{
			Snackbar.Add("Please import your profile first", Severity.Info);
			return;
		}
		try
		{
			var gameData = await GetGameData();
			var result = psnService.ConvertPSNTitles(gameData);
			games = result.AsQueryable();

		}catch
		{
			Snackbar.Add("Admin token expired, please notify the admin", Severity.Warning);
		}
	}

	async Task<GameData> GetGameData()
	{
		GameData gameData = new();
		int currentIteration = 0;

		while (true)
		{
			if (currentIteration >= 5)
				break;
			int offSet = currentIteration * 200;
			var result = await psnService.GetTitles(offSet, model.PSNAccountId!);
			gameData.Titles.AddRange(result.Titles);

			if (result.NextOffset == null || result.NextOffset <= 0)
				break;

			currentIteration++;
		}

		return gameData;
	}

	async Task DownloadExcel()
	{
		if (User is null)
		{
			Snackbar.Add("Please sign in before exporting games", Severity.Info);
			return;
		}

		var fileStream = new MemoryStream(await excelService.ExportGamesAsync(User));
		using var streamRef = new DotNetStreamReference(stream: fileStream);

		await JS.InvokeVoidAsync("downloadFileFromStream", "LuminaDatabase.xlsx", streamRef);
	}

	async Task ImportExcel(IBrowserFile file)
	{
		if (User is null)
		{
			Snackbar.Add("Please sign in before importing games", Severity.Info);
			return;
		}

		_excelImporting = true;
		_excelResult = null;

		try
		{
			using var importStream = await CopyToMemoryStream(file);
			_excelResult = await excelService.ImportGamesAsync(importStream, User);
			ShowExcelImportResult(_excelResult);
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Excel import failed: {ex.Message}", Severity.Error);
		}
		finally
		{
			_excelImporting = false;
		}
	}

	static async Task<MemoryStream> CopyToMemoryStream(IBrowserFile file)
	{
		await using var uploadStream = file.OpenReadStream(MaxExcelFileSize);
		var importStream = new MemoryStream();
		await uploadStream.CopyToAsync(importStream);
		importStream.Position = 0;
		return importStream;
	}

	void ShowExcelImportResult(ExcelService.GameExcelImportResult result)
	{
		if (result.Errors.Any())
		{
			Snackbar.Add($"Imported {result.RowsImported} rows with {result.Errors.Count} warnings", Severity.Warning);
			return;
		}

		Snackbar.Add($"Imported {result.RowsImported} rows", Severity.Success);
	}
}
