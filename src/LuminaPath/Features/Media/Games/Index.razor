@page "/Media/Games"
@using LuminaPath.Core.Entities
@using LuminaPath.Features.Media.Components
@using LuminaPath.Features.Media.Games.Components
@using LuminaPath.Features.Media.Games.ViewModel
@using LuminaPath.Infrastructure.Services.Application
@using LuminaPath.Infrastructure.Services.ModelServices
@using LuminaPath.Pages.Media
@using LuminaPath.Pages.Media.Components
@inject GameService GameService
@inject GameMetadataRefreshService MetadataRefreshService
@inherits MediaGridActions<Game, GameViewModel, GameFormDialog>

<PageTitle>Games</PageTitle>

<div class="media-page-header">
	<div>
		<p class="eyebrow">Library</p>
		<h1>Games</h1>
		<MudText Typo="Typo.body2" Class="mud-text-secondary">Browse, compare, and maintain the game catalog.</MudText>
	</div>
	<MudButton OnClick="SwitchView" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@ViewIcon">@ToggleText</MudButton>
</div>

<AdvancedSearch Model="_filter" OnConditionChanged="ReloadData" />

@if (IsGrid)
{
	<section class="games-table-frame">
		<LuminaGrid GetData="@(GetData)"
			T="GameViewModel"
			Loading="@loading"
			@bind-SelectedItems="selectedItems"
			@ref="_table"
			SortMode="SortMode.Single"
			Class="games-data-grid">
			<ToolBarContent>
				<TableActions TItem="GameViewModel" Page="this" loading="loading" selectedItems="selectedItems" />
			</ToolBarContent>
			<Columns>
				<SelectColumn ShowInFooter="false"></SelectColumn>
				<TemplateColumn CellStyle="width:84px" Title="" Sortable="false">
					<CellTemplate>
						<div class="table-cover-frame">
							<div class="table-cover" style="background-image: url('@Cover(context.Item)');"></div>
						</div>
					</CellTemplate>
				</TemplateColumn>
				<TemplateColumn Title="Game" SortBy="@((GameViewModel x) => x == null ? "" : x.Name)" Sortable="true">
					<CellTemplate>
						<div class="title-cell">
							<div class="title-row">
								<MudText Typo="Typo.body1">@context.Item.Name</MudText>
								@if (LibraryEntryCount(context.Item) > 0)
								{
									<span class="library-chip">@LibraryEntryCount(context.Item) in library</span>
								}
							</div>
							<MudText Typo="Typo.body2" Class="game-summary">@Summary(context.Item)</MudText>
							<div class="chip-row">
								@foreach (var genre in context.Item.Genres.Take(3))
								{
									<span class="soft-chip">@genre</span>
								}
							</div>
						</div>
					</CellTemplate>
				</TemplateColumn>
				<TemplateColumn Title="Release" SortBy="@((GameViewModel x) => x.ReleaseDate)" Sortable="true">
					<CellTemplate>
						<div class="release-cell">
							<span class="release-year">@ReleaseYear(context.Item)</span>
							<span class="release-date">@ReleaseDate(context.Item)</span>
						</div>
					</CellTemplate>
				</TemplateColumn>
				<TemplateColumn Title="Details">
					<CellTemplate>
						<div class="detail-pill-grid">
							<span><MudIcon Icon="@Icons.Material.Filled.VideogameAsset" Size="Size.Small" /> @PlatformLabel(context.Item)</span>
							<span><MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" /> @Playtime(context.Item)</span>
						</div>
					</CellTemplate>
				</TemplateColumn>
				<TemplateColumn Title="Source">
					<CellTemplate>
						<div class="source-cell">
							<span class="source-pill @SourceClass(context.Item.Source)">@context.Item.Source</span>
						</div>
					</CellTemplate>
				</TemplateColumn>
				<TemplateColumn CellStyle="width:132px" Title="Actions" Sortable="false">
					<CellTemplate>
						<div class="table-action-icons">
							<MudTooltip Text="Refresh metadata">
								<MudIconButton Icon="@Icons.Material.Filled.Sync"
											   Variant="Variant.Text"
											   Color="Color.Secondary"
											   Size="Size.Small"
											   DropShadow="false"
											   OnClick="@(async () => await RefreshMetadata(context.Item))" />
							</MudTooltip>
							<MudTooltip Text="Edit game">
								<MudIconButton Icon="@Icons.Material.Filled.Edit"
											   Variant="Variant.Text"
											   Color="Color.Primary"
											   Size="Size.Small"
											   DropShadow="false"
											   OnClick="@(async () => await OnUpdate(context.Item))" />
							</MudTooltip>
							<MudTooltip Text="Delete game">
								<MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
											   Variant="Variant.Text"
											   Color="Color.Error"
											   Size="Size.Small"
											   DropShadow="false"
											   OnClick="@(async () => await Delete(context.Item))" />
							</MudTooltip>
						</div>
					</CellTemplate>
				</TemplateColumn>
			</Columns>
			<NoRecordsContent>
				<div class="grid-state">
					<MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
					<MudText Typo="Typo.subtitle1">No games found</MudText>
					<MudText Typo="Typo.body2" Class="mud-text-secondary">Try a different search or filter.</MudText>
				</div>
			</NoRecordsContent>
			<LoadingContent>
				<div class="grid-state">
					<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" />
					<MudText Typo="Typo.body2">Loading games</MudText>
				</div>
			</LoadingContent>
			<PagerContent>
				<MudDataGridPager />
			</PagerContent>
		</LuminaGrid>
	</section>
}
else
{
	<div class="card-toolbar">
		<TableActions Page="this" loading="loading" selectedItems="selectedItems" />
	</div>
	<div class="game-card-grid">
		@foreach (var game in Games)
		{
			<article class="game-card">
				<div class="card-cover" style="background-image: url('@Cover(game)');">
					<span class="source-pill overlay">@game.Source</span>
				</div>
				<div class="game-card-body">
					<div>
						<h2>@game.Name</h2>
						<p>@Summary(game)</p>
					</div>
					<div class="chip-row">
						@foreach (var genre in game.Genres.Take(3))
						{
							<span class="soft-chip">@genre</span>
						}
					</div>
					<div class="card-metrics">
						<span><MudIcon Icon="@Icons.Material.Filled.VideogameAsset" Size="Size.Small" /> @game.Platforms</span>
						<span><MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" /> @Playtime(game)</span>
						<span><MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" /> @ReleaseDate(game)</span>
					</div>
				</div>
				<div class="game-card-actions">
					<MudButton OnClick="@(async () => await RefreshMetadata(game))" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Sync">Metadata</MudButton>
					<MudButton OnClick="@(() => OnUpdate(game))" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
					<MudButton OnClick="@(async () => await Delete(game))" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
				</div>
			</article>
		}
	</div>
}

<style>
	.media-page-header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 18px;
	}

	.media-page-header h1 {
		margin: 0;
		letter-spacing: 0;
	}

	.eyebrow {
		margin: 0 0 4px;
		color: var(--mud-palette-primary);
		font-size: .76rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.table-cover {
		width: 54px;
		height: 72px;
		border-radius: 7px;
		background-color: #263346;
		background-position: center;
		background-size: cover;
		box-shadow: 0 8px 22px rgba(0, 0, 0, .18);
	}

	.table-cover-frame {
		display: inline-grid;
		place-items: center;
		padding: 4px;
		border: 1px solid rgba(117, 167, 255, .18);
		border-radius: 10px;
		background: linear-gradient(180deg, rgba(117, 167, 255, .12), rgba(118, 228, 196, .05));
	}

	.games-table-frame {
		border: 1px solid rgba(117, 167, 255, .16);
		border-radius: 12px;
		background:
			linear-gradient(180deg, rgba(117, 167, 255, .08), rgba(9, 15, 26, .02)),
			var(--mud-palette-surface);
		box-shadow: 0 18px 48px rgba(0, 0, 0, .2);
		overflow: hidden;
	}

	.games-data-grid {
		border: 0;
		background: transparent;
	}

	.games-data-grid .mud-table-toolbar {
		min-height: 72px;
		padding: 12px 16px;
		border-bottom: 1px solid rgba(255, 255, 255, .08);
		background: rgba(12, 20, 35, .72);
	}

	.games-data-grid .mud-table-head .mud-table-cell {
		border-bottom: 1px solid rgba(117, 167, 255, .16);
		color: var(--mud-palette-text-secondary);
		font-size: .76rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.games-data-grid .mud-table-row {
		background: rgba(15, 24, 40, .62);
		transition: background .16s ease, transform .16s ease;
	}

	.games-data-grid .mud-table-row:hover {
		background: rgba(30, 48, 78, .72);
	}

	.games-data-grid .mud-table-cell {
		border-bottom: 1px solid rgba(255, 255, 255, .07);
		padding-top: 12px;
		padding-bottom: 12px;
	}

	.title-cell {
		display: grid;
		gap: 7px;
		min-width: min(420px, 42vw);
	}

	.title-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
	}

	.title-row .mud-typography {
		font-weight: 800;
		line-height: 1.2;
	}

	.game-summary {
		display: -webkit-box;
		max-width: 620px;
		overflow: hidden;
		color: var(--mud-palette-text-secondary);
		line-height: 1.35;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.chip-row {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.soft-chip,
	.source-pill,
	.library-chip {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		padding: 3px 9px;
		border: 1px solid rgba(255, 255, 255, .08);
		border-radius: 6px;
		background: rgba(118, 228, 196, .12);
		color: var(--mud-palette-text-primary);
		font-size: .78rem;
		font-weight: 700;
	}

	.library-chip {
		background: rgba(94, 220, 143, .12);
		color: #8df3b1;
	}

	.source-pill {
		background: rgba(117, 167, 255, .14);
	}

	.source-steam { background: rgba(91, 151, 255, .16); color: #9ec4ff; }
	.source-psn,
	.source-playstation { background: rgba(83, 115, 255, .18); color: #9fb0ff; }
	.source-lumina { background: rgba(118, 228, 196, .12); color: #8deacb; }

	.source-pill.overlay {
		position: absolute;
		top: 10px;
		right: 10px;
		background: rgba(9, 15, 26, .82);
		color: #fff;
	}

	.detail-stack,
	.card-metrics {
		display: grid;
		gap: 6px;
		color: var(--mud-palette-text-secondary);
		font-size: .88rem;
	}

	.detail-stack span,
	.card-metrics span {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.release-cell {
		display: grid;
		gap: 2px;
		width: 112px;
	}

	.release-year {
		color: var(--mud-palette-text-primary);
		font-size: 1.18rem;
		font-weight: 900;
		line-height: 1;
	}

	.release-date {
		color: var(--mud-palette-text-secondary);
		font-size: .82rem;
	}

	.detail-pill-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		min-width: 210px;
		max-width: 360px;
	}

	.detail-pill-grid span {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 30px;
		padding: 5px 9px;
		border: 1px solid rgba(117, 167, 255, .13);
		border-radius: 7px;
		background: rgba(255, 255, 255, .04);
		color: var(--mud-palette-text-secondary);
		font-size: .82rem;
		font-weight: 700;
	}

	.source-cell {
		min-width: 96px;
	}

	.table-action-icons {
		display: flex;
		align-items: center;
		gap: 2px;
		justify-content: flex-end;
	}

	.table-action-icons .mud-icon-button {
		border-radius: 7px;
		background: rgba(255, 255, 255, .035);
	}

	.grid-state {
		display: grid;
		place-items: center;
		gap: 8px;
		min-height: 220px;
		color: var(--mud-palette-text-secondary);
		text-align: center;
	}

	.card-toolbar {
		margin: 8px 0 14px;
		padding: 10px 0;
	}

	.game-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 16px;
	}

	.game-card {
		display: grid;
		grid-template-rows: 190px 1fr auto;
		min-height: 420px;
		border: 1px solid rgba(255, 255, 255, .08);
		border-radius: 8px;
		background: var(--mud-palette-surface);
		overflow: hidden;
		box-shadow: 0 14px 34px rgba(0, 0, 0, .14);
	}

	.card-cover {
		position: relative;
		background-color: #263346;
		background-position: center;
		background-size: cover;
	}

	.game-card-body {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px;
	}

	.game-card h2 {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.2;
		letter-spacing: 0;
	}

	.game-card p {
		margin: 6px 0 0;
		color: var(--mud-palette-text-secondary);
		line-height: 1.45;
	}

	.card-metrics {
		margin-top: auto;
		grid-template-columns: 1fr;
	}

	.game-card-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		justify-content: space-between;
		padding: 8px 10px 10px;
		border-top: 1px solid rgba(255, 255, 255, .08);
	}

	@@media (max-width: 720px) {
		.media-page-header {
			align-items: stretch;
			flex-direction: column;
		}

		.title-cell {
			min-width: 260px;
		}

		.games-data-grid .mud-table-toolbar {
			padding: 10px;
		}
	}
</style>

@code {
	private readonly string _placeholderCover = "/Images/Placeholder.png";
	private List<GameViewModel> Games = new();
	private MudDataGrid<GameViewModel> _table = default!;
	protected override string EntityLabel => "Game";
	private string ViewIcon => IsGrid ? Icons.Material.Filled.ViewModule : Icons.Material.Filled.TableRows;

	protected override void OnInitialized()
	{
		ModelService = GameService;
		base.OnInitialized();
	}

	public override async Task ReloadData()
	{
		if (IsGrid)
		{
			await _table.ReloadServerData();
		}
		else
		{
			Games = await GetData();
			StateHasChanged();
		}
	}

	private async Task SwitchView()
	{
		IsGrid = !IsGrid;
		await ReloadData();
	}

	private async Task RefreshMetadata(GameViewModel game)
	{
		if (!CanUserEdit)
		{
			Snackbar.Add("No permission to edit", Severity.Info);
			return;
		}

		loading = true;
		await InvokeAsync(StateHasChanged);
		try
		{
			var result = await MetadataRefreshService.RefreshGameAsync(game.Id);
			result.Match(
				success =>
				{
					var parts = new List<string>();
					if (success.UpdatedReleaseDate)
					{
						parts.Add("release date");
					}

					if (success.UpdatedCover)
					{
						parts.Add("cover");
					}

					var applied = parts.Count == 0 ? success.Message : $"Updated {string.Join(" and ", parts)} from {success.Provider}.";
					Snackbar.Add(applied, parts.Count == 0 ? Severity.Info : Severity.Success);
					return true;
				},
				failure =>
				{
					Snackbar.Add(string.Join("; ", failure.errorMessage), Severity.Error);
					return false;
				});

			await ReloadData();
		}
		catch (Exception)
		{
			Snackbar.Add("Failed to refresh metadata", Severity.Error);
		}
		finally
		{
			loading = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	protected override string GetDeleteTitle(GameViewModel game) => $"Delete \"{game.Name}\"?";

	protected override string GetDeleteMessage(GameViewModel game)
	{
		var libraryCount = game.MyGames?.Count ?? 0;
		var libraryWarning = libraryCount > 0
			? $" It is currently referenced by {libraryCount} personal librar{(libraryCount == 1 ? "y entry" : "y entries")}."
			: string.Empty;

		return $"Are you sure you want to delete this catalog game?{libraryWarning}";
	}

	protected override string? GetDeleteDetail(GameViewModel game)
	{
		return "This removes the shared game record, including its metadata, cover link, achievements, and any dependent records configured to cascade. This action cannot be undone.";
	}

	protected override string GetBulkDeleteTitle(int count) => $"Delete {count} selected catalog game{(count == 1 ? string.Empty : "s")}?";

	protected override string GetBulkDeleteMessage(int count) => $"Are you sure you want to delete {count} selected catalog game{(count == 1 ? string.Empty : "s")}?";

	protected override string? GetBulkDeleteDetail(int count)
	{
		return "Catalog deletion can affect personal library entries and related game data. Review the selection carefully before continuing.";
	}

	private async Task<List<GameViewModel>> GetData()
	{
		var result = await GameService.GetAll();
		var games = mapper.Map<List<GameViewModel>>(result);
		games = ApplyFilters(games).ToList();
		Games = games;
		return games;
	}

	private IEnumerable<GameViewModel> ApplyFilters(IEnumerable<GameViewModel> games)
	{
		if (!string.IsNullOrWhiteSpace(_filter.SearchString))
		{
			var search = _filter.SearchString.Trim();
			games = games.Where(game =>
				Contains(game.Name, search) ||
				Contains(game.Description, search) ||
				Contains(game.Source, search) ||
				game.Genres.Any(genre => Contains(genre, search)));
		}

		if (_filter.From is not null)
		{
			games = games.Where(game => game.ReleaseDate >= _filter.From);
		}

		if (_filter.To is not null)
		{
			games = games.Where(game => game.ReleaseDate <= _filter.To);
		}

		if (_filter.Platform is not null)
		{
			games = games.Where(game => game.Platforms.HasFlag(_filter.Platform.Value));
		}

		if (!string.IsNullOrWhiteSpace(_filter.Genre))
		{
			var genreFilter = _filter.Genre.Trim();
			games = games.Where(game => game.Genres.Any(genre => Contains(genre, genreFilter)));
		}

		if (!string.IsNullOrWhiteSpace(_filter.Source))
		{
			var sourceFilter = _filter.Source.Trim();
			games = games.Where(game => Contains(game.Source, sourceFilter));
		}

		if (_filter.MinPlaytime is not null)
		{
			games = games.Where(game => game.Playtime >= _filter.MinPlaytime);
		}

		if (_filter.MaxPlaytime is not null)
		{
			games = games.Where(game => game.Playtime <= _filter.MaxPlaytime);
		}

		return games;
	}

	private string Cover(Game? game)
	{
		return string.IsNullOrWhiteSpace(game?.Image?.Url)
			? _placeholderCover
			: NormalizeUrl(game.Image.Url);
	}

	private static string NormalizeUrl(string url)
	{
		return url.StartsWith("http", StringComparison.OrdinalIgnoreCase) || url.StartsWith("/")
			? url
			: $"/{url}";
	}

	private static string Summary(Game game)
	{
		if (string.IsNullOrWhiteSpace(game.Description))
		{
			return game.Genres.Count > 0 ? string.Join(" / ", game.Genres.Take(3)) : "No description yet";
		}

		return game.Description.Length > 120 ? $"{game.Description[..120]}..." : game.Description;
	}

	private static string Playtime(Game game)
	{
		return game.Playtime is null ? "No estimate" : $"{game.Playtime}h";
	}

	private static string ReleaseDate(Game game)
	{
		return game.ReleaseDate?.ToString("dd.MM.yyyy") ?? "No date";
	}

	private static string ReleaseYear(Game game)
	{
		return game.ReleaseDate?.ToString("yyyy") ?? "TBA";
	}

	private static string PlatformLabel(Game game)
	{
		return game.Platforms == 0 ? "No platform" : game.Platforms.ToString();
	}

	private static int LibraryEntryCount(GameViewModel game)
	{
		return game.MyGames?.Count ?? 0;
	}

	private static string SourceClass(string? source)
	{
		return source?.Trim().ToLowerInvariant() switch
		{
			"steam" => "source-steam",
			"psn" => "source-psn",
			"playstation" => "source-playstation",
			"lumina" => "source-lumina",
			_ => string.Empty
		};
	}

	private static bool Contains(string? value, string search)
	{
		return value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
	}

	protected override DialogParameters<GameFormDialog> CreateDialogParameters(GameViewModel command, Func<GameViewModel, Task> OnSubmit)
	{
		return new DialogParameters<GameFormDialog>
			{
				{ x=>x.Refresh , new Action(async () => await ReloadData()) },
				{ x=>x.Model, command },
				{ x=>x.loading, loading },
				{ x=>x.EventCallBack, OnSubmit },
				{ x=>x.OnSubmitFile, SubmitFile },
				{ x=>x.OnDeleteImage, DeleteImage }
			};
	}
}
