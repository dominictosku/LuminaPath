@using LuminaPath.Core.Enums
@using LuminaPath.Core.Models
@using LuminaPath.Features.Media.Games.Components
@using LuminaPath.Pages.Media.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using Severity = MudBlazor.Severity
@using Color = MudBlazor.Color
@inherits BaseFormDialog<MyGame>

<MudDialog>
	<DialogContent>
		<MudForm Model="@Model" @ref="@_form">
			<MudGrid Spacing="3">
				<MudItem xs="12">
					<div class="selected-game-preview">
						<div class="selected-cover" style="background-image: url('@SelectedGameCover');"></div>
						<div>
							<MudText Typo="Typo.subtitle1">@SelectedGameName</MudText>
							<MudText Typo="Typo.body2" Class="mud-text-secondary">@SelectedGameDetail</MudText>
							<div class="selected-game-meta">
								<span>@EnumLabel(Model.Status)</span>
								<span>Priority @PriorityText</span>
								<span>@RatingText</span>
							</div>
						</div>
					</div>
				</MudItem>
				<MudItem xs="12">
					<MudSelect @bind-Value="Model.GameId" Label="Game" Clearable="true" Variant="Variant.Outlined">
						@foreach (var game in GameSelect)
						{
							<MudSelectItem Value="game.Id">@game.Name</MudSelectItem>
						}
					</MudSelect>
				</MudItem>
				<MudItem xs="12" sm="6">
					<MudSelect @bind-Value="Model.Status" Label="Status" Variant="Variant.Outlined">
						@foreach (var status in Enum.GetValues(typeof(GameStatus)).Cast<GameStatus>())
						{
							<MudSelectItem T="GameStatus" Value="@status">@EnumLabel(status)</MudSelectItem>
						}
					</MudSelect>
				</MudItem>
				<MudItem xs="12" sm="6">
					<GamePrioritySelect @bind-Value="Model.Priority" />
				</MudItem>
				<MudItem xs="12">
					<GameRatingScale @bind-Value="Model.Rating" />
				</MudItem>
				<MudItem xs="12" sm="6">
					<MudDatePicker Label="Started On" @bind-Date="Model.StartDate" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" Clearable="true" />
				</MudItem>
				<MudItem xs="12" sm="6">
					<MudDatePicker Label="Finished On" @bind-Date="Model.EndDate" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" Clearable="true" />
				</MudItem>
				<MudItem xs="12">
					<div class="time-summary">
						<div class="time-summary-heading">
							<MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Primary" />
							<div>
								<MudText Typo="Typo.subtitle1">Played Time</MudText>
								<MudText Typo="Typo.body2" Class="mud-text-secondary">Manual time is editable. Third-party tracking stays read-only.</MudText>
							</div>
						</div>
						<MudGrid Spacing="2">
							<MudItem xs="12" md="4">
								<MudNumericField T="double?" @bind-Value="Model.TimeSpend" Label="Manual hours" Min="@((double?)0)" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="h" />
							</MudItem>
							<MudItem xs="12" md="4">
								<MudTextField T="string" Value="@FormatHours(ThirdPartyHours)" Label="Third-party tracked" ReadOnly="true" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="h" />
							</MudItem>
							<MudItem xs="12" md="4">
								<MudTextField T="string" Value="@FormatHours(TotalPlayedHours)" Label="Total played" ReadOnly="true" Variant="Variant.Filled" Adornment="Adornment.End" AdornmentText="h" />
							</MudItem>
						</MudGrid>
						@if (HasThirdPartyPlayData)
						{
							<div class="third-party-range">
								<span>First tracked: @FormatTrackedDate(Model.MyGameInfo?.FirstPlayed)</span>
								<span>Last tracked: @FormatTrackedDate(Model.MyGameInfo?.LastPlayed)</span>
							</div>
						}
					</div>
				</MudItem>
			</MudGrid>
		</MudForm>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel">Cancel</MudButton>
		<MudButton OnClick="Submit" Disabled="@loading">
			@if (loading)
			{
				<span class="spinner-border spinner-border-sm mr-1"></span>
			}
			Save
		</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[Parameter]
	public List<Game> GameSelect { get; set; } = new();

	private Game? SelectedGame => GameSelect.FirstOrDefault(x => x.Id == Model.GameId) ?? Model.Game;
	private string SelectedGameName => SelectedGame?.Name ?? "Select a game";
	private string SelectedGameDetail => SelectedGame?.Genres?.Count > 0
		? string.Join(" / ", SelectedGame.Genres.Take(3))
		: SelectedGame?.Description ?? "Choose the game this entry belongs to";
	private string SelectedGameCover => string.IsNullOrWhiteSpace(SelectedGame?.Image?.Url)
		? "/Images/Placeholder.png"
		: NormalizeUrl(SelectedGame.Image.Url);
	private double ManualHours => Model.TimeSpend ?? 0;
	private double ThirdPartyHours => Model.MyGameInfo?.TrackedHours ?? 0;
	private double TotalPlayedHours => ManualHours + ThirdPartyHours;
	private string PriorityText => Model.Priority is >= 1 and <= 4 ? Model.Priority.ToString() : "3";
	private string RatingText => Model.Rating is null ? "Not rated" : $"{Model.Rating}/10";
	private bool HasThirdPartyPlayData => Model.MyGameInfo is not null
		&& (Model.MyGameInfo.TrackedHours > 0
			|| Model.MyGameInfo.FirstPlayed != default
			|| Model.MyGameInfo.LastPlayed != default);

	private MudForm? _form;

	protected override void OnInitialized()
	{
		if (Model.Priority is < 1 or > 4)
		{
			Model.Priority = 3;
		}
	}

	private static string FormatHours(double hours)
	{
		return hours <= 0 ? "0" : hours.ToString("0.##");
	}

	private static string FormatTrackedDate(DateTime? date)
	{
		return date is null || date == default ? "Not tracked" : date.Value.ToString("dd.MM.yyyy");
	}

	private static string EnumLabel<TEnum>(TEnum value) where TEnum : struct, Enum
	{
		var member = typeof(TEnum).GetMember(value.ToString()).FirstOrDefault();
		var display = member?.GetCustomAttribute<DisplayAttribute>()?.Name;
		return string.IsNullOrWhiteSpace(display) ? SplitPascalCase(value.ToString()) : display;
	}

	private static string SplitPascalCase(string value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			return value;
		}

		var result = new List<char>(value.Length + 4);
		for (var i = 0; i < value.Length; i++)
		{
			var character = value[i];
			if (i > 0
				&& char.IsUpper(character)
				&& (char.IsLower(value[i - 1]) || i + 1 < value.Length && char.IsLower(value[i + 1])))
			{
				result.Add(' ');
			}

			result.Add(character);
		}

		return new string(result.ToArray());
	}

	private static string NormalizeUrl(string url)
	{
		return url.StartsWith("http", StringComparison.OrdinalIgnoreCase) || url.StartsWith("/", StringComparison.Ordinal)
			? url
			: $"/{url}";
	}
}

<style>
	.selected-game-preview {
		display: grid;
		grid-template-columns: 72px 1fr;
		gap: 14px;
		align-items: center;
		min-height: 88px;
		padding: 10px;
		border: 1px solid rgba(255, 255, 255, .08);
		border-radius: 8px;
		background: rgba(255, 255, 255, .03);
	}

	.selected-cover {
		width: 72px;
		height: 72px;
		border-radius: 6px;
		background-color: #263346;
		background-size: cover;
		background-position: center;
	}

	.selected-game-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 8px;
	}

	.selected-game-meta span {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		padding: 3px 9px;
		border-radius: 8px;
		background: rgba(118, 228, 196, .1);
		color: var(--mud-palette-text-primary);
		font-size: .78rem;
		font-weight: 800;
	}

	.time-summary {
		display: grid;
		gap: 14px;
		padding: 16px;
		border: 1px solid rgba(255, 255, 255, .08);
		border-radius: 8px;
		background: rgba(118, 228, 196, .06);
	}

	.time-summary-heading {
		display: flex;
		gap: 12px;
		align-items: center;
	}

	.third-party-range {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		color: var(--mud-palette-text-secondary);
		font-size: .86rem;
	}
</style>
