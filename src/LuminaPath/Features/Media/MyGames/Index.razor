@page "/Media/MyGames"
@using LuminaPath.Core.Entities
@using LuminaPath.Core.Enums
@using LuminaPath.Features.Media.Components
@using LuminaPath.Features.Media.MyGames.Components
@using LuminaPath.Infrastructure.Services.ModelServices
@using LuminaPath.Pages.Media
@using LuminaPath.Pages.Media.Components
@using Microsoft.AspNetCore.Authorization
@inherits BaseGridActions<MyGame, MyGameFormDialog>
@attribute [Authorize]
@inject GameService gameService
@inject MyGameService ModelService

<PageTitle>My Games</PageTitle>

<div class="media-page-header">
	<div>
		<p class="eyebrow">Personal Library</p>
		<h1>My Games</h1>
		<MudText Typo="Typo.body2" Class="mud-text-secondary">Track status, time, priority, and progress for your own game list.</MudText>
	</div>
	<MudButton OnClick="SwitchView" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@ViewIcon">@ToggleText</MudButton>
</div>

<AdvancedSearch Model="_filter" OnConditionChanged="ReloadData" ShowPersonalFilters="true" />

@if (IsGrid)
{
	<LuminaGrid T="MyGame" GetData="@(GetData)"
				Loading="@loading"
				@bind-SelectedItems="selectedItems"
				@ref="_table"
				SortMode="SortMode.Single">
		<ToolBarContent>
			<TableActions TItem="MyGame" Page="this" loading="loading" selectedItems="selectedItems" />
		</ToolBarContent>
		<Columns>
			<SelectColumn ShowInFooter="false"></SelectColumn>
			<TemplateColumn CellStyle="width:72px" Title="" Sortable="false">
				<CellTemplate>
					<div class="table-cover" style="background-image: url('@Cover(context.Item)');"></div>
				</CellTemplate>
			</TemplateColumn>
			<TemplateColumn Title="Game" SortBy="@((MyGame x) => x.Game == null ? "" : x.Game.Name)" Sortable="true">
				<CellTemplate>
					<div class="title-cell">
						<MudText Typo="Typo.body1">@context.Item.Game?.Name</MudText>
						<MudText Typo="Typo.body2" Class="mud-text-secondary">@Summary(context.Item)</MudText>
						<div class="chip-row">
							@foreach (var genre in context.Item.Game?.Genres?.Take(3) ?? [])
							{
								<span class="soft-chip">@genre</span>
							}
						</div>
					</div>
				</CellTemplate>
			</TemplateColumn>
			
			<TemplateColumn Title="Status" SortBy="@((MyGame x) => x.Status)" Sortable="true">
				<CellTemplate>
					<div class="status-stack">
						<span class="status-pill @StatusClass(context.Item.Status)">@context.Item.Status</span>
						<span class="muted-line">Priority @context.Item.Priority · @Rating(context.Item)</span>
					</div>
				</CellTemplate>
			</TemplateColumn>
			
			<TemplateColumn Title="Played Time" SortBy="@((MyGame x) => TotalHours(x))" Sortable="true">
				<CellTemplate>
					<div class="time-stack">
						<strong>@FormatHours(TotalHours(context.Item))h total</strong>
						<span>@FormatHours(ManualHours(context.Item))h manual</span>
						<span>@FormatHours(ThirdPartyHours(context.Item))h tracked</span>
					</div>
				</CellTemplate>
			</TemplateColumn>
			
			<TemplateColumn Title="Dates" SortBy="@((MyGame x) => x.StartDate)" Sortable="true">
				<CellTemplate>
					<div class="detail-stack">
						<span><MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" /> @DateText(context.Item.StartDate)</span>
						<span><MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Small" /> @DateText(context.Item.EndDate)</span>
					</div>
				</CellTemplate>
			</TemplateColumn>
			<TemplateColumn CellStyle="width:76px" Title="Actions" Sortable="false">
				<CellTemplate>
					<MudMenu Icon="@Icons.Material.Filled.MoreVert" Variant="Variant.Filled" DropShadow="false" Size="Size.Small"
							 Dense="true" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
						<MudMenuItem OnClick="@(async () => await OnUpdate(context.Item))">Edit</MudMenuItem>
						<MudMenuItem OnClick="@(async () => await Delete(context.Item))">Delete</MudMenuItem>
					</MudMenu>
				</CellTemplate>
			</TemplateColumn>
		</Columns>
		<NoRecordsContent>
			<MudText>No games found</MudText>
		</NoRecordsContent>
		<LoadingContent>
			<MudText>Loading games</MudText>
		</LoadingContent>
		<PagerContent>
			<MudDataGridPager />
		</PagerContent>
	</LuminaGrid>
}
else
{
	<div class="card-toolbar">
		<TableActions Page="this" loading="loading" selectedItems="selectedItems" />
	</div>
	<div class="game-card-grid">
		@foreach (var game in Games)
		{
			<article class="game-card">
				<div class="card-cover" style="background-image: url('@Cover(game)');">
					<span class="status-pill overlay @StatusClass(game.Status)">@game.Status</span>
				</div>
				<div class="game-card-body">
					<div>
						<h2>@game.Game?.Name</h2>
						<p>@Summary(game)</p>
					</div>
					<div class="chip-row">
						@foreach (var genre in game.Game?.Genres?.Take(3) ?? [])
						{
							<span class="soft-chip">@genre</span>
						}
					</div>
					<div class="time-panel">
						<div>
							<span>Total</span>
							<strong>@FormatHours(TotalHours(game))h</strong>
						</div>
						<div>
							<span>Manual</span>
							<strong>@FormatHours(ManualHours(game))h</strong>
						</div>
						<div>
							<span>Tracked</span>
							<strong>@FormatHours(ThirdPartyHours(game))h</strong>
						</div>
					</div>
					<div class="card-metrics">
						<span><MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" /> @Rating(game)</span>
						<span><MudIcon Icon="@Icons.Material.Filled.LowPriority" Size="Size.Small" /> Priority @game.Priority</span>
						<span><MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" /> @DateRange(game)</span>
					</div>
				</div>
				<div class="game-card-actions">
					<MudButton OnClick="@(() => OnUpdate(game))" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
					<MudButton OnClick="@(async () => await Delete(game))" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
				</div>
			</article>
		}
	</div>
}

<style>
	.media-page-header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 18px;
	}

	.media-page-header h1 {
		margin: 0;
		letter-spacing: 0;
	}

	.eyebrow {
		margin: 0 0 4px;
		color: var(--mud-palette-primary);
		font-size: .76rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.table-cover {
		width: 52px;
		height: 64px;
		border-radius: 6px;
		background-color: #263346;
		background-position: center;
		background-size: cover;
		box-shadow: 0 8px 22px rgba(0, 0, 0, .18);
	}

	.title-cell,
	.status-stack,
	.time-stack,
	.detail-stack {
		display: grid;
		gap: 4px;
	}

	.title-cell {
		min-width: 240px;
	}

	.chip-row {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.soft-chip,
	.status-pill {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		min-height: 24px;
		padding: 3px 9px;
		border-radius: 999px;
		background: rgba(118, 228, 196, .12);
		color: var(--mud-palette-text-primary);
		font-size: .78rem;
		font-weight: 700;
	}

	.status-playing { background: rgba(94, 220, 143, .18); }
	.status-main { background: rgba(244, 201, 93, .2); }
	.status-complete { background: rgba(117, 167, 255, .18); }
	.status-planned { background: rgba(188, 154, 255, .18); }
	.status-default { background: rgba(255, 255, 255, .1); }

	.status-pill.overlay {
		position: absolute;
		top: 10px;
		right: 10px;
		background-color: rgba(9, 15, 26, .84);
		color: #fff;
	}

	.muted-line,
	.time-stack span,
	.detail-stack,
	.card-metrics {
		color: var(--mud-palette-text-secondary);
		font-size: .88rem;
	}

	.time-stack strong {
		color: var(--mud-palette-text-primary);
	}

	.detail-stack span,
	.card-metrics span {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.card-toolbar {
		margin: 8px 0 14px;
		padding: 10px 0;
	}

	.game-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 16px;
	}

	.game-card {
		display: grid;
		grid-template-rows: 190px 1fr auto;
		min-height: 470px;
		border: 1px solid rgba(255, 255, 255, .08);
		border-radius: 8px;
		background: var(--mud-palette-surface);
		overflow: hidden;
		box-shadow: 0 14px 34px rgba(0, 0, 0, .14);
	}

	.card-cover {
		position: relative;
		background-color: #263346;
		background-position: center;
		background-size: cover;
	}

	.game-card-body {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px;
	}

	.game-card h2 {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.2;
		letter-spacing: 0;
	}

	.game-card p {
		margin: 6px 0 0;
		color: var(--mud-palette-text-secondary);
		line-height: 1.45;
	}

	.time-panel {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
	}

	.time-panel div {
		display: grid;
		gap: 2px;
		padding: 10px;
		border-radius: 8px;
		background: rgba(118, 228, 196, .08);
	}

	.time-panel span {
		color: var(--mud-palette-text-secondary);
		font-size: .74rem;
		font-weight: 700;
	}

	.time-panel strong {
		font-size: 1.05rem;
	}

	.card-metrics {
		display: grid;
		gap: 6px;
		margin-top: auto;
	}

	.game-card-actions {
		display: flex;
		justify-content: space-between;
		padding: 8px 10px 10px;
		border-top: 1px solid rgba(255, 255, 255, .08);
	}

	@@media (max-width: 720px) {
		.media-page-header {
			align-items: stretch;
			flex-direction: column;
		}
	}
</style>

@code {
	private readonly string _placeholderCover = "/Images/Placeholder.png";
	private List<MyGame> Games = new();
	private List<Game> DropdownGames = new();
	private MudDataGrid<MyGame> _table = default!;
	protected override string EntityLabel => "My Game";
	private string ViewIcon => IsGrid ? Icons.Material.Filled.ViewModule : Icons.Material.Filled.TableRows;

	protected override async Task OnInitializedAsync()
	{
		DropdownGames = await gameService.GetDropdownGames();
		await base.OnInitializedAsync();
	}

	public override async Task ReloadData()
	{
		if (IsGrid)
		{
			await _table.ReloadServerData();
		}
		else
		{
			Games = await GetData();
			StateHasChanged();
		}
	}

	private async Task SwitchView()
	{
		IsGrid = !IsGrid;
		await ReloadData();
	}

	private async Task<List<MyGame>> GetData()
	{
		if (string.IsNullOrWhiteSpace(UserId))
		{
			return [];
		}

		var result = await ModelService.GetMyMedia(UserId);
		result = ApplyFilters(result).ToList();
		Games = result;
		return result;
	}

	private IEnumerable<MyGame> ApplyFilters(IEnumerable<MyGame> games)
	{
		if (!string.IsNullOrWhiteSpace(_filter.SearchString))
		{
			var search = _filter.SearchString.Trim();
			games = games.Where(myGame =>
				Contains(myGame.Game?.Name, search) ||
				Contains(myGame.Game?.Description, search) ||
				Contains(myGame.Game?.Source, search) ||
				myGame.Game?.Genres.Any(genre => Contains(genre, search)) == true ||
				myGame.Status.ToString().Contains(search, StringComparison.OrdinalIgnoreCase));
		}

		if (_filter.From is not null)
		{
			games = games.Where(myGame => myGame.Game?.ReleaseDate >= _filter.From);
		}

		if (_filter.To is not null)
		{
			games = games.Where(myGame => myGame.Game?.ReleaseDate <= _filter.To);
		}

		if (_filter.Platform is not null)
		{
			games = games.Where(myGame => myGame.Game?.Platforms.HasFlag(_filter.Platform.Value) == true);
		}

		if (_filter.Status is not null)
		{
			games = games.Where(myGame => myGame.Status == _filter.Status);
		}

		if (!string.IsNullOrWhiteSpace(_filter.Genre))
		{
			var genreFilter = _filter.Genre.Trim();
			games = games.Where(myGame => myGame.Game?.Genres.Any(genre => Contains(genre, genreFilter)) == true);
		}

		if (!string.IsNullOrWhiteSpace(_filter.Source))
		{
			var sourceFilter = _filter.Source.Trim();
			games = games.Where(myGame => Contains(myGame.Game?.Source, sourceFilter));
		}

		if (_filter.MinPlaytime is not null)
		{
			games = games.Where(myGame => myGame.Game?.Playtime >= _filter.MinPlaytime);
		}

		if (_filter.MaxPlaytime is not null)
		{
			games = games.Where(myGame => myGame.Game?.Playtime <= _filter.MaxPlaytime);
		}

		if (_filter.Priority is not null)
		{
			games = games.Where(myGame => myGame.Priority == _filter.Priority);
		}

		if (_filter.MinRating is not null)
		{
			games = games.Where(myGame => myGame.Rating >= _filter.MinRating);
		}

		if (_filter.MinPlayedHours is not null)
		{
			games = games.Where(myGame => TotalHours(myGame) >= _filter.MinPlayedHours);
		}

		if (_filter.OnlyWithRemainingHours)
		{
			games = games.Where(myGame => RemainingFor(myGame) > 0);
		}

		return games;
	}

	public override async Task<MyGame> GetById(int id)
	{
		return await ModelService.GetById(id, ModelService.Includes);
	}

	public override async Task Save(MyGame entity)
	{
		await ModelService.PostAsync(entity, User);
	}

	public override async Task Update(MyGame entity)
	{
		await ModelService.PutAsync(entity, User);
	}

	public override async Task DeleteMedia(MyGame entity)
	{
		await ModelService.DeleteAsync(entity.Id);
	}

	private string Cover(MyGame? myGame)
	{
		return string.IsNullOrWhiteSpace(myGame?.Game?.Image?.Url)
			? _placeholderCover
			: NormalizeUrl(myGame.Game.Image.Url);
	}

	private static string NormalizeUrl(string url)
	{
		return url.StartsWith("http", StringComparison.OrdinalIgnoreCase) || url.StartsWith("/")
			? url
			: $"/{url}";
	}

	private static string Summary(MyGame myGame)
	{
		var game = myGame.Game;
		if (game is null)
		{
			return "No game details";
		}

		if (string.IsNullOrWhiteSpace(game.Description))
		{
			return game.Genres.Count > 0 ? string.Join(" / ", game.Genres.Take(3)) : "No description yet";
		}

		return game.Description.Length > 110 ? $"{game.Description[..110]}..." : game.Description;
	}

	private static double ManualHours(MyGame myGame)
	{
		return myGame.TimeSpend ?? 0;
	}

	private static double ThirdPartyHours(MyGame myGame)
	{
		return myGame.MyGameInfo?.TrackedHours ?? 0;
	}

	private static double TotalHours(MyGame myGame)
	{
		return ManualHours(myGame) + ThirdPartyHours(myGame);
	}

	private static double RemainingFor(MyGame myGame)
	{
		var estimate = myGame.Game?.Playtime ?? 0;
		return Math.Max(0, estimate - TotalHours(myGame));
	}

	private static string FormatHours(double hours)
	{
		return hours <= 0 ? "0" : hours.ToString("0.##");
	}

	private static string Rating(MyGame myGame)
	{
		return myGame.Rating is null ? "Unrated" : $"{myGame.Rating}/10";
	}

	private static string DateText(DateTime? date)
	{
		return date?.ToString("dd.MM.yyyy") ?? "No date";
	}

	private static string DateRange(MyGame myGame)
	{
		if (myGame.StartDate is null && myGame.EndDate is null)
		{
			return "No dates";
		}

		return $"{DateText(myGame.StartDate)} - {DateText(myGame.EndDate)}";
	}

	private static string StatusClass(GameStatus status)
	{
		return status switch
		{
			GameStatus.Playing => "status-playing",
			GameStatus.MainGame => "status-main",
			GameStatus.Completed or GameStatus.StoryComplete => "status-complete",
			GameStatus.Planned => "status-planned",
			_ => "status-default"
		};
	}

	private static bool Contains(string? value, string search)
	{
		return value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
	}

	protected override DialogParameters<MyGameFormDialog> CreateDialogParameters(MyGame command, Func<MyGame, Task> OnSubmit)
	{
		return new DialogParameters<MyGameFormDialog>
			{
				{ x=>x.Refresh , new Action(async () => await ReloadData()) },
				{ x=>x.Model, command },
				{ x=>x.GameSelect, DropdownGames },
				{ x=>x.loading, loading },
				{ x=>x.EventCallBack, OnSubmit }
			};
	}
}
