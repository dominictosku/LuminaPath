		align-items: end;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 18px;
	}

	.media-page-header h1 {
		margin: 0;
		letter-spacing: 0;
	}

	.eyebrow {
		margin: 0 0 4px;
		color: var(--mud-palette-primary);
		font-size: .76rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.table-cover {
		width: 54px;
		height: 72px;
		border-radius: 7px;
		background-color: #263346;
		background-position: center;
		background-size: cover;
		box-shadow: 0 8px 22px rgba(0, 0, 0, .18);
	}

	.table-cover-frame {
		display: inline-grid;
		place-items: center;
		padding: 4px;
		border: 1px solid rgba(117, 167, 255, .18);
