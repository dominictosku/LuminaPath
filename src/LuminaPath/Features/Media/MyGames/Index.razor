@page "/Media/MyGames"
@using LuminaPath.Core.Entities
@using LuminaPath.Features.Media.Components
@using LuminaPath.Features.Media.MyGames.Components
@using LuminaPath.Infrastructure.Services.ModelServices
@using LuminaPath.Pages.Media
@using LuminaPath.Pages.Media.Components
@using Microsoft.AspNetCore.Authorization
@inherits BaseGridActions<MyGame, MyGameFormDialog>
@attribute [Authorize]
@inject GameService gameService
@inject MyGameService ModelService

<PageTitle>Games</PageTitle>

<h1>Games</h1>
<MudButton OnClick="SwitchView" Variant="Variant.Filled" Color="Color.Primary">@ToggleText</MudButton>
<AdvancedSearch Model="_filter" OnConditionChanged="ReloadData" />
@if (IsGrid)
{
	<LuminaGrid T="MyGame" GetData="@(GetData)"
	Loading="@loading"
	@bind-SelectedItems="selectedItems"
	@bind-SelectedItem="_currentDto"
	@ref="_table">
		<ToolBarContent>
			<TableActions TItem="MyGame" Page="this" loading="loading" selectedItems="selectedItems" />
		</ToolBarContent>
		<Columns>
			<SelectColumn ShowInFooter="false"></SelectColumn>
			<TemplateColumn CellStyle="width:60px" Title="Actions" Sortable="false">
				<CellTemplate>
					<MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" DropShadow="false" Size="Size.Small"
					Dense="true"
					EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
						<MudMenuItem OnClick="@(async () => await OnUpdate(context.Item))">Edit</MudMenuItem>

						<MudMenuItem OnClick="@(async () => await Delete(context.Item))">Delete</MudMenuItem>
					</MudMenu>
				</CellTemplate>
			</TemplateColumn>

			<PropertyColumn Property="x => x.Game!.Name" Title="Title">
				<CellTemplate>
					<div class="d-flex flex-column">
						<MudText Typo="Typo.body2">@context.Item.Game?.Name</MudText>
						<MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Game?.Description</MudText>
					</div>
				</CellTemplate>
			</PropertyColumn>
			<PropertyColumn Property="x => x.Game!.Genres" Title="Genre">
				<CellTemplate>
					<div class="d-flex flex-column">
						<MudText Typo="Typo.body2">@string.Join(",", context.Item.Game?.Genres ?? [])</MudText>
					</div>
				</CellTemplate>
			</PropertyColumn>
			<PropertyColumn Property="x => x.Status" Title="Status" />
		</Columns>
		<NoRecordsContent>
			<MudText>No items found</MudText>
		</NoRecordsContent>
		<LoadingContent>
			<MudText>Loading</MudText>
		</LoadingContent>
		<PagerContent>
			<MudDataGridPager />
		</PagerContent>
	</LuminaGrid>
}
else
{
	<MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="background-color:#121e2d;">
		<MudToolBar class="mud-table-toolbar">
			<TableActions Page="this" loading="loading" selectedItems="selectedItems" />
		</MudToolBar>
		<MudGrid Spacing="2">
			@foreach (var game in Games)
			{
				<MudItem>
					<MudCard Outlined="true">
						<MudCardMedia Image="@game.Game?.Image?.Url" Height="200" />
						<MudCardContent Style="height:80px;">
							<MudText Typo="Typo.h5">@game.Game?.Name</MudText>
							<MudText Typo="Typo.body2">@game.Game?.Description</MudText>
						</MudCardContent>
						<MudCardActions Style="height:50px;">
							<MudButton OnClick="@(() => OnUpdate(game))" Variant="Variant.Text" Color="Color.Primary">Edit</MudButton>
							<MudButton Variant="Variant.Text" Color="Color.Primary">Add To List</MudButton>
						</MudCardActions>
					</MudCard>
				</MudItem>
			}
		</MudGrid>
	</MudContainer>
}

<style>
	@@import url("https://cdn.jsdelivr.net/npm/@@fancyapps/ui@5.0/dist/fancybox/fancybox.css");

	.fancybox__container {
	--fancybox-bg: rgba(24, 24, 27, 0.85);
	z-index: 9999;
	}

	.mud-table-toolbar {
	height: 120px !important;
	}
</style>

@code {
	private List<MyGame> Games = new();
	private List<Game> DropdownGames = new();
	private MudDataGrid<MyGame> _table = default!;
	protected override string EntityLabel => "My Game";

	protected override async Task OnInitializedAsync()
	{
		DropdownGames = await gameService.GetDropdownGames();
		await base.OnInitializedAsync();
	}

	public override async Task ReloadData()
	{
		if (IsGrid)
		{
			await _table.ReloadServerData();
		}
		else
		{
			Games = await GetData();
			StateHasChanged();
		}
	}

	private async Task SwitchView()
	{
		IsGrid = !IsGrid;
		await ReloadData();
	}

	private async Task<List<MyGame>> GetData()
	{
		if (string.IsNullOrWhiteSpace(UserId))
		{
			return [];
		}

		var result = await ModelService.GetMyMedia(UserId);
		Games = result;
		return result;
	}

	#region CRUD Actions

	public override async Task<MyGame> GetById(int id)
	{
		return await ModelService.GetById(id);
	}

	public override async Task Save(MyGame entity)
	{
		await ModelService.PostAsync(entity, User);
	}

	public override async Task Update(MyGame entity)
	{
		await ModelService.PutAsync(entity, User);
	}

	public override async Task DeleteMedia(MyGame entity)
	{
		await ModelService.DeleteAsync(entity.Id);
	}

	protected override DialogParameters<MyGameFormDialog> CreateDialogParameters(MyGame command, Func<MyGame, Task> OnSubmit)
	{
		return new DialogParameters<MyGameFormDialog>
			{
				{ x=>x.Refresh , new Action(async () => await ReloadData()) },
				{ x=>x.Model, command },
				{ x=>x.GameSelect, DropdownGames },
				{ x=>x.loading, loading },
				{ x=>x.EventCallBack, OnSubmit }
			};
	}
	#endregion
}

