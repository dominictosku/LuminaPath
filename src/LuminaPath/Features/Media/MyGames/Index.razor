		background: linear-gradient(180deg, rgba(117, 167, 255, .12), rgba(118, 228, 196, .05));
	}

	.my-games-table-frame {
		border: 1px solid rgba(117, 167, 255, .16);
		border-radius: 12px;
		background:
			linear-gradient(180deg, rgba(117, 167, 255, .08), rgba(9, 15, 26, .02)),
			var(--mud-palette-surface);
		box-shadow: 0 18px 48px rgba(0, 0, 0, .2);
		overflow: hidden;
	}

	.my-games-data-grid {
		border: 0;
		background: transparent;
	}

	.my-games-data-grid .mud-table-toolbar {
		min-height: 72px;
		padding: 12px 16px;
		border-bottom: 1px solid rgba(255, 255, 255, .08);
		background: rgba(12, 20, 35, .72);
	}

	.my-games-data-grid .mud-table-head .mud-table-cell {
		border-bottom: 1px solid rgba(117, 167, 255, .16);
		color: var(--mud-palette-text-secondary);
		font-size: .76rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.my-games-data-grid .mud-table-row {
		background: rgba(15, 24, 40, .62);
