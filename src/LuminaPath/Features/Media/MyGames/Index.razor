@page "/Media/MyGames"
@using LuminaPath.Core.Entities
@using LuminaPath.Core.Enums
@using LuminaPath.Features.Media.Components
@using LuminaPath.Features.Media.MyGames.Components
@using LuminaPath.Infrastructure.Services.ModelServices
@using LuminaPath.Pages.Media
@using LuminaPath.Pages.Media.Components
@using Microsoft.AspNetCore.Authorization
@inherits BaseGridActions<MyGame, MyGameFormDialog>
@attribute [Authorize]
@inject GameService gameService
@inject MyGameService ModelService

<PageTitle>My Games</PageTitle>

<div class="media-page-header">
	<div>
		<p class="eyebrow">Personal Library</p>
		<h1>My Games</h1>
		<MudText Typo="Typo.body2" Class="mud-text-secondary">Track status, time, priority, and progress for your own game list.</MudText>
	</div>
	<MudButton OnClick="SwitchView" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@ViewIcon">@ToggleText</MudButton>
</div>

<AdvancedSearch Model="_filter" OnConditionChanged="ReloadData" ShowPersonalFilters="true" />

@if (IsGrid)
{
	<section class="my-games-table-frame">
		<LuminaGrid T="MyGame" GetData="@(GetData)"
					Loading="@loading"
					@bind-SelectedItems="selectedItems"
					@ref="_table"
					SortMode="SortMode.Single"
					Class="my-games-data-grid">
			<ToolBarContent>
				<TableActions TItem="MyGame" Page="this" loading="loading" selectedItems="selectedItems" />
			</ToolBarContent>
			<Columns>
				<SelectColumn ShowInFooter="false"></SelectColumn>
				<TemplateColumn CellStyle="width:84px" Title="" Sortable="false">
					<CellTemplate>
						<div class="table-cover-frame">
							<div class="table-cover" style="background-image: url('@Cover(context.Item)');"></div>
						</div>
					</CellTemplate>
				</TemplateColumn>
				<TemplateColumn Title="Game" SortBy="@((MyGame x) => x.Game == null ? "" : x.Game.Name)" Sortable="true">
					<CellTemplate>
						<div class="title-cell">
							<div class="title-row">
								<MudText Typo="Typo.body1">@context.Item.Game?.Name</MudText>
								<span class="platform-chip">@PlatformLabel(context.Item)</span>
							</div>
							<MudText Typo="Typo.body2" Class="game-summary">@Summary(context.Item)</MudText>
							<div class="chip-row">
								@foreach (var genre in context.Item.Game?.Genres?.Take(3) ?? [])
								{
									<span class="soft-chip">@genre</span>
								}
							</div>
						</div>
					</CellTemplate>
				</TemplateColumn>
				<TemplateColumn Title="Status" SortBy="@((MyGame x) => x.Status)" Sortable="true">
					<CellTemplate>
						<div class="status-stack">
							<span class="status-pill @StatusClass(context.Item.Status)">@context.Item.Status</span>
							<div class="meta-row">
								<span><MudIcon Icon="@Icons.Material.Filled.LowPriority" Size="Size.Small" /> Priority @context.Item.Priority</span>
								<span><MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" /> @Rating(context.Item)</span>
							</div>
						</div>
					</CellTemplate>
				</TemplateColumn>
				<TemplateColumn Title="Progress" SortBy="@((MyGame x) => TotalHours(x))" Sortable="true">
					<CellTemplate>
						<div class="progress-cell">
							<div class="progress-header">
								<strong>@ProgressPercent(context.Item)%</strong>
								<span>@RemainingText(context.Item)</span>
							</div>
							<div class="progress-track">
								<div class="progress-fill @StatusClass(context.Item.Status)" style="width: @ProgressWidth(context.Item);"></div>
							</div>
						</div>
					</CellTemplate>
				</TemplateColumn>
				<TemplateColumn Title="Played Time" SortBy="@((MyGame x) => TotalHours(x))" Sortable="true">
					<CellTemplate>
						<div class="time-pill-grid">
							<span><strong>@FormatHours(TotalHours(context.Item))h</strong> total</span>
							<span>@FormatHours(ManualHours(context.Item))h manual</span>
							<span>@FormatHours(ThirdPartyHours(context.Item))h tracked</span>
						</div>
					</CellTemplate>
				</TemplateColumn>
				<TemplateColumn Title="Dates" SortBy="@((MyGame x) => x.StartDate)" Sortable="true">
					<CellTemplate>
						<div class="date-pill-grid">
							<span><MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" /> @DateText(context.Item.StartDate)</span>
							<span><MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Small" /> @DateText(context.Item.EndDate)</span>
						</div>
					</CellTemplate>
				</TemplateColumn>
				<TemplateColumn CellStyle="width:96px" Title="Actions" Sortable="false">
					<CellTemplate>
						<div class="table-action-icons">
							<MudTooltip Text="Edit library entry">
								<MudIconButton Icon="@Icons.Material.Filled.Edit"
											   Variant="Variant.Text"
											   Color="Color.Primary"
											   Size="Size.Small"
											   DropShadow="false"
											   OnClick="@(async () => await OnUpdate(context.Item))" />
							</MudTooltip>
							<MudTooltip Text="Remove from library">
								<MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
											   Variant="Variant.Text"
											   Color="Color.Error"
											   Size="Size.Small"
											   DropShadow="false"
											   OnClick="@(async () => await Delete(context.Item))" />
							</MudTooltip>
						</div>
					</CellTemplate>
				</TemplateColumn>
			</Columns>
			<NoRecordsContent>
				<div class="grid-state">
					<MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Large" />
					<MudText Typo="Typo.subtitle1">No games in this view</MudText>
					<MudText Typo="Typo.body2" Class="mud-text-secondary">Add a game or adjust your filters.</MudText>
				</div>
			</NoRecordsContent>
			<LoadingContent>
				<div class="grid-state">
					<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" />
					<MudText Typo="Typo.body2">Loading your games</MudText>
				</div>
			</LoadingContent>
			<PagerContent>
				<MudDataGridPager />
			</PagerContent>
		</LuminaGrid>
	</section>
}
else
{
	<div class="card-toolbar">
		<TableActions Page="this" loading="loading" selectedItems="selectedItems" />
	</div>
	<div class="game-card-grid">
		@foreach (var game in Games)
		{
			<article class="game-card">
				<div class="card-cover" style="background-image: url('@Cover(game)');">
					<span class="status-pill overlay @StatusClass(game.Status)">@game.Status</span>
				</div>
				<div class="game-card-body">
					<div>
						<h2>@game.Game?.Name</h2>
						<p>@Summary(game)</p>
					</div>
					<div class="chip-row">
						@foreach (var genre in game.Game?.Genres?.Take(3) ?? [])
						{
							<span class="soft-chip">@genre</span>
						}
					</div>
					<div class="time-panel">
						<div>
							<span>Total</span>
							<strong>@FormatHours(TotalHours(game))h</strong>
						</div>
						<div>
							<span>Manual</span>
							<strong>@FormatHours(ManualHours(game))h</strong>
						</div>
						<div>
							<span>Tracked</span>
							<strong>@FormatHours(ThirdPartyHours(game))h</strong>
						</div>
					</div>
					<div class="card-metrics">
						<span><MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" /> @Rating(game)</span>
						<span><MudIcon Icon="@Icons.Material.Filled.LowPriority" Size="Size.Small" /> Priority @game.Priority</span>
						<span><MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" /> @DateRange(game)</span>
					</div>
				</div>
				<div class="game-card-actions">
					<MudButton OnClick="@(() => OnUpdate(game))" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
					<MudButton OnClick="@(async () => await Delete(game))" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
				</div>
			</article>
		}
	</div>
}

<style>
	.media-page-header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 18px;
	}

	.media-page-header h1 {
		margin: 0;
		letter-spacing: 0;
	}

	.eyebrow {
		margin: 0 0 4px;
		color: var(--mud-palette-primary);
		font-size: .76rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.table-cover {
		width: 54px;
		height: 72px;
		border-radius: 7px;
		background-color: #263346;
		background-position: center;
		background-size: cover;
		box-shadow: 0 8px 22px rgba(0, 0, 0, .18);
	}

	.table-cover-frame {
		display: inline-grid;
		place-items: center;
		padding: 4px;
		border: 1px solid rgba(117, 167, 255, .18);
		border-radius: 10px;
		background: linear-gradient(180deg, rgba(117, 167, 255, .12), rgba(118, 228, 196, .05));
	}

	.my-games-table-frame {
		border: 1px solid rgba(117, 167, 255, .16);
		border-radius: 12px;
		background:
			linear-gradient(180deg, rgba(117, 167, 255, .08), rgba(9, 15, 26, .02)),
			var(--mud-palette-surface);
		box-shadow: 0 18px 48px rgba(0, 0, 0, .2);
		overflow: hidden;
	}

	.my-games-data-grid {
		border: 0;
		background: transparent;
	}

	.my-games-data-grid .mud-table-toolbar {
		min-height: 72px;
		padding: 12px 16px;
		border-bottom: 1px solid rgba(255, 255, 255, .08);
		background: rgba(12, 20, 35, .72);
	}

	.my-games-data-grid .mud-table-head .mud-table-cell {
		border-bottom: 1px solid rgba(117, 167, 255, .16);
		color: var(--mud-palette-text-secondary);
		font-size: .76rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.my-games-data-grid .mud-table-row {
		background: rgba(15, 24, 40, .62);
		transition: background .16s ease;
	}

	.my-games-data-grid .mud-table-row:hover {
		background: rgba(30, 48, 78, .72);
	}

	.my-games-data-grid .mud-table-cell {
		border-bottom: 1px solid rgba(255, 255, 255, .07);
		padding-top: 12px;
		padding-bottom: 12px;
	}

	.title-cell,
	.status-stack,
	.time-stack,
	.detail-stack {
		display: grid;
		gap: 7px;
	}

	.title-cell {
		min-width: min(420px, 40vw);
	}

	.title-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
	}

	.title-row .mud-typography {
		font-weight: 800;
		line-height: 1.2;
	}

	.game-summary {
		display: -webkit-box;
		max-width: 620px;
		overflow: hidden;
		color: var(--mud-palette-text-secondary);
		line-height: 1.35;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.chip-row {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.soft-chip,
	.status-pill,
	.platform-chip {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		min-height: 24px;
		padding: 3px 9px;
		border: 1px solid rgba(255, 255, 255, .08);
		border-radius: 6px;
		background: rgba(118, 228, 196, .12);
		color: var(--mud-palette-text-primary);
		font-size: .78rem;
		font-weight: 700;
	}

	.platform-chip {
		background: rgba(117, 167, 255, .14);
		color: #a9c8ff;
	}

	.status-playing { background: rgba(94, 220, 143, .18); }
	.status-main { background: rgba(244, 201, 93, .2); }
	.status-complete { background: rgba(117, 167, 255, .18); }
	.status-planned { background: rgba(188, 154, 255, .18); }
	.status-default { background: rgba(255, 255, 255, .1); }

	.status-pill.overlay {
		position: absolute;
		top: 10px;
		right: 10px;
		background-color: rgba(9, 15, 26, .84);
		color: #fff;
	}

	.muted-line,
	.time-stack span,
	.detail-stack,
	.card-metrics {
		color: var(--mud-palette-text-secondary);
		font-size: .88rem;
	}

	.time-stack strong {
		color: var(--mud-palette-text-primary);
	}

	.meta-row,
	.detail-stack span,
	.card-metrics span {
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 6px;
	}

	.meta-row {
		color: var(--mud-palette-text-secondary);
		font-size: .82rem;
	}

	.progress-cell {
		display: grid;
		gap: 8px;
		min-width: 168px;
	}

	.progress-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
	}

	.progress-header strong {
		color: var(--mud-palette-text-primary);
		font-size: 1.04rem;
	}

	.progress-header span {
		color: var(--mud-palette-text-secondary);
		font-size: .78rem;
		font-weight: 700;
	}

	.progress-track {
		height: 9px;
		overflow: hidden;
		border: 1px solid rgba(117, 167, 255, .16);
		border-radius: 999px;
		background: rgba(255, 255, 255, .06);
	}

	.progress-fill {
		height: 100%;
		min-width: 3px;
		border-radius: inherit;
		background: rgba(117, 167, 255, .72);
	}

	.progress-fill.status-playing { background: rgba(94, 220, 143, .82); }
	.progress-fill.status-main { background: rgba(244, 201, 93, .86); }
	.progress-fill.status-complete { background: rgba(117, 167, 255, .9); }
	.progress-fill.status-planned { background: rgba(188, 154, 255, .8); }

	.time-pill-grid,
	.date-pill-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		min-width: 190px;
		max-width: 340px;
	}

	.time-pill-grid span,
	.date-pill-grid span {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 30px;
		padding: 5px 9px;
		border: 1px solid rgba(117, 167, 255, .13);
		border-radius: 7px;
		background: rgba(255, 255, 255, .04);
		color: var(--mud-palette-text-secondary);
		font-size: .82rem;
		font-weight: 700;
	}

	.time-pill-grid strong {
		color: var(--mud-palette-text-primary);
	}

	.table-action-icons {
		display: flex;
		align-items: center;
		gap: 2px;
		justify-content: flex-end;
	}

	.table-action-icons .mud-icon-button {
		border-radius: 7px;
		background: rgba(255, 255, 255, .035);
	}

	.grid-state {
		display: grid;
		place-items: center;
		gap: 8px;
		min-height: 220px;
		color: var(--mud-palette-text-secondary);
		text-align: center;
	}

	.card-toolbar {
		margin: 8px 0 14px;
		padding: 10px 0;
	}

	.game-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 16px;
	}

	.game-card {
		display: grid;
		grid-template-rows: 190px 1fr auto;
		min-height: 470px;
		border: 1px solid rgba(255, 255, 255, .08);
		border-radius: 8px;
		background: var(--mud-palette-surface);
		overflow: hidden;
		box-shadow: 0 14px 34px rgba(0, 0, 0, .14);
	}

	.card-cover {
		position: relative;
		background-color: #263346;
		background-position: center;
		background-size: cover;
	}

	.game-card-body {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px;
	}

	.game-card h2 {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.2;
		letter-spacing: 0;
	}

	.game-card p {
		margin: 6px 0 0;
		color: var(--mud-palette-text-secondary);
		line-height: 1.45;
	}

	.time-panel {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
	}

	.time-panel div {
		display: grid;
		gap: 2px;
		padding: 10px;
		border-radius: 8px;
		background: rgba(118, 228, 196, .08);
	}

	.time-panel span {
		color: var(--mud-palette-text-secondary);
		font-size: .74rem;
		font-weight: 700;
	}

	.time-panel strong {
		font-size: 1.05rem;
	}

	.card-metrics {
		display: grid;
		gap: 6px;
		margin-top: auto;
	}

	.game-card-actions {
		display: flex;
		justify-content: space-between;
		padding: 8px 10px 10px;
		border-top: 1px solid rgba(255, 255, 255, .08);
	}

	@@media (max-width: 720px) {
		.media-page-header {
			align-items: stretch;
			flex-direction: column;
		}

		.title-cell {
			min-width: 260px;
		}

		.my-games-data-grid .mud-table-toolbar {
			padding: 10px;
		}
	}
</style>
