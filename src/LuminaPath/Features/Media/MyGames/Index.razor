	}

	.title-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
	}

	.title-row .mud-typography {
		font-weight: 800;
		line-height: 1.2;
	}

	.game-summary {
		display: -webkit-box;
		max-width: 620px;
		overflow: hidden;
		color: var(--mud-palette-text-secondary);
