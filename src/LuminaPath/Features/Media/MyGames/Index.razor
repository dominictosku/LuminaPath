		align-items: center;
		flex-wrap: wrap;
		gap: 6px;
	}

	.meta-row {
		color: var(--mud-palette-text-secondary);
		font-size: .82rem;
	}

	.progress-cell {
		display: grid;
		gap: 8px;
		min-width: 168px;
	}

	.progress-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
	}

	.progress-header strong {
