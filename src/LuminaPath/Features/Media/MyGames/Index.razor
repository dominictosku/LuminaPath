		border-radius: inherit;
		background: rgba(117, 167, 255, .72);
	}

	.progress-fill.status-playing { background: rgba(94, 220, 143, .82); }
	.progress-fill.status-main { background: rgba(244, 201, 93, .86); }
	.progress-fill.status-complete { background: rgba(117, 167, 255, .9); }
	.progress-fill.status-planned { background: rgba(188, 154, 255, .8); }

	.time-pill-grid,
	.date-pill-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		min-width: 190px;
		max-width: 340px;
	}

	.time-pill-grid span,
	.date-pill-grid span {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 30px;
		padding: 5px 9px;
		border: 1px solid rgba(117, 167, 255, .13);
		border-radius: 7px;
		background: rgba(255, 255, 255, .04);
		color: var(--mud-palette-text-secondary);
		font-size: .82rem;
		font-weight: 700;
	}

	.time-pill-grid strong {
		color: var(--mud-palette-text-primary);
