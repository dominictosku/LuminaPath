@using LuminaPath.Core.Models
@using LuminaPath.Features.Media
@typeparam TItem
<div class="table-actions-shell">
    <div class="table-actions-spacer"></div>

    <div class="table-actions-panel">
        <MudTextField T="string"
                      Value="@Page.SearchText"
                      ValueChanged="ApplySearch"
                      Placeholder="Search this view"
                      Clearable="true"
                      Immediate="true"
                      DebounceInterval="250"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Small"
                      Class="table-action-search" />

        <div class="table-actions-buttons">
            <MudTooltip Text="Reload table data">
                <MudIconButton DropShadow="false"
                               Variant="Variant.Text"
                               Disabled="@loading"
                               OnClick="Page.ReloadData"
                               Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               Size="Size.Medium"
                               Class="table-action-icon" />
            </MudTooltip>

            <MudButton DropShadow="false"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Medium"
                       Disabled="@loading"
                       OnClick="Page.OnCreate"
                       Class="table-action-button">
                Create
            </MudButton>

            <MudButton DropShadow="false"
                       Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Disabled="@(!(selectedItems.Count > 0))"
                       Size="Size.Medium"
                       OnClick="Page.OnDeleteChecked"
                       Class="table-action-button table-action-danger">
                Delete
            </MudButton>
        </div>
    </div>
</div>

<style>
    .table-actions-shell {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
    }

    .table-actions-spacer {
        flex: 1 1 auto;
    }

    .table-actions-panel {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        min-width: min(100%, 620px);
    }

    .table-actions-buttons {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 6px;
        width: auto;
    }

    .table-action-button {
        min-height: 34px;
        border-radius: 6px;
        font-weight: 700;
        letter-spacing: 0;
        color: var(--mud-palette-text-primary);
    }

    .table-action-icon {
        border-radius: 6px;
        color: var(--mud-palette-primary);
    }

    .table-action-danger {
        color: var(--mud-palette-error);
    }

    .table-action-search {
        width: 280px;
        max-width: 36vw;
    }

    @@media (max-width: 720px) {
        .table-actions-shell,
        .table-actions-panel {
            display: grid;
            width: 100%;
        }

        .table-actions-spacer {
            display: none;
        }

        .table-actions-panel {
            justify-items: stretch;
            min-width: 0;
            gap: 8px;
        }

        .table-actions-buttons {
            justify-content: stretch;
            width: 100%;
        }

        .table-action-button {
            flex: 1 1 132px;
        }

        .table-action-search {
            max-width: none;
        }
    }
</style>

@code{
    [EditorRequired]
    [Parameter]
    public ITableActions<TItem> Page { get; set; } = default!;

    [EditorRequired]
    [Parameter]
    public bool loading { get; set; } = default!;

    [EditorRequired]
    [Parameter]
    public HashSet<TItem> selectedItems { get; set; } = default!;

    private async Task ApplySearch(string? searchText)
    {
        await Page.ApplySearch(searchText);
    }
}
