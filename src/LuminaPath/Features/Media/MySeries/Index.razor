@page "/Media/MySeries"
@using LuminaPath.Core.Enums
@using LuminaPath.Core.Models
@using LuminaPath.Features.Media.Components
@using LuminaPath.Features.Media.MySeries.Components
@using LuminaPath.Infrastructure.Services.ModelServices
@using LuminaPath.Pages.Media
@using LuminaPath.Pages.Media.Components
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits BaseGridActions<MySeries, MySeriesFormDialog>
@inject SeriesService SeriesService
@inject MySeriesService ModelService

<PageTitle>My Series</PageTitle>

<div class="media-page-header">
    <div>
        <p class="eyebrow">Personal Library</p>
        <h1>My Series</h1>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Track status, priority, episodes, and progress for your series list.</MudText>
    </div>
    <MudButton OnClick="SwitchView" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@ViewIcon">@ToggleText</MudButton>
</div>

<AdvancedSearch Model="_filter" OnConditionChanged="ReloadData" ShowPersonalFilters="true" UseMediaStatus="true" />

@if (IsGrid)
{
    <LuminaGrid T="MySeries" GetData="@(GetData)" Loading="@loading" @bind-SelectedItems="selectedItems" @ref="_table" SortMode="SortMode.Single">
        <ToolBarContent>
            <TableActions TItem="MySeries" Page="this" loading="loading" selectedItems="selectedItems" />
        </ToolBarContent>
        <Columns>
            <SelectColumn ShowInFooter="false"></SelectColumn>
            <TemplateColumn CellStyle="width:72px" Title="" Sortable="false">
                <CellTemplate><div class="table-cover" style="background-image: url('@Cover(context.Item)');"></div></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Series" SortBy="@((MySeries x) => x.Series == null ? "" : x.Series.Name)" Sortable="true">
                <CellTemplate>
                    <div class="title-cell">
                        <MudText Typo="Typo.body1">@context.Item.Series?.Name</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Summary(context.Item)</MudText>
                        <div class="chip-row">
                            @foreach (var genre in context.Item.Series?.Genres?.Take(3) ?? [])
                            {
                                <span class="soft-chip">@genre</span>
                            }
                        </div>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status" SortBy="@((MySeries x) => x.Status)" Sortable="true">
                <CellTemplate>
                    <div class="status-stack">
                        <span class="status-pill @StatusClass(context.Item.Status)">@context.Item.Status</span>
                        <span class="muted-line">Priority @context.Item.Priority - @Rating(context.Item)</span>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Progress" SortBy="@((MySeries x) => x.CurrentEpisode)" Sortable="true">
                <CellTemplate>
                    <div class="time-stack">
                        <strong>@EpisodeProgress(context.Item)</strong>
                        <span>@WatchProgress(context.Item)</span>
                        <span>@EpisodeEstimate(context.Item)</span>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Dates" SortBy="@((MySeries x) => x.StartDate)" Sortable="true">
                <CellTemplate>
                    <div class="detail-stack">
                        <span><MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" /> @DateText(context.Item.StartDate)</span>
                        <span><MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Small" /> @DateText(context.Item.EndDate)</span>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn CellStyle="width:76px" Title="Actions" Sortable="false">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Variant="Variant.Filled" DropShadow="false" Size="Size.Small" Dense="true" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
                        <MudMenuItem OnClick="@(async () => await OnUpdate(context.Item))">Edit</MudMenuItem>
                        <MudMenuItem OnClick="@(async () => await Delete(context.Item))">Delete</MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText>No series found</MudText></NoRecordsContent>
        <LoadingContent><MudText>Loading series</MudText></LoadingContent>
        <PagerContent><MudDataGridPager /></PagerContent>
    </LuminaGrid>
}
else
{
    <div class="card-toolbar"><TableActions Page="this" loading="loading" selectedItems="selectedItems" /></div>
    <div class="media-card-grid">
        @foreach (var series in SeriesItems)
        {
            <article class="media-card">
                <div class="card-cover" style="background-image: url('@Cover(series)');">
                    <span class="status-pill overlay @StatusClass(series.Status)">@series.Status</span>
                </div>
                <div class="media-card-body">
                    <div>
                        <h2>@series.Series?.Name</h2>
                        <p>@Summary(series)</p>
                    </div>
                    <div class="chip-row">
                        @foreach (var genre in series.Series?.Genres?.Take(3) ?? [])
                        {
                            <span class="soft-chip">@genre</span>
                        }
                    </div>
                    <div class="time-panel">
                        <div><span>Episode</span><strong>@EpisodeProgress(series)</strong></div>
                        <div><span>Watched</span><strong>@WatchProgress(series)</strong></div>
                        <div><span>Per episode</span><strong>@EpisodeEstimate(series)</strong></div>
                    </div>
                    <div class="card-metrics">
                        <span><MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" /> @Rating(series)</span>
                        <span><MudIcon Icon="@Icons.Material.Filled.LowPriority" Size="Size.Small" /> Priority @series.Priority</span>
                        <span><MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" /> @DateRange(series)</span>
                    </div>
                </div>
                <div class="media-card-actions">
                    <MudButton OnClick="@(() => OnUpdate(series))" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
                    <MudButton OnClick="@(async () => await Delete(series))" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
                </div>
            </article>
        }
    </div>
}

@code {
    private readonly string _placeholderCover = "/Images/Placeholder.png";
    private List<MySeries> SeriesItems = new();
    private List<LuminaPath.Core.Models.Series> DropdownSeries = new();
    private MudDataGrid<MySeries> _table = default!;
    protected override string EntityLabel => "My Series";
    private string ViewIcon => IsGrid ? Icons.Material.Filled.ViewModule : Icons.Material.Filled.TableRows;

    protected override async Task OnInitializedAsync()
    {
        DropdownSeries = await SeriesService.GetDropdownSeries();
        await base.OnInitializedAsync();
    }

    public override async Task ReloadData()
    {
        if (IsGrid)
        {
            await _table.ReloadServerData();
        }
        else
        {
            SeriesItems = await GetData();
            StateHasChanged();
        }
    }

    private async Task SwitchView()
    {
        IsGrid = !IsGrid;
        await ReloadData();
    }

    private async Task<List<MySeries>> GetData()
    {
        if (string.IsNullOrWhiteSpace(UserId))
        {
            return [];
        }

        var result = await ModelService.GetMyMedia(UserId);
        result = ApplyFilters(result).ToList();
        SeriesItems = result;
        return result;
    }

    private IEnumerable<MySeries> ApplyFilters(IEnumerable<MySeries> series)
    {
        if (!string.IsNullOrWhiteSpace(_filter.SearchString))
        {
            var search = _filter.SearchString.Trim();
            series = series.Where(mySeries =>
                Contains(mySeries.Series?.Name, search) ||
                Contains(mySeries.Series?.Description, search) ||
                Contains(mySeries.Series?.Source, search) ||
                mySeries.Series?.Genres.Any(genre => Contains(genre, search)) == true ||
                mySeries.Status.ToString().Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (_filter.From is not null)
        {
            series = series.Where(mySeries => mySeries.Series?.ReleaseDate >= _filter.From);
        }

        if (_filter.To is not null)
        {
            series = series.Where(mySeries => mySeries.Series?.ReleaseDate <= _filter.To);
        }

        if (_filter.MediaStatus is not null)
        {
            series = series.Where(mySeries => mySeries.Status == _filter.MediaStatus);
        }

        if (!string.IsNullOrWhiteSpace(_filter.Genre))
        {
            var genreFilter = _filter.Genre.Trim();
            series = series.Where(mySeries => mySeries.Series?.Genres.Any(genre => Contains(genre, genreFilter)) == true);
        }

        if (!string.IsNullOrWhiteSpace(_filter.Source))
        {
            var sourceFilter = _filter.Source.Trim();
            series = series.Where(mySeries => Contains(mySeries.Series?.Source, sourceFilter));
        }

        if (_filter.Priority is not null)
        {
            series = series.Where(mySeries => mySeries.Priority == _filter.Priority);
        }

        if (_filter.MinRating is not null)
        {
            series = series.Where(mySeries => mySeries.Rating >= _filter.MinRating);
        }

        return series;
    }

    public override async Task<MySeries> GetById(int id) => await ModelService.GetById(id, User?.Id ?? throw new InvalidOperationException("User not loaded."), ModelService.Includes);
    public override async Task Save(MySeries entity) => await ModelService.PostAsync(entity, User);
    public override async Task Update(MySeries entity) => await ModelService.PutAsync(entity, User);
    public override async Task DeleteMedia(MySeries entity) => await ModelService.DeleteAsync(entity.Id, User);

    private string Cover(MySeries? mySeries)
    {
        return string.IsNullOrWhiteSpace(mySeries?.Series?.Image?.Url)
            ? _placeholderCover
            : NormalizeUrl(mySeries.Series.Image.Url);
    }

    private static string NormalizeUrl(string url) => url.StartsWith("http", StringComparison.OrdinalIgnoreCase) || url.StartsWith("/") ? url : $"/{url}";

    private static string Summary(MySeries mySeries)
    {
        var series = mySeries.Series;
        if (series is null)
        {
            return "No series details";
        }

        if (string.IsNullOrWhiteSpace(series.Description))
        {
            return series.Genres.Count > 0 ? string.Join(" / ", series.Genres.Take(3)) : "No description yet";
        }

        return series.Description.Length > 110 ? $"{series.Description[..110]}..." : series.Description;
    }

    private static string Rating(MySeries mySeries) => mySeries.Rating is null ? "Unrated" : $"{mySeries.Rating}/10";
    private static string DateText(DateTime? date) => date?.ToString("dd.MM.yyyy") ?? "No date";
    private static string DateRange(MySeries mySeries) => mySeries.StartDate is null && mySeries.EndDate is null ? "No dates" : $"{DateText(mySeries.StartDate)} - {DateText(mySeries.EndDate)}";

    private static string EpisodeProgress(MySeries mySeries)
    {
        var current = mySeries.CurrentEpisode?.ToString() ?? "0";
        var total = mySeries.Series?.EpisodeCount?.ToString() ?? "?";
        return $"{current}/{total}";
    }

    private static string WatchProgress(MySeries mySeries)
    {
        var current = CalculatedWatchTimeMinutes(mySeries);
        var total = mySeries.Series?.ExpectedWatchTimeMinutes;
        return current is null && total is null ? "No watch time" : $"{FormatMinutes(current ?? 0)} / {(total is null ? "?" : FormatMinutes(total.Value))}";
    }

    private static string EpisodeEstimate(MySeries mySeries)
    {
        return mySeries.Series?.ExpectedWatchTimePerEpisodeMinutes is null
            ? "No estimate"
            : FormatMinutes(mySeries.Series.ExpectedWatchTimePerEpisodeMinutes.Value);
    }

    private static int? CalculatedWatchTimeMinutes(MySeries mySeries)
    {
        if (mySeries.CurrentEpisode is null || mySeries.Series?.ExpectedWatchTimePerEpisodeMinutes is null)
        {
            return mySeries.CurrentWatchTimeMinutes;
        }

        return Math.Max(0, mySeries.CurrentEpisode.Value) * mySeries.Series.ExpectedWatchTimePerEpisodeMinutes.Value;
    }

    private static string FormatMinutes(int minutes)
    {
        if (minutes < 60)
        {
            return $"{minutes}m";
        }

        var hours = minutes / 60;
        var remaining = minutes % 60;
        return remaining == 0 ? $"{hours}h" : $"{hours}h {remaining}m";
    }

    private static string StatusClass(MediaStatus status)
    {
        return status switch
        {
            MediaStatus.Watching => "status-playing",
            MediaStatus.Completed => "status-complete",
            MediaStatus.Planned => "status-planned",
            MediaStatus.OnHold => "status-main",
            _ => "status-default"
        };
    }

    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    protected override DialogParameters<MySeriesFormDialog> CreateDialogParameters(MySeries command, Func<MySeries, Task> OnSubmit)
    {
        return new DialogParameters<MySeriesFormDialog>
            {
                { x => x.Refresh, new Action(async () => await ReloadData()) },
                { x => x.Model, command },
                { x => x.SeriesSelect, DropdownSeries },
                { x => x.loading, loading },
                { x => x.EventCallBack, OnSubmit }
            };
    }
}

<style>
    .media-page-header { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
    .media-page-header h1 { margin: 0; letter-spacing: 0; }
    .eyebrow { margin: 0 0 4px; color: var(--mud-palette-primary); font-size: .76rem; font-weight: 800; letter-spacing: 0; text-transform: uppercase; }
    .table-cover { width: 52px; height: 64px; border-radius: 6px; background-color: #263346; background-position: center; background-size: cover; box-shadow: 0 8px 22px rgba(0, 0, 0, .18); }
    .title-cell, .status-stack, .time-stack, .detail-stack { display: grid; gap: 4px; }
    .title-cell { min-width: 240px; }
    .chip-row { display: flex; flex-wrap: wrap; gap: 6px; }
    .soft-chip, .status-pill { display: inline-flex; align-items: center; width: fit-content; min-height: 24px; padding: 3px 9px; border-radius: 999px; background: rgba(118, 228, 196, .12); color: var(--mud-palette-text-primary); font-size: .78rem; font-weight: 700; }
    .status-playing { background: rgba(94, 220, 143, .18); }
    .status-main { background: rgba(244, 201, 93, .2); }
    .status-complete { background: rgba(117, 167, 255, .18); }
    .status-planned { background: rgba(188, 154, 255, .18); }
    .status-default { background: rgba(255, 255, 255, .1); }
    .status-pill.overlay { position: absolute; top: 10px; right: 10px; background-color: rgba(9, 15, 26, .84); color: #fff; }
    .muted-line, .time-stack span, .detail-stack, .card-metrics { color: var(--mud-palette-text-secondary); font-size: .88rem; }
    .time-stack strong { color: var(--mud-palette-text-primary); }
    .detail-stack span, .card-metrics span { display: inline-flex; align-items: center; gap: 6px; }
    .card-toolbar { margin: 8px 0 14px; padding: 10px 0; }
    .media-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
    .media-card { display: grid; grid-template-rows: 190px 1fr auto; min-height: 470px; border: 1px solid rgba(255, 255, 255, .08); border-radius: 8px; background: var(--mud-palette-surface); overflow: hidden; box-shadow: 0 14px 34px rgba(0, 0, 0, .14); }
    .card-cover { position: relative; background-color: #263346; background-position: center; background-size: cover; }
    .media-card-body { display: flex; flex-direction: column; gap: 12px; padding: 16px; }
    .media-card h2 { margin: 0; font-size: 1.15rem; line-height: 1.2; letter-spacing: 0; }
    .media-card p { margin: 6px 0 0; color: var(--mud-palette-text-secondary); line-height: 1.45; }
    .time-panel { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .time-panel div { display: grid; gap: 2px; padding: 10px; border-radius: 8px; background: rgba(118, 228, 196, .08); }
    .time-panel span { color: var(--mud-palette-text-secondary); font-size: .74rem; font-weight: 700; }
    .time-panel strong { font-size: 1.05rem; }
    .card-metrics { display: grid; gap: 6px; margin-top: auto; }
    .media-card-actions { display: flex; justify-content: space-between; padding: 8px 10px 10px; border-top: 1px solid rgba(255, 255, 255, .08); }
    @@media (max-width: 720px) { .media-page-header { align-items: stretch; flex-direction: column; } }
</style>
