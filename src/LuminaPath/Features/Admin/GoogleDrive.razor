@page "/Admin/GoogleDrive"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@using LuminaPath.Infrastructure.Services.Storage
@attribute [Authorize(Roles = "Administrator")]
@attribute [ExcludeFromInteractiveRouting]
@inject IOptions<GoogleDriveOptions> DriveOptions
@inject IOptions<StorageOptions> StorageOptions
@inject GoogleDriveConnectionStore ConnectionStore

<PageTitle>Google Drive storage</PageTitle>

<MudPaper Class="pa-6" Outlined="true">
    <MudText Typo="Typo.overline">Admin console</MudText>
    <MudText Typo="Typo.h4" Class="mb-4">Google Drive storage</MudText>
    <MudText Class="mb-4">
        Connect the Google account that will store this installation's uploads and backup copies.
        Files stay private and are served through LuminaPath. This connection is shared by the whole app.
    </MudText>

    @if (Result == "connected" && connected)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">Google Drive authorization saved.</MudAlert>
    }
    @if (Result == "error" || unreadable)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            Could not connect Google Drive. Check the OAuth client and callback URL, allow Drive access,
            and use the same Google account when reconnecting. If the saved connection cannot be read,
            restore its original connection volume and encryption keys.
        </MudAlert>
    }

    <MudText Class="mb-2"><strong>Storage provider:</strong> @StorageOptions.Value.Provider</MudText>
    <MudText Class="mb-4"><strong>Authorization:</strong> @(external ? "Configured by server secret" : connected ? "Saved" : "Not connected")</MudText>

    @if (!DriveOptions.Value.CanConnectInBrowser)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Configure a Google OAuth Web application client ID, client secret and callback URL on the server,
            then restart the API. See the Google Drive storage setup in the README.
        </MudAlert>
    }
    @if (!string.IsNullOrWhiteSpace(DriveOptions.Value.RedirectUri))
    {
        <MudText Class="mb-4">Register this exact authorized redirect URI in Google Cloud:<br />
            <code>@DriveOptions.Value.RedirectUri</code>
        </MudText>
    }
    @if (external)
    {
        <MudAlert Severity="Severity.Info">
            The server uses a refresh token from configuration. To use browser authorization instead,
            remove that token setting and restart the API, then connect the same Google account here.
        </MudAlert>
    }
    else if (DriveOptions.Value.CanConnectInBrowser && !unreadable)
    {
        <form method="post" action="/api/integrations/google-drive/connect" data-enhance="false">
            <AntiforgeryToken />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Cloud">
                @(connected ? "Reconnect Google Drive" : "Connect Google Drive")
            </MudButton>
        </form>
    }
    @if (!StorageOptions.Value.UsesGoogleDrive)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            Connecting saves authorization only. Follow the README migration steps before selecting
            GoogleDrive as the storage provider. Existing files are not copied automatically.
        </MudAlert>
    }
</MudPaper>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [SupplyParameterFromQuery(Name = "drive")] public string? Result { get; set; }
    private bool connected;
    private bool external;
    private bool unreadable;

    protected override void OnInitialized()
    {
        if (HttpContext is not null && !HttpContext.Response.HasStarted)
        {
            HttpContext.Response.Headers.CacheControl = "no-store";
            HttpContext.Response.Headers["Referrer-Policy"] = "no-referrer";
        }
        external = DriveOptions.Value.HasExternalToken;
        if (external) return;
        try { connected = ConnectionStore.Read() is not null; }
        catch { unreadable = true; }
    }
}
