@using LuminaPath.Core.Dtos
@using LuminaPath.Infrastructure.Services;
@using LuminaPath.Infrastructure.Services.ModelServices
@inherits MudComponentBase
@inject ISnackbar Snackbar


<MudForm Model="@Model" @ref="@_form">
    <InputFile id="UploadPhoto" OnChange="UploadPhoto" hidden accept=".jpg, .jpeg, .png"/>
    <MudGrid>
        <MudItem sm="12">
            <div class="d-flex justify-center">

                @if (string.IsNullOrEmpty(""))
                {
                    <MudAvatar Style="height:128px; width:128px; font-size:2rem;">@Model.UserName.ToUpper().FirstOrDefault()</MudAvatar>
                }
                else
                {
                    <MudAvatar Style="height:128px; width:128px; font-size:2rem;">
                        <MudImage Src="url"></MudImage>
                    </MudAvatar>
                }
                <MudTooltip Text="Click upload a photo.">
                    <MudIconButton HtmlTag="label"
                                   Color="Color.Info"
                                   Icon="@Icons.Material.Filled.PhotoCamera"
                                   for="UploadPhoto">
                    </MudIconButton>
                </MudTooltip>
            </div>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField For="@(() => Model.UserName)"
                          @bind-Value="Model.UserName"
                          Label="Display name"
                          Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField For="@(() => Model.Email)"
                          @bind-Value="Model.Email"
                          Label="Email"
                          InputType="InputType.Email"
                          Variant="Variant.Outlined" />
        </MudItem>
        @if (string.IsNullOrEmpty(Model.Id))
        {
            <MudItem xs="12" sm="6">
                <MudTextField Label="Password"
                              @bind-Value="Model.Password"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="Password is required."
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Label="Confirm password"
                              @bind-Value="passwordConfirmed"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="Confirm the password."
                              Variant="Variant.Outlined" />
            </MudItem>
        }
        <MudItem xs="12" sm="6">
            <MudSelect T="string" @bind-Value="Model.Role" Label="Role" Variant="Variant.Outlined" Clearable="true">
                @foreach (var role in LuminaUserService.Roles)
                {
                    <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField For="@(() => Model.PhoneNumber)"
                          @bind-Value="Model.PhoneNumber"
                          Label="Phone number"
                          Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.caption">Status</MudText>
            <div class="d-flex">
                <MudCheckBox For="@(() => Model.Active)" T="bool" @bind-Value="Model.Active" Label="Active" Color="Color.Success" />
            </div>
        </MudItem>
    </MudGrid>
</MudForm>

@code{

    public class CheckItem
    {
        public string Key { get; set; } = string.Empty;
        public bool Value { get; set; }
    }

    [EditorRequired][Parameter] public UserDto Model { get; set; } = default!;

    [EditorRequired][Parameter] public EventCallback<UserDto> OnFormSubmit { get; set; }

    private string passwordConfirmed = "";

    private MudForm? _form = default!;
    private List<CheckItem> Roles { get; set; } = new();

    private async Task UploadPhoto(InputFileChangeEventArgs e)
    {

    }

    public async Task Submit()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid)
            {
                return;
            }

            if (string.IsNullOrEmpty(Model.Id) && Model.Password != passwordConfirmed)
            {
                Snackbar.Add("Passwords do not match.", Severity.Warning);
                return;
            }

            await OnFormSubmit.InvokeAsync(Model);
        }
    }
}
