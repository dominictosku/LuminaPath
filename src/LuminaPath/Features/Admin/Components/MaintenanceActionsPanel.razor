@using LuminaPath.Core.Models
@using LuminaPath.Infrastructure.Services.Application
@using LuminaPath.Infrastructure.Services.Application.BackgroundJobs
@inject BackgroundJobService BackgroundJobService
@inject BackgroundJobMaintenanceService MaintenanceService
@inject OrphanedBlobCleanupService OrphanedBlobCleanupService
@inject LibraryIntegrityDiagnosticsService DiagnosticsService
@inject ISnackbar Snackbar

<section class="settings-panel settings-panel--primary">
	<div class="settings-panel__header">
		<div>
			<MudText Typo="Typo.overline">Maintenance</MudText>
			<MudText Typo="Typo.h5">Manual operations</MudText>
			<MudText Typo="Typo.body2">
				Queue maintenance work without waiting for the scheduler. Jobs run through the normal background-job queue and audit trail.
			</MudText>
		</div>
		<div class="settings-panel__icon">
			<MudIcon Icon="@Icons.Material.Filled.Handyman" />
		</div>
	</div>

	<div class="maintenance-content">
		<section class="maintenance-group">
			<div class="maintenance-group__title">
				<MudIcon Icon="@Icons.Material.Filled.Schedule" />
				<MudText Typo="Typo.h6">Last successful runs</MudText>
			</div>
			<div class="maintenance-status-grid">
				<div class="maintenance-status-card">
					<span>Retention cleanup</span>
					<strong>@FormatJob(lastMaintenanceCleanup)</strong>
				</div>
				<div class="maintenance-status-card">
					<span>Orphaned blobs</span>
					<strong>@FormatJob(lastOrphanedBlobCleanup)</strong>
				</div>
				<div class="maintenance-status-card">
					<span>Database backup</span>
					<strong>@FormatJob(lastDatabaseBackup)</strong>
				</div>
				<div class="maintenance-status-card">
					<span>Game metadata</span>
					<strong>@FormatJob(lastGameMetadataRefresh)</strong>
				</div>
				<div class="maintenance-status-card">
					<span>Anime metadata</span>
					<strong>@FormatJob(lastAnimeMetadataRefresh)</strong>
				</div>
				<div class="maintenance-status-card">
					<span>Movie metadata</span>
					<strong>@FormatJob(lastMovieMetadataRefresh)</strong>
				</div>
				<div class="maintenance-status-card">
					<span>Series metadata</span>
					<strong>@FormatJob(lastSeriesMetadataRefresh)</strong>
				</div>
			</div>
		</section>

		<section class="maintenance-group">
			<div class="maintenance-group__title">
				<MudIcon Icon="@Icons.Material.Filled.FactCheck" />
				<MudText Typo="Typo.h6">Preflight checks</MudText>
			</div>
			<div class="maintenance-preflight-layout">
				<div class="maintenance-preview-grid">
					<div class="maintenance-preview-card">
						<span>Retention preview</span>
						<strong>@RetentionPreviewText</strong>
					</div>
					<div class="maintenance-preview-card">
						<span>Blob preview</span>
						<strong>@BlobPreviewText</strong>
					</div>
					<div class="maintenance-preview-card">
						<span>Integrity issues</span>
						<strong>@DiagnosticsText</strong>
					</div>
				</div>
				<div class="maintenance-action-grid">
					<MudButton Class="maintenance-action-button"
							   OnClick="PreviewMaintenanceCleanup"
							   Variant="MudBlazor.Variant.Outlined"
							   Color="Color.Primary"
							   StartIcon="@Icons.Material.Filled.Preview"
							   Disabled="@previewingMaintenance">
						@(previewingMaintenance ? "Scanning Retention" : "Preview Retention")
					</MudButton>
					<MudButton Class="maintenance-action-button"
							   OnClick="PreviewOrphanedBlobCleanup"
							   Variant="MudBlazor.Variant.Outlined"
							   Color="Color.Primary"
							   StartIcon="@Icons.Material.Filled.Preview"
							   Disabled="@previewingOrphanedBlobCleanup">
						@(previewingOrphanedBlobCleanup ? "Scanning Blobs" : "Preview Blobs")
					</MudButton>
					<MudButton Class="maintenance-action-button"
							   OnClick="RunDiagnostics"
							   Variant="MudBlazor.Variant.Outlined"
							   Color="Color.Primary"
							   StartIcon="@Icons.Material.Filled.FactCheck"
							   Disabled="@runningDiagnostics">
						@(runningDiagnostics ? "Checking Integrity" : "Run Diagnostics")
					</MudButton>
					<MudButton Class="maintenance-action-button"
							   OnClick="LoadStatus"
							   Variant="MudBlazor.Variant.Outlined"
							   Color="Color.Primary"
							   StartIcon="@Icons.Material.Filled.Refresh"
							   Disabled="@(queueingMaintenance || queueingOrphanedBlobCleanup || queueingMetadataRefresh)">
						Refresh Status
					</MudButton>
				</div>
			</div>
		</section>

		<section class="maintenance-group maintenance-group--split">
			<div class="maintenance-operation-group">
				<div class="maintenance-group__title">
					<MudIcon Icon="@Icons.Material.Filled.CleaningServices" />
					<MudText Typo="Typo.h6">Cleanup jobs</MudText>
				</div>
				<div class="maintenance-action-grid maintenance-action-grid--compact">
					<MudButton Class="maintenance-action-button"
							   OnClick="QueueMaintenanceCleanup"
							   Variant="MudBlazor.Variant.Filled"
							   Color="Color.Secondary"
							   StartIcon="@Icons.Material.Filled.CleaningServices"
							   Disabled="@queueingMaintenance">
						@(queueingMaintenance ? "Queueing Cleanup" : "Run Retention Cleanup")
					</MudButton>
					<MudButton Class="maintenance-action-button"
							   OnClick="QueueOrphanedBlobCleanup"
							   Variant="MudBlazor.Variant.Filled"
							   Color="Color.Primary"
							   StartIcon="@Icons.Material.Filled.FolderDelete"
							   Disabled="@queueingOrphanedBlobCleanup">
						@(queueingOrphanedBlobCleanup ? "Queueing Blob Cleanup" : "Run Blob Cleanup")
					</MudButton>
				</div>
			</div>

			<div class="maintenance-operation-group">
				<div class="maintenance-group__title">
					<MudIcon Icon="@Icons.Material.Filled.TravelExplore" />
					<MudText Typo="Typo.h6">Metadata refresh jobs</MudText>
				</div>
				<div class="maintenance-action-grid">
					<MudButton Class="maintenance-action-button"
							   OnClick="@(() => QueueMetadataRefresh(MetadataRefreshMediaTypes.Games))"
							   Variant="MudBlazor.Variant.Filled"
							   Color="Color.Secondary"
							   StartIcon="@Icons.Material.Filled.TravelExplore"
							   Disabled="@queueingMetadataRefresh">
						Refresh Game Metadata
					</MudButton>
					<MudButton Class="maintenance-action-button"
							   OnClick="@(() => QueueMetadataRefresh(MetadataRefreshMediaTypes.Animes))"
							   Variant="MudBlazor.Variant.Outlined"
							   Color="Color.Primary"
							   StartIcon="@Icons.Material.Filled.Animation"
							   Disabled="@queueingMetadataRefresh">
						Refresh Anime Metadata
					</MudButton>
					<MudButton Class="maintenance-action-button"
							   OnClick="@(() => QueueMetadataRefresh(MetadataRefreshMediaTypes.Movies))"
							   Variant="MudBlazor.Variant.Outlined"
							   Color="Color.Primary"
							   StartIcon="@Icons.Material.Filled.Movie"
							   Disabled="@queueingMetadataRefresh">
						Refresh Movie Metadata
					</MudButton>
					<MudButton Class="maintenance-action-button"
							   OnClick="@(() => QueueMetadataRefresh(MetadataRefreshMediaTypes.Series))"
							   Variant="MudBlazor.Variant.Outlined"
							   Color="Color.Primary"
							   StartIcon="@Icons.Material.Filled.LiveTv"
							   Disabled="@queueingMetadataRefresh">
						Refresh Series Metadata
					</MudButton>
				</div>
			</div>
		</section>
	</div>

	@if (blobPreview?.OrphanedBlobNames.Any() == true)
	{
		<MudAlert Severity="Severity.Warning" Variant="MudBlazor.Variant.Outlined" Class="maintenance-alert">
			First orphaned blobs: @string.Join(", ", blobPreview.OrphanedBlobNames.Take(5))
		</MudAlert>
	}
	@if (diagnostics is not null)
	{
		<MudAlert Severity="@(diagnostics.TotalIssues == 0 ? Severity.Success : Severity.Warning)" Variant="MudBlazor.Variant.Outlined" Class="maintenance-alert">
			Duplicate external ID groups: @diagnostics.DuplicateExternalIdGroups.
			Library entries missing media: @diagnostics.LibraryEntriesMissingMedia.
			Documents missing storage name: @diagnostics.DocumentsMissingStorageName.
		</MudAlert>

		@if (diagnostics.DuplicateExternalIds.Any())
		{
			<div class="diagnostics-detail">
				<MudText Typo="Typo.h6">Duplicate external IDs</MudText>
				<MudTable Items="diagnostics.DuplicateExternalIds" Dense="true" Hover="true" Class="maintenance-table">
					<HeaderContent>
						<MudTh>Provider</MudTh>
						<MudTh>External ID</MudTh>
						<MudTh>Rows</MudTh>
						<MudTh>Media</MudTh>
					</HeaderContent>
					<RowTemplate>
						<MudTd>@context.Provider</MudTd>
						<MudTd>@context.ExternalId</MudTd>
						<MudTd>@context.Count</MudTd>
						<MudTd>@FormatDuplicateMedia(context)</MudTd>
					</RowTemplate>
				</MudTable>
			</div>
		}

		@if (diagnostics.BrokenReferences.Any())
		{
			<div class="diagnostics-detail">
				<MudText Typo="Typo.h6">Broken library references</MudText>
				<MudTable Items="diagnostics.BrokenReferences" Dense="true" Hover="true" Class="maintenance-table">
					<HeaderContent>
						<MudTh>Type</MudTh>
						<MudTh>Library ID</MudTh>
						<MudTh>Missing media ID</MudTh>
						<MudTh>User</MudTh>
					</HeaderContent>
					<RowTemplate>
						<MudTd>@context.MediaType</MudTd>
						<MudTd>@context.LibraryEntryId</MudTd>
						<MudTd>@context.MissingMediaId</MudTd>
						<MudTd>@context.UserId</MudTd>
					</RowTemplate>
				</MudTable>
			</div>
		}

		@if (diagnostics.DocumentsMissingStorage.Any())
		{
			<div class="diagnostics-detail">
				<MudText Typo="Typo.h6">Documents missing storage name</MudText>
				<MudTable Items="diagnostics.DocumentsMissingStorage" Dense="true" Hover="true" Class="maintenance-table">
					<HeaderContent>
						<MudTh>Document ID</MudTh>
						<MudTh>Name</MudTh>
						<MudTh>Type</MudTh>
					</HeaderContent>
					<RowTemplate>
						<MudTd>@context.DocumentId</MudTd>
						<MudTd>@context.Name</MudTd>
						<MudTd>@context.DocumentType</MudTd>
					</RowTemplate>
				</MudTable>
			</div>
		}
	}
</section>

<style>
	.maintenance-content {
		display: grid;
		gap: 22px;
		min-width: 0;
	}

	.maintenance-group,
	.maintenance-operation-group {
		display: grid;
		gap: 12px;
		min-width: 0;
	}

	.maintenance-group + .maintenance-group {
		padding-top: 6px;
		border-top: 1px solid rgba(59, 130, 246, .12);
	}

	.maintenance-group__title {
		display: flex;
		align-items: center;
		gap: 10px;
		min-width: 0;
	}

	.maintenance-group__title .mud-icon-root {
		color: var(--mud-palette-primary);
		font-size: 24px;
	}

	.maintenance-group__title .mud-typography-h6 {
		font-weight: 900;
	}

	.maintenance-status-grid,
	.maintenance-preview-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
		gap: 12px;
		min-width: 0;
	}

	.maintenance-status-card,
	.maintenance-preview-card {
		display: grid;
		gap: 6px;
		padding: 14px;
		border: 1px solid rgba(59, 130, 246, .18);
		border-radius: 12px;
		background: rgba(255, 255, 255, .04);
	}

	.maintenance-status-card span,
	.maintenance-preview-card span {
		color: var(--mud-palette-text-secondary);
		font-size: .78rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.maintenance-status-card strong,
	.maintenance-preview-card strong {
		font-size: 1rem;
	}

	.maintenance-preflight-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr);
		gap: 14px;
		align-items: stretch;
	}

	.maintenance-preview-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.maintenance-group--split {
		display: grid;
		grid-template-columns: minmax(280px, .7fr) minmax(420px, 1.3fr);
		gap: 18px;
		align-items: start;
	}

	.maintenance-action-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 10px;
		min-width: 0;
	}

	.maintenance-action-grid--compact {
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
	}

	.maintenance-action-button {
		justify-content: flex-start;
		width: 100%;
		min-height: 48px;
	}

	.maintenance-action-button .mud-button-label {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.maintenance-alert {
		margin-top: 18px;
	}

	.diagnostics-detail {
		display: grid;
		gap: 10px;
		margin-top: 14px;
		min-width: 0;
		overflow-x: auto;
	}

	.maintenance-table {
		overflow: hidden;
		border: 1px solid rgba(59, 130, 246, .14);
		border-radius: 12px;
	}

	.maintenance-table table {
		min-width: 720px;
	}

	@@media (max-width: 1100px) {
		.maintenance-preflight-layout,
		.maintenance-group--split {
			grid-template-columns: 1fr;
		}
	}

	@@media (max-width: 680px) {
		.maintenance-status-grid,
		.maintenance-preview-grid,
		.maintenance-action-grid,
		.maintenance-action-grid--compact {
			grid-template-columns: 1fr;
		}

		.maintenance-action-button {
			justify-content: center;
		}
	}
</style>

@code {
	private BackgroundJobRecord? lastMaintenanceCleanup;
	private BackgroundJobRecord? lastOrphanedBlobCleanup;
	private BackgroundJobRecord? lastDatabaseBackup;
	private BackgroundJobRecord? lastGameMetadataRefresh;
	private BackgroundJobRecord? lastAnimeMetadataRefresh;
	private BackgroundJobRecord? lastMovieMetadataRefresh;
	private BackgroundJobRecord? lastSeriesMetadataRefresh;
	private BackgroundMaintenancePreviewResult? maintenancePreview;
	private OrphanedBlobCleanupPreviewResult? blobPreview;
	private LibraryIntegrityDiagnosticsResult? diagnostics;
	private bool queueingMaintenance;
	private bool queueingOrphanedBlobCleanup;
	private bool queueingMetadataRefresh;
	private bool previewingMaintenance;
	private bool previewingOrphanedBlobCleanup;
	private bool runningDiagnostics;

	private string RetentionPreviewText => maintenancePreview is null
		? "Not scanned"
		: $"{maintenancePreview.OldJobRecords} jobs, {maintenancePreview.OldBackupFiles} backups";
	private string BlobPreviewText => blobPreview is null
		? "Not scanned"
		: $"{blobPreview.WouldDelete} orphan(s) of {blobPreview.Inspected} scanned";
	private string DiagnosticsText => diagnostics is null
		? "Not checked"
		: diagnostics.TotalIssues == 0 ? "Clean" : diagnostics.TotalIssues.ToString();

	protected override async Task OnInitializedAsync()
	{
		await LoadStatus();
	}

	private async Task LoadStatus()
	{
		lastMaintenanceCleanup = await BackgroundJobService.GetLastSuccessfulJobAsync(BackgroundJobTypes.MaintenanceCleanup);
		lastOrphanedBlobCleanup = await BackgroundJobService.GetLastSuccessfulJobAsync(BackgroundJobTypes.OrphanedBlobCleanup);
		lastDatabaseBackup = await BackgroundJobService.GetLastSuccessfulJobAsync(BackgroundJobTypes.DatabaseBackup);
		lastGameMetadataRefresh = await BackgroundJobService.GetLastSuccessfulJobAsync(BackgroundJobTypes.MetadataRefreshGames);
		lastAnimeMetadataRefresh = await BackgroundJobService.GetLastSuccessfulJobAsync(BackgroundJobTypes.MetadataRefreshAnimes);
		lastMovieMetadataRefresh = await BackgroundJobService.GetLastSuccessfulJobAsync(BackgroundJobTypes.MetadataRefreshMovies);
		lastSeriesMetadataRefresh = await BackgroundJobService.GetLastSuccessfulJobAsync(BackgroundJobTypes.MetadataRefreshSeries);
	}

	private async Task PreviewMaintenanceCleanup()
	{
		previewingMaintenance = true;
		try
		{
			maintenancePreview = await MaintenanceService.PreviewCleanupAsync();
			Snackbar.Add("Retention cleanup preview updated", Severity.Info);
		}
		finally
		{
			previewingMaintenance = false;
		}
	}

	private async Task PreviewOrphanedBlobCleanup()
	{
		previewingOrphanedBlobCleanup = true;
		try
		{
			blobPreview = await OrphanedBlobCleanupService.PreviewAsync();
			Snackbar.Add("Orphaned blob preview updated", Severity.Info);
		}
		finally
		{
			previewingOrphanedBlobCleanup = false;
		}
	}

	private async Task RunDiagnostics()
	{
		runningDiagnostics = true;
		try
		{
			diagnostics = await DiagnosticsService.RunAsync();
			Snackbar.Add(diagnostics.TotalIssues == 0
				? "Integrity diagnostics found no issues"
				: $"Integrity diagnostics found {diagnostics.TotalIssues} issue(s)",
				diagnostics.TotalIssues == 0 ? Severity.Success : Severity.Warning);
		}
		finally
		{
			runningDiagnostics = false;
		}
	}

	private async Task QueueMaintenanceCleanup()
	{
		queueingMaintenance = true;
		try
		{
			var job = await BackgroundJobService.EnqueueMaintenanceCleanupAsync();
			Snackbar.Add($"Queued maintenance cleanup job #{job.Id}", Severity.Success);
			await LoadStatus();
		}
		finally
		{
			queueingMaintenance = false;
		}
	}

	private async Task QueueOrphanedBlobCleanup()
	{
		queueingOrphanedBlobCleanup = true;
		try
		{
			var job = await BackgroundJobService.EnqueueOrphanedBlobCleanupAsync();
			Snackbar.Add($"Queued orphaned blob cleanup job #{job.Id}", Severity.Success);
			await LoadStatus();
		}
		finally
		{
			queueingOrphanedBlobCleanup = false;
		}
	}

	private async Task QueueMetadataRefresh(string mediaType)
	{
		queueingMetadataRefresh = true;
		try
		{
			var job = await BackgroundJobService.EnqueueMetadataRefreshAsync(mediaType);
			Snackbar.Add($"Queued {mediaType} metadata refresh job #{job.Id}", Severity.Success);
			await LoadStatus();
		}
		finally
		{
			queueingMetadataRefresh = false;
		}
	}

	private static string FormatDuplicateMedia(DuplicateExternalIdDiagnostic diagnostic)
	{
		return string.Join("; ", diagnostic.Media.Select(item =>
			$"{item.MediaType} #{item.MediaId} {item.MediaName} (external row #{item.ExternalIdRowId})"));
	}

	private static string FormatJob(BackgroundJobRecord? job)
	{
		return job is null
			? "Never"
			: (job.CompletedAt ?? job.CreatedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm");
	}
}
