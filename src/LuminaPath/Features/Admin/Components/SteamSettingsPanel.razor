@using LuminaPath.Infrastructure.Services
@using LuminaPath.Infrastructure.Services.Application
@inject ApplicationSettingsService ApplicationSettingsService
@inject IntegrationConnectionTestService ConnectionTestService
@inject ISnackbar Snackbar

<section class="settings-panel settings-panel--steam">
	<div class="settings-panel__header">
		<div>
			<MudText Typo="Typo.overline">Steam</MudText>
			<MudText Typo="Typo.h5">Saved Steam API key</MudText>
			<MudText Typo="Typo.body2">
				This key is used by the Steam import page to resolve profiles and import public Steam libraries.
			</MudText>
		</div>
		<div class="settings-panel__icon settings-panel__icon--steam">
			<MudIcon Icon="@Icons.Material.Filled.DesktopWindows" />
		</div>
	</div>

	<div class="settings-form">
		<MudTextField @bind-Value="steamApiKey"
					  Label="Steam API key"
					  Variant="MudBlazor.Variant.Outlined"
					  InputType="@steamApiKeyInputType"
					  Adornment="Adornment.End"
					  AdornmentIcon="@SteamApiKeyVisibilityIcon"
					  OnAdornmentClick="ToggleSteamApiKeyVisibility"
					  HelperText="@SteamApiKeyHelperText"
					  Immediate="true" />

		<div class="settings-action-row">
			<MudButton OnClick="SaveSteamApiKey"
					   Variant="MudBlazor.Variant.Filled"
					   Color="Color.Secondary"
					   StartIcon="@Icons.Material.Filled.Save"
					   Disabled="@(steamSaving || testingConnection || string.IsNullOrWhiteSpace(steamApiKey))">
				Save Key
			</MudButton>
			<MudButton OnClick="TestSteamConnection"
					   Variant="MudBlazor.Variant.Outlined"
					   Color="Color.Primary"
					   StartIcon="@Icons.Material.Filled.Link"
					   Disabled="@(steamSaving || testingConnection || string.IsNullOrWhiteSpace(steamApiKey))">
				@(testingConnection ? "Testing Connection" : "Test Connection")
			</MudButton>
		</div>

		@if (connectionResult is not null)
		{
			<MudAlert Severity="@(connectionResult.Succeeded ? Severity.Success : Severity.Error)" Variant="MudBlazor.Variant.Outlined">
				@connectionResult.Message
				@if (!string.IsNullOrWhiteSpace(connectionResult.Details))
				{
					<MudText Typo="Typo.body2">@connectionResult.Details</MudText>
				}
			</MudAlert>
		}
	</div>
</section>

@code {
	private string steamApiKey = string.Empty;
	private bool showSteamApiKey;
	private bool steamKeySaved;
	private bool steamSaving;
	private bool testingConnection;
	private IntegrationConnectionTestResult? connectionResult;

	private InputType steamApiKeyInputType => showSteamApiKey ? InputType.Text : InputType.Password;
	private string SteamApiKeyVisibilityIcon => showSteamApiKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;
	private string SteamApiKeyHelperText => steamKeySaved
		? "A Steam key is loaded from the database. Keep it private."
		: "No Steam API key is currently saved.";

	protected override async Task OnInitializedAsync()
	{
		steamApiKey = await ApplicationSettingsService.GetSteamApiKeyAsync();
		steamKeySaved = !string.IsNullOrWhiteSpace(steamApiKey);
	}

	private async Task SaveSteamApiKey()
	{
		if (string.IsNullOrWhiteSpace(steamApiKey))
		{
			Snackbar.Add("No Steam API key to save", Severity.Info);
			return;
		}

		steamSaving = true;
		try
		{
			await ApplicationSettingsService.SaveSteamApiKeyAsync(steamApiKey);
			steamKeySaved = true;
			Snackbar.Add("Saved Steam API key", Severity.Success);
		}
		finally
		{
			steamSaving = false;
		}
	}

	private async Task TestSteamConnection()
	{
		testingConnection = true;
		connectionResult = null;
		try
		{
			connectionResult = await ConnectionTestService.TestSteamAsync(steamApiKey);
			Snackbar.Add(connectionResult.Message, connectionResult.Succeeded ? Severity.Success : Severity.Error);
		}
		finally
		{
			testingConnection = false;
		}
	}

	private void ToggleSteamApiKeyVisibility()
	{
		showSteamApiKey = !showSteamApiKey;
	}
}
