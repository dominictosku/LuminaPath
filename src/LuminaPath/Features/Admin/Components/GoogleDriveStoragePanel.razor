@using Microsoft.Extensions.Options
@using LuminaPath.Infrastructure.Services.Storage
@inject IOptions<GoogleDriveOptions> DriveOptions
@inject IOptions<StorageOptions> StorageOptions
@inject GoogleDriveConnectionStore ConnectionStore

<section class="settings-panel settings-panel--primary">
	<div class="settings-panel__header">
		<div>
			<MudText Typo="Typo.overline">Cloud storage</MudText>
			<MudText Typo="Typo.h5">Google Drive integration</MudText>
			<MudText Typo="Typo.body2">
				Connect the Google account that will store this installation's uploads and backup copies.
			</MudText>
		</div>
		<div class="settings-panel__icon settings-panel__icon--blue">
			<MudIcon Icon="@Icons.Material.Filled.Cloud" />
		</div>
	</div>

	<div class="settings-form">
		<div class="storage-summary mb-4">
			<div>
				<span>Storage provider</span>
				<strong>@StorageOptions.Value.Provider</strong>
			</div>
			<div>
				<span>Authorization</span>
				<strong>@(external ? "Server Secret" : connected ? "Connected" : "Not Connected")</strong>
			</div>
		</div>

		@if (Result == "connected" && connected)
		{
			<MudAlert Severity="Severity.Success" Class="mb-4">Google Drive authorization saved.</MudAlert>
		}
		@if (Result == "error" || unreadable)
		{
			<MudAlert Severity="Severity.Error" Class="mb-4">
				Could not connect Google Drive. Check the OAuth client and callback URL, allow Drive access,
				and use the same Google account when reconnecting. If the saved connection cannot be read,
				restore its original connection volume and encryption keys.
			</MudAlert>
		}

		@if (!DriveOptions.Value.CanConnectInBrowser)
		{
			<MudAlert Severity="Severity.Info" Class="mb-4">
				Configure a Google OAuth Web application client ID, client secret and callback URL on the server,
				then restart the API. See the Google Drive storage setup in the README.
			</MudAlert>
		}

		@if (!string.IsNullOrWhiteSpace(DriveOptions.Value.RedirectUri))
		{
			<div class="redirect-uri-box mb-4">
				<MudText Typo="Typo.caption" Class="d-block mb-1">Authorized redirect URI for Google Cloud:</MudText>
				<code>@DriveOptions.Value.RedirectUri</code>
			</div>
		}

		@if (external)
		{
			<MudAlert Severity="Severity.Info">
				The server uses a refresh token from configuration. To use browser authorization instead,
				remove that token setting and restart the API, then connect the same Google account here.
			</MudAlert>
		}
		else if (DriveOptions.Value.CanConnectInBrowser && !unreadable)
		{
			<form method="post" action="/api/integrations/google-drive/connect" data-enhance="false">
				<AntiforgeryToken />
				<MudButton ButtonType="ButtonType.Submit"
						   Variant="MudBlazor.Variant.Filled"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Cloud">
					@(connected ? "Reconnect Google Drive" : "Connect Google Drive")
				</MudButton>
			</form>
		}
	</div>
</section>

<section class="settings-panel settings-help-panel">
	<MudIcon Icon="@Icons.Material.Filled.Info" />
	<div>
		<MudText Typo="Typo.h6">Storage notes</MudText>
		<MudText Typo="Typo.body2" Class="mb-3">
			Files stay private and are served through LuminaPath. This connection is shared by the whole app for uploads and snapshots.
		</MudText>
		@if (!StorageOptions.Value.UsesGoogleDrive)
		{
			<MudText Typo="Typo.body2">
				Connecting saves authorization only. Follow the README migration steps before selecting GoogleDrive as the storage provider. Existing files are not copied automatically.
			</MudText>
		}
	</div>
</section>

<style>
	.storage-summary {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 12px;
	}

	.storage-summary > div {
		display: grid;
		gap: 6px;
		padding: 14px;
		border: 1px solid var(--line, #252c2d);
		border-radius: 12px;
		background: rgba(255, 255, 255, .04);
	}

	.storage-summary span {
		color: var(--mud-palette-text-secondary);
		font-size: .78rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.storage-summary strong {
		font-size: 1.1rem;
	}

	.redirect-uri-box {
		padding: 12px;
		border: 1px solid var(--line, #252c2d);
		border-radius: 8px;
		background: rgba(0, 0, 0, .2);
	}

	.redirect-uri-box code {
		color: var(--mint, #b2f5cf);
		word-break: break-all;
	}
</style>

@code {
	[Parameter] public string? Result { get; set; }

	private bool connected;
	private bool external;
	private bool unreadable;

	protected override void OnParametersSet()
	{
		external = DriveOptions.Value.HasExternalToken;
		if (external) return;
		try { connected = ConnectionStore.Read() is not null; }
		catch { unreadable = true; }
	}
}
