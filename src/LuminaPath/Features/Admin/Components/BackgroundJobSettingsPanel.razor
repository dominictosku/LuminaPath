@using LuminaPath.Infrastructure.Services
@using LuminaPath.Infrastructure.Services.Application.BackgroundJobs
@using Microsoft.Extensions.Options
@inject ApplicationSettingsService ApplicationSettingsService
@inject BackgroundJobService BackgroundJobService
@inject IOptions<BackgroundJobOptions> Options
@inject ISnackbar Snackbar

<section class="settings-panel settings-panel--jobs-options">
	<div class="settings-panel__header">
		<div>
			<MudText Typo="Typo.overline">Scheduling</MudText>
			<MudText Typo="Typo.h5">Internal job options</MudText>
			<MudText Typo="Typo.body2">
				Master switch for all automatic background jobs &mdash; database backups, orphaned blob cleanup,
				and any future scheduled maintenance. Cleanup of old job history still runs while this is off.
			</MudText>
		</div>
		<div class="settings-panel__icon">
			<MudIcon Icon="@Icons.Material.Filled.EventRepeat" />
		</div>
	</div>

	<div class="settings-form job-settings-form">
		<div class="job-setting-toggle">
			<div class="job-setting-toggle__icon">
				<MudIcon Icon="@Icons.Material.Filled.EventRepeat" />
			</div>
			<MudSwitch @bind-Value="scheduledJobsEnabled"
					   Color="Color.Primary"
					   Label="Enable scheduled background jobs" />
		</div>

		<div class="job-settings-fields">
			<MudNumericField @bind-Value="backupIntervalHours"
							 Label="Backup interval hours"
							 Variant="MudBlazor.Variant.Outlined"
							 Min="1"
							 Max="720" />

			<MudNumericField @bind-Value="backupRetentionCount"
							 Label="Backups to keep"
							 Variant="MudBlazor.Variant.Outlined"
							 Min="1"
							 Max="500" />

			<MudNumericField @bind-Value="jobHistoryRetentionDays"
							 Label="Job history retention days"
							 Variant="MudBlazor.Variant.Outlined"
							 Min="1"
							 Max="3650" />
		</div>

		<div class="settings-action-row">
			<MudButton OnClick="Save"
					   Variant="MudBlazor.Variant.Filled"
					   Color="Color.Secondary"
					   StartIcon="@Icons.Material.Filled.Save"
					   Disabled="@saving">
				Save Job Settings
			</MudButton>
			<MudButton OnClick="RunCleanup"
					   Variant="MudBlazor.Variant.Outlined"
					   Color="Color.Primary"
					   StartIcon="@Icons.Material.Filled.CleaningServices"
					   Disabled="@(saving || cleaning)">
				@(cleaning ? "Queueing Cleanup" : "Run Cleanup Now")
			</MudButton>
		</div>
	</div>
</section>

<style>
	.settings-panel {
		min-width: 0;
		padding: 20px;
		border: 1px solid rgba(59, 130, 246, .18);
		border-radius: 18px;
		background:
			linear-gradient(180deg, rgba(18, 30, 45, .98), rgba(14, 24, 36, .96));
		box-shadow: 0 16px 46px rgba(15, 23, 42, .18);
	}

	.settings-panel__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 18px;
		margin-bottom: 18px;
	}

	.settings-panel__header .mud-typography-overline {
		color: var(--mud-palette-primary);
		font-weight: 900;
	}

	.settings-panel__header .mud-typography-h5 {
		font-weight: 900;
	}

	.settings-panel__header .mud-typography-body2 {
		margin-top: 4px;
		color: var(--mud-palette-text-secondary);
	}

	.settings-panel__icon {
		display: grid;
		flex: 0 0 auto;
		width: 52px;
		height: 52px;
		place-items: center;
		border-radius: 10px;
		color: #fff;
		background: linear-gradient(135deg, #2563eb, #06b6d4);
		box-shadow: 0 16px 36px rgba(37, 99, 235, .28);
	}

	.settings-panel__icon .mud-icon-root {
		font-size: 30px;
	}

	.settings-form,
	.job-settings-form {
		display: grid;
		gap: 16px;
	}

	.job-setting-toggle {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 14px;
		border: 1px solid rgba(59, 130, 246, .16);
		border-radius: 12px;
		background: rgba(255, 255, 255, .04);
	}

	.job-setting-toggle__icon {
		display: grid;
		flex: 0 0 auto;
		width: 38px;
		height: 38px;
		place-items: center;
		border-radius: 10px;
		color: #7dd3fc;
		background: rgba(14, 165, 233, .12);
	}

	.job-settings-fields {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 12px;
	}

	.settings-action-row {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	@@media (max-width: 680px) {
		.settings-panel {
			padding: 16px;
			border-radius: 16px;
		}

		.settings-panel__header,
		.settings-action-row {
			display: grid;
			justify-content: stretch;
		}
	}
</style>

@code {
	private bool scheduledJobsEnabled;
	private int backupIntervalHours;
	private int backupRetentionCount;
	private int jobHistoryRetentionDays;
	private bool saving;
	private bool cleaning;

	protected override async Task OnInitializedAsync()
	{
		var stored = await ApplicationSettingsService.GetBackgroundJobSettingsAsync();
		scheduledJobsEnabled = ParseBool(stored.ScheduledJobsEnabled, Options.Value.ScheduledJobsEnabled);
		backupIntervalHours = ParseInt(stored.BackupIntervalHours, Options.Value.BackupIntervalHours, 1, 720);
		backupRetentionCount = ParseInt(stored.BackupRetentionCount, Options.Value.BackupRetentionCount, 1, 500);
		jobHistoryRetentionDays = ParseInt(stored.JobHistoryRetentionDays, Options.Value.JobHistoryRetentionDays, 1, 3650);
	}

	private async Task Save()
	{
		saving = true;
		try
		{
			await ApplicationSettingsService.SaveBackgroundJobSettingsAsync(new BackgroundJobStoredSettings(
				scheduledJobsEnabled.ToString(),
				Math.Clamp(backupIntervalHours, 1, 720).ToString(),
				Math.Clamp(backupRetentionCount, 1, 500).ToString(),
				Math.Clamp(jobHistoryRetentionDays, 1, 3650).ToString()));
			Snackbar.Add("Saved background job settings", Severity.Success);
		}
		finally
		{
			saving = false;
		}
	}

	private async Task RunCleanup()
	{
		cleaning = true;
		try
		{
			var job = await BackgroundJobService.EnqueueMaintenanceCleanupAsync();
			Snackbar.Add($"Queued cleanup job #{job.Id}", Severity.Success);
		}
		finally
		{
			cleaning = false;
		}
	}

	private static bool ParseBool(string value, bool fallback)
	{
		return bool.TryParse(value, out var parsed) ? parsed : fallback;
	}

	private static int ParseInt(string value, int fallback, int min, int max)
	{
		return int.TryParse(value, out var parsed) ? Math.Clamp(parsed, min, max) : Math.Clamp(fallback, min, max);
	}
}
