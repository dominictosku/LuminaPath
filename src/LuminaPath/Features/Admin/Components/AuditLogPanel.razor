@inject AuditLogService AuditLogService
@inject ISnackbar Snackbar

<section class="settings-panel settings-panel--primary audit-panel">
    <div class="settings-panel__header">
        <div>
            <MudText Typo="Typo.overline">Security trail</MudText>
            <MudText Typo="Typo.h5">Audit log</MudText>
            <MudText Typo="Typo.body2">
                Review account, admin, document, media and system actions.
            </MudText>
        </div>

        <div class="settings-panel__icon settings-panel__icon--purple">
            <MudIcon Icon="@Icons.Material.Filled.ManageSearch" />
        </div>
    </div>

    <div class="settings-form audit-layout">
        <div class="audit-toolbar">
            <div class="audit-summary">
                <div class="audit-summary-card">
                    <span>Total events</span>
                    <strong>@total</strong>
                </div>
                <div class="audit-summary-card audit-summary-card--page">
                    <span>Showing</span>
                    <strong>@logs.Count</strong>
                </div>
                <div class="audit-summary-card audit-summary-card--filters">
                    <span>Filters</span>
                    <strong>@ActiveFilterCount</strong>
                </div>
            </div>

            <MudButton OnClick="Load"
                       Class="audit-refresh-button"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@loading">
                Refresh
            </MudButton>
        </div>

        <MudPaper Class="audit-filters" Elevation="0">
            <div class="audit-filter-grid">
                <MudSelect T="string" @bind-Value="category" Label="Category" Clearable="true" Dense="true" Variant="Variant.Outlined">
                    @foreach (var option in Categories)
                    {
                        <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="action" Label="Action" Clearable="true" Dense="true" Variant="Variant.Outlined">
                    @foreach (var option in Actions)
                    {
                        <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="outcome" Label="Outcome" Clearable="true" Dense="true" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@AuditOutcomes.Success">@AuditOutcomes.Success</MudSelectItem>
                    <MudSelectItem T="string" Value="@AuditOutcomes.Failure">@AuditOutcomes.Failure</MudSelectItem>
                </MudSelect>
                <MudDatePicker @bind-Date="fromDate" Label="From" Variant="Variant.Outlined" />
                <MudDatePicker @bind-Date="toDate" Label="To" Variant="Variant.Outlined" />
                <MudTextField T="string" @bind-Value="search" Label="Search" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </div>

            <div class="settings-action-row audit-filter-actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.FilterAlt"
                           Disabled="@loading"
                           OnClick="ApplyFilters">
                    Apply filters
                </MudButton>
            </div>
        </MudPaper>

        <div class="audit-table-shell">
            <MudTable Items="logs" Dense="true" Hover="true" Loading="loading" Class="audit-table">
                <HeaderContent>
                    <MudTh>Time</MudTh>
                    <MudTh>Event</MudTh>
                    <MudTh>Actor</MudTh>
                    <MudTh>Target</MudTh>
                    <MudTh>Outcome</MudTh>
                    <MudTh>Request</MudTh>
                    <MudTh>Details</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Time">@context.TimestampUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</MudTd>
                    <MudTd DataLabel="Event">
                        <div class="audit-event">
                            <strong>@context.Action</strong>
                            <span>@context.Category</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Actor">
                        <span class="audit-actor">@ActorLabel(context)</span>
                    </MudTd>
                    <MudTd DataLabel="Target">
                        <div class="audit-event">
                            <strong>@(context.TargetName ?? context.TargetId ?? "-")</strong>
                            <span>@context.TargetType</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Outcome">
                        <MudChip T="string" Size="Size.Small" Color="@OutcomeColor(context.Outcome)" Variant="Variant.Filled">@context.Outcome</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Request">
                        <div class="audit-request">
                            <span>@context.HttpMethod @context.RequestPath</span>
                            <small>@context.IpAddress</small>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Details">
                        <div class="audit-details">
                            @if (!string.IsNullOrWhiteSpace(context.ErrorMessage))
                            {
                                <div class="audit-error">@context.ErrorMessage</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(context.ChangesJson))
                            {
                                <details>
                                    <summary>Changes</summary>
                                    <pre>@context.ChangesJson</pre>
                                </details>
                            }
                            @if (!string.IsNullOrWhiteSpace(context.MetadataJson))
                            {
                                <details>
                                    <summary>Metadata</summary>
                                    <pre>@context.MetadataJson</pre>
                                </details>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4">No audit events found.</MudText>
                </NoRecordsContent>
            </MudTable>
        </div>

        <div class="audit-pager">
            <MudText Typo="Typo.body2">@PagerText</MudText>
            <div class="audit-pager__actions">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(page == 0 || loading)" OnClick="PreviousPage">Previous</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(!HasNextPage || loading)" OnClick="NextPage">Next</MudButton>
            </div>
        </div>
    </div>
</section>

<style>
    .settings-panel {
        min-width: 0;
        padding: 20px;
        border: 1px solid rgba(59, 130, 246, .18);
        border-radius: 18px;
        background:
            linear-gradient(180deg, rgba(18, 30, 45, .98), rgba(14, 24, 36, .96));
        box-shadow: 0 16px 46px rgba(15, 23, 42, .18);
    }

    .settings-panel__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 18px;
    }

    .settings-panel__header .mud-typography-overline {
        color: var(--mud-palette-primary);
        font-weight: 900;
    }

    .settings-panel__header .mud-typography-h5 {
        font-weight: 900;
    }

    .settings-panel__header .mud-typography-body2 {
        max-width: 620px;
        margin-top: 4px;
        color: var(--mud-palette-text-secondary);
    }

    .settings-panel__icon {
        display: grid;
        flex: 0 0 auto;
        width: 52px;
        height: 52px;
        place-items: center;
        border-radius: 10px;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        box-shadow: 0 16px 36px rgba(37, 99, 235, .28);
    }

    .settings-panel__icon--purple {
        background: linear-gradient(135deg, #7c3aed, #06b6d4);
        box-shadow: 0 16px 36px rgba(124, 58, 237, .24);
    }

    .settings-panel__icon .mud-icon-root {
        font-size: 30px;
    }

    .settings-form,
    .audit-layout {
        display: grid;
        gap: 16px;
    }

    .audit-toolbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 14px;
        align-items: stretch;
    }

    .audit-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(120px, 1fr));
        gap: 12px;
        min-width: 0;
    }

    .audit-summary-card {
        display: grid;
        gap: 6px;
        min-height: 84px;
        padding: 14px 16px;
        border: 1px solid rgba(59, 130, 246, .18);
        border-radius: 12px;
        background: rgba(255, 255, 255, .04);
    }

    .audit-summary-card--page {
        border-color: rgba(14, 165, 233, .26);
        background: rgba(14, 165, 233, .08);
    }

    .audit-summary-card--filters {
        border-color: rgba(124, 58, 237, .28);
        background: rgba(124, 58, 237, .08);
    }

    .audit-summary-card span,
    .audit-event span,
    .audit-request small {
        color: var(--mud-palette-text-secondary);
        font-size: .78rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .audit-summary-card strong {
        color: var(--mud-palette-text-primary);
        font-size: 1.5rem;
        line-height: 1;
    }

    .audit-refresh-button {
        min-width: 148px;
        height: 100%;
    }

    .audit-filters {
        display: grid;
        gap: 14px;
        padding: 16px;
        border: 1px solid rgba(59, 130, 246, .16);
        border-radius: 12px;
        background: rgba(255, 255, 255, .035);
    }

    .audit-filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        align-items: start;
    }

    .settings-action-row,
    .audit-filter-actions,
    .audit-pager,
    .audit-pager__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .audit-filter-actions,
    .audit-pager {
        align-items: center;
        justify-content: space-between;
    }

    .audit-table-shell {
        width: 100%;
        overflow-x: auto;
        border: 1px solid rgba(59, 130, 246, .14);
        border-radius: 12px;
        background: rgba(15, 23, 42, .18);
    }

    .audit-table table {
        min-width: 1180px;
        table-layout: fixed;
    }

    .audit-table th:nth-child(1),
    .audit-table td:nth-child(1) {
        width: 170px;
    }

    .audit-table th:nth-child(2),
    .audit-table td:nth-child(2),
    .audit-table th:nth-child(3),
    .audit-table td:nth-child(3),
    .audit-table th:nth-child(4),
    .audit-table td:nth-child(4) {
        width: 170px;
    }

    .audit-table th:nth-child(5),
    .audit-table td:nth-child(5) {
        width: 120px;
    }

    .audit-table th:nth-child(6),
    .audit-table td:nth-child(6) {
        width: 220px;
    }

    .audit-event,
    .audit-request,
    .audit-details {
        display: grid;
        gap: 4px;
        min-width: 0;
    }

    .audit-actor,
    .audit-request span {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .audit-request small {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .audit-muted {
        color: var(--mud-palette-text-secondary);
        font-size: .8rem;
    }

    .audit-error {
        color: var(--mud-palette-error);
        max-width: 420px;
    }

    details {
        width: min(100%, 520px);
    }

    summary {
        width: fit-content;
        cursor: pointer;
        color: var(--mud-palette-primary);
        font-size: .82rem;
        font-weight: 800;
    }

    pre {
        max-width: 520px;
        white-space: pre-wrap;
        word-break: break-word;
        margin: 8px 0 0;
        padding: 10px;
        border-radius: 8px;
        background: rgba(0, 0, 0, .18);
    }

    @@media (max-width: 900px) {
        .audit-toolbar {
            grid-template-columns: 1fr;
        }

        .audit-refresh-button {
            width: 100%;
            height: auto;
        }
    }

    @@media (max-width: 680px) {
        .settings-panel {
            padding: 16px;
            border-radius: 16px;
        }

        .settings-panel__header,
        .audit-summary,
        .audit-pager {
            display: grid;
        }

        .audit-summary {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private static readonly string[] Categories =
    [
        AuditCategories.Account,
        AuditCategories.Admin,
        AuditCategories.Document,
        AuditCategories.Media,
        AuditCategories.System
    ];

    private static readonly string[] Actions =
    [
        AuditActions.Login,
        AuditActions.Logout,
        AuditActions.Registration,
        AuditActions.PasswordChanged,
        AuditActions.PasswordSet,
        AuditActions.PasswordReset,
        AuditActions.EmailChangeRequested,
        AuditActions.EmailChanged,
        AuditActions.TwoFactorLogin,
        AuditActions.TwoFactorEnabled,
        AuditActions.TwoFactorDisabled,
        AuditActions.TwoFactorBrowserForgotten,
        AuditActions.AuthenticatorReset,
        AuditActions.RecoveryCodesGenerated,
        AuditActions.UserCreated,
        AuditActions.UserUpdated,
        AuditActions.UserDeleted,
        AuditActions.UserActivated,
        AuditActions.UserLocked,
        AuditActions.RoleChanged,
        AuditActions.ApplicationSettingChanged,
        AuditActions.BackgroundJobQueued,
        AuditActions.BackgroundJobStarted,
        AuditActions.BackgroundJobRetried,
        AuditActions.BackgroundJobCanceled,
        AuditActions.DatabaseBackupCreated,
        AuditActions.DatabaseBackupDownloaded,
        AuditActions.DocumentUploaded,
        AuditActions.DocumentCreated,
        AuditActions.DocumentUpdated,
        AuditActions.DocumentDeleted,
        AuditActions.DocumentDownloaded,
        AuditActions.MediaCreated,
        AuditActions.MediaUpdated,
        AuditActions.MediaDeleted,
        AuditActions.EntityChanged
    ];

    private List<LuminaPath.Core.Models.AuditLog> logs = [];
    private string? category;
    private string? action;
    private string? outcome;
    private string? search;
    private DateTime? fromDate;
    private DateTime? toDate;
    private int page;
    private int total;
    private bool loading;
    private const int PageSize = 50;

    private bool HasNextPage => (page + 1) * PageSize < total;
    private int ActiveFilterCount => new[] { category, action, outcome, search }.Count(value => !string.IsNullOrWhiteSpace(value))
        + (fromDate.HasValue ? 1 : 0)
        + (toDate.HasValue ? 1 : 0);

    private string PagerText => total == 0
        ? "No events"
        : $"{page * PageSize + 1}-{Math.Min((page + 1) * PageSize, total)} of {total}";

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task ApplyFilters()
    {
        page = 0;
        await Load();
    }

    private async Task PreviousPage()
    {
        page = Math.Max(0, page - 1);
        await Load();
    }

    private async Task NextPage()
    {
        if (!HasNextPage)
        {
            return;
        }

        page++;
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        try
        {
            var result = await AuditLogService.SearchAsync(new AuditLogQuery(
                EmptyToNull(category),
                EmptyToNull(action),
                EmptyToNull(outcome),
                EmptyToNull(search),
                ToUtcStart(fromDate),
                ToUtcExclusiveEnd(toDate),
                page,
                PageSize));

            logs = result.Items.ToList();
            total = result.Total;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not load audit log: {ex.Message}", Severity.Error);
            logs = [];
            total = 0;
        }
        finally
        {
            loading = false;
        }
    }

    private static string ActorLabel(LuminaPath.Core.Models.AuditLog log)
    {
        return log.ActorEmail ?? log.ActorUserId ?? "Anonymous";
    }

    private static Color OutcomeColor(string outcome)
    {
        return outcome == AuditOutcomes.Success ? Color.Success : Color.Error;
    }

    private static string? EmptyToNull(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private static DateTime? ToUtcStart(DateTime? value)
    {
        return value?.Date.ToUniversalTime();
    }

    private static DateTime? ToUtcExclusiveEnd(DateTime? value)
    {
        return value?.Date.AddDays(1).ToUniversalTime();
    }
}
