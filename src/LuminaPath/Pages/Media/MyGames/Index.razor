@page "/Media/MyGames"
@using LuminaPath.Components.BaseAuth
@using LuminaPath.Core.Common.Entities
@using LuminaPath.Core.Common.Interfaces
@using AutoMapper
@using LuminaPath.Infrastructure.Services
@using LuminaPath.Pages.Media.Components
@using LuminaPath.Pages.Media.Games.Components
@using LuminaPath.Pages.Media.MyGames.Components
@using LuminaPath.UI.Shared.Interfaces
@using LuminaPath.UI.Shared.Media
@using LuminaPath.ViewModel
@using Microsoft.EntityFrameworkCore
@inherits BaseAuth
@implements ITableActions<MyGame>
@inject GameService gameService
@inject MyGameService myGameService
@inject NavigationManager Navigation
@inject IMapper mapper

<PageTitle>Games</PageTitle>

<h1>Games</h1>
<MudButton OnClick="SwitchView" Variant="Variant.Filled" Color="Color.Primary">@ToggleText</MudButton>
<AdvancedSearch Model="_filter" OnConditionChanged="ReloadData" />
@if (IsGrid)
{
	<MudDataGrid ServerData="@(ServerReload)"
				 FixedHeader="true"
				 FixedFooter="true"
				 Virtualize="true"
				 Height="calc(100vh - 370px)"
				 Loading="@loading"
				 MultiSelection="true"
				 @bind-SelectedItems="selectedItems"
				 @bind-SelectedItem="_currentDto"
				 Hover="true" @ref="_table">
		<ToolBarContent>
			<TableActions TItem="MyGame" Page="this" loading="loading" selectedItems="selectedItems" />
		</ToolBarContent>
		<Columns>
			<SelectColumn ShowInFooter="false"></SelectColumn>
			<TemplateColumn CellStyle="width:60px" Title="Actions" Sortable="false">
				<CellTemplate>
					<MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" DisableElevation="true" Size="Size.Small"
							 Dense="true"
							 EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
						<MudMenuItem OnClick="@(async () => await OnUpdate(context.Item))">Edit</MudMenuItem>

						<MudMenuItem OnClick="@(async () => await Delete(context.Item))">Delete</MudMenuItem>
					</MudMenu>
				</CellTemplate>
			</TemplateColumn>

			<PropertyColumn Property="x => x.Game.Name" Title="Title">
				<CellTemplate>
					<div class="d-flex flex-column">
						<MudText Typo="Typo.body2">@context.Item.Game.Name</MudText>
						<MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Game.Description</MudText>
					</div>
				</CellTemplate>
			</PropertyColumn>
			<PropertyColumn Property="x => x.Game.Genres" Title="Genre" />
			<PropertyColumn Property="x => x.Status" Title="Status" />
		</Columns>
		<NoRecordsContent>
			<MudText>No items found</MudText>
		</NoRecordsContent>
		<LoadingContent>
			<MudText>Loading</MudText>
		</LoadingContent>
		<PagerContent>
			<MudDataGridPager />
		</PagerContent>
	</MudDataGrid>
}
else
{
	<MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="background-color:#121e2d;">
		<MudToolBar class="mud-table-toolbar">
			<TableActions Page="this" loading="loading" selectedItems="selectedItems" />
		</MudToolBar>
		<MudGrid Spacing="2">
			@foreach (var game in Games)
			{
				<MudItem>
					<MudCard Outlined="true">
						<MudCardMedia Image="@game.Game.Image?.Url" Height="200" />
						<MudCardContent Style="height:80px;">
							<MudText Typo="Typo.h5">@game.Game.Name</MudText>
							<MudText Typo="Typo.body2">@game.Game.Description</MudText>
						</MudCardContent>
						<MudCardActions Style="height:50px;">
							<MudButton OnClick="@(() => OnUpdate(game))" Variant="Variant.Text" Color="Color.Primary">Edit</MudButton>
							<MudButton Variant="Variant.Text" Color="Color.Primary">Add To List</MudButton>
						</MudCardActions>
					</MudCard>
				</MudItem>
			}
		</MudGrid>
	</MudContainer>
}

<style>
	@@import url("https://cdn.jsdelivr.net/npm/@@fancyapps/ui@5.0/dist/fancybox/fancybox.css");

	.fancybox__container {
		--fancybox-bg: rgba(24, 24, 27, 0.85);
		z-index: 9999;
	}

	.mud-table-toolbar {
		height: 120px !important;
	}
</style>

@code{
	private List<MyGame> Games = new();
	private MudDataGrid<MyGame> _table = default!;
	private MyGame _currentDto = new();
	private MediaFilter _filter = new();
	private IBrowserFile? currentImage;

	public bool IsGrid = true;
	public bool loading;
	public HashSet<MyGame> selectedItems = new();
	public string ToggleText => IsGrid ? "Grid View" : "Table View";

	private async Task<GridData<MyGame>> ServerReload(GridState<MyGame> state)
	{
		selectedItems = new HashSet<MyGame>();
		loading = true;
		try
		{
			var result = await GetData(state.Page + 1);

			return new GridData<MyGame> { TotalItems = result.Count(), Items = result };
		}
		finally
		{
			loading = false;
		}
	}

	public async Task ReloadData()
	{
		if (IsGrid)
		{
			await _table.ReloadServerData();
		}
		else
		{
			Games = await GetData(1);
			StateHasChanged();
		}
	}

	private async Task SwitchView()
	{
		IsGrid = !IsGrid;
		await ReloadData();
	}

	private async Task<PaginatedList<MyGame>> GetData(int pageIndex)
	{
		_filter.Paging = new Paging(pageIndex, 15);
		var includes = new List<string>() { "Game" };
		return await myGameService.GetAllPaginated(UserId, _filter);
	}

	public void Dummy()
	{

	}

	#region Events
	public async Task OnCreate()
	{
		var dropdownGames = await gameService.GetDropdownGames();
		var command = new MyGame();
		var parameters = new DialogParameters<MyGameFormDialog>
			{
				{ x=>x.Refresh , new Action(async () => await ReloadData()) },
				{ x=>x.Model, command },
				{ x=>x.GameSelect, dropdownGames },
				{ x=>x.loading, loading },
				{ x=>x.EventCallBack, CreateGame }
			};
		var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
		var dialog = DialogService.Show<MyGameFormDialog>("Create Game", parameters, options);
		var state = await dialog.Result;
		if (!state.Canceled)
			await ReloadData();
	}

	public async Task OnUpdate(MyGame g)
	{
		var command = g;
		var dropdownGames = await gameService.GetDropdownGames();
		var parameters = new DialogParameters<MyGameFormDialog>
			{
				{ x=>x.Refresh , new Action(async () => await ReloadData()) },
				{ x=>x.Model, command },
				{ x=>x.GameSelect, dropdownGames },
				{ x=>x.loading, loading },
				{ x=>x.EventCallBack, UpdateGame }
			};
		var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
		var dialog = DialogService.Show<MyGameFormDialog>("Update Game", parameters, options);
		var state = await dialog.Result;
		if (!state.Canceled)
			await ReloadData();
	}

	public async Task OnDeleteChecked()
	{
		var ids = selectedItems.Select(x => x.Id).ToArray();

		foreach (var id in ids)
		{
			MyGame existing = await myGameService.GetById(id);
			await myGameService.DeleteAsync(existing.Id);
		}

		await ReloadData();
	}

	#endregion

	#region CRUD Actions
	async Task CreateGame(MyGame game)
	{
		loading = true;
		try
		{
			game.LuminaUserId = UserId;
			await myGameService.PostAsync(game);
			Snackbar.Add("Added Game to List", Severity.Success);
		}
		catch (Exception ex)
		{
			Snackbar.Add("Failed to create Game", Severity.Error);
			loading = false;
		}

		await ReloadData();
		loading = false;
	}

	async Task UpdateGame(MyGame game)
	{
		loading = true;
		try
		{
			game.LuminaUserId = UserId;
			await myGameService.PutAsync(game);
			Snackbar.Add("Updated Game", Severity.Success);
		}
		catch (Exception ex)
		{
			Snackbar.Add("Failed to update Game", Severity.Error);
			loading = false;
		}

		await ReloadData();
		loading = false;
	}

	public async Task Delete(MyGame g)
	{
		await myGameService.DeleteAsync(g.Id);
		Snackbar.Add("Deleted Game", Severity.Info);
		await ReloadData();
	}
	#endregion
}

