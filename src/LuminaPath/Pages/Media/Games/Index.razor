@page "/Media/Games"
@using LuminaPath.Core.Common.Entities
@using LuminaPath.Core.Common.Interfaces
@using AutoMapper
@using LuminaPath.Infrastructure.Services
@using LuminaPath.Pages.Media.Components
@using LuminaPath.Pages.Media.Games.Components
@using LuminaPath.UI.Shared.Interfaces
@using LuminaPath.UI.Shared.Media
@using LuminaPath.ViewModel
@using Microsoft.EntityFrameworkCore
@inject GameService gameService
@inject DocumentService documentService
@inject NavigationManager Navigation
@inject IMapper mapper
@implements ITableActions<Game>

<PageTitle>Games</PageTitle>

<h1>Games</h1>
<MudButton OnClick="SwitchView" Variant="Variant.Filled" Color="Color.Primary">@ToggleText</MudButton>
<AdvancedSearch Model="_filter" OnConditionChanged="ReloadData" />
@if (IsGrid)
{
	<MudDataGrid ServerData="@(ServerReload)"
				 FixedHeader="true"
				 FixedFooter="true"
				 Virtualize="true"
				 Height="calc(100vh - 370px)"
				 Loading="@loading"
				 MultiSelection="true"
				 @bind-SelectedItems="selectedItems"
				 @bind-SelectedItem="_currentDto"
				 Hover="true" @ref="_table">
		<ToolBarContent>
			<TableActions TItem="Game" Page="this" loading="loading" selectedItems="selectedItems" />
		</ToolBarContent>
		<Columns>
			<SelectColumn ShowInFooter="false"></SelectColumn>
			<TemplateColumn CellStyle="width:60px" Title="Actions" Sortable="false">
				<CellTemplate>
					<MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" DisableElevation="true" Size="Size.Small"
							 Dense="true"
							 EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
						<MudMenuItem OnClick="@(async () => await OnUpdate(context.Item))">Edit</MudMenuItem>

						<MudMenuItem OnClick="@(async () => await Delete(context.Item))">Delete</MudMenuItem>
					</MudMenu>
				</CellTemplate>
			</TemplateColumn>

			<PropertyColumn Property="x => x.Name" Title="Title">
				<CellTemplate>
					<div class="d-flex flex-column">
						<MudText Typo="Typo.body2">@context.Item.Name</MudText>
						<MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Description</MudText>
					</div>
				</CellTemplate>
			</PropertyColumn>
			<PropertyColumn Property="x => x.Genres" Title="Genre" >
				<CellTemplate>
					<div class="d-flex flex-column">
						<MudText Typo="Typo.body2" Class="mud-text-secondary">@string.Join(",", context.Item.Genres)</MudText>
					</div>
				</CellTemplate>
			</PropertyColumn>
		</Columns>
		<NoRecordsContent>
			<MudText>No items found</MudText>
		</NoRecordsContent>
		<LoadingContent>
			<MudText>Loading</MudText>
		</LoadingContent>
		<PagerContent>
			<MudDataGridPager />
		</PagerContent>
	</MudDataGrid>
}
else
{
	<MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="background-color:#121e2d;">
		<MudToolBar class="mud-table-toolbar">
			<TableActions Page="this" loading="loading" selectedItems="selectedItems" />
		</MudToolBar>
		<MudGrid Spacing="2">
			@foreach (var game in Games)
			{
				<MudItem>
					<MudCard Outlined="true">
						<MudCardMedia Image="@game.Image?.Url" Height="200" />
						<MudCardContent Style="height:80px;">
							<MudText Typo="Typo.h5">@game.Name</MudText>
							<MudText Typo="Typo.body2">@game.Description</MudText>
						</MudCardContent>
						<MudCardActions Style="height:50px;">
							<MudButton OnClick="@(() => OnUpdate(game))" Variant="Variant.Text" Color="Color.Primary">Edit</MudButton>
							<MudButton Variant="Variant.Text" Color="Color.Primary">Add To List</MudButton>
						</MudCardActions>
					</MudCard>
				</MudItem>
			}
		</MudGrid>
	</MudContainer>
}

<style>
	@@import url("https://cdn.jsdelivr.net/npm/@@fancyapps/ui@5.0/dist/fancybox/fancybox.css");

	.fancybox__container {
		--fancybox-bg: rgba(24, 24, 27, 0.85);
		z-index: 9999;
	}

	.mud-table-toolbar {
		height: 120px !important;
	}
</style>

@code{
	private List<Game> Games = new();
	private MudDataGrid<Game> _table = default!;
	private Game _currentDto = new();
	private MediaFilter _filter = new();
	private IBrowserFile? currentImage;

	public bool IsGrid = true;
	public bool loading;
	public HashSet<Game> selectedItems = new();
	public string ToggleText => IsGrid ? "Grid View" : "Table View";

	private async Task<GridData<Game>> ServerReload(GridState<Game> state)
	{
		selectedItems = new HashSet<Game>();
		loading = true;
		try
		{
			var result = await GetData(state.Page + 1);

			return new GridData<Game> { TotalItems = result.Count(), Items = result };
		}
		finally
		{
			loading = false;
		}
	}

	public async Task ReloadData()
	{
		if (IsGrid)
		{
			await _table.ReloadServerData();
		}
		else
		{
			Games = await GetData(1);
			StateHasChanged();
		}
	}

	private async Task SwitchView()
	{
		IsGrid = !IsGrid;
		await ReloadData();
	}

	private async Task<PaginatedList<Game>> GetData(int pageIndex)
	{
		_filter.Paging = new Paging(pageIndex, 15);
		var includes = new List<string>() { "Image" };
		return await gameService.GetAllPaginated(_filter, includes);
	}

	public void Dummy()
	{

	}

	#region Events
	public async Task OnCreate()
	{
		var command = new Game();
		var parameters = new DialogParameters<GameFormDialog>
			{
				{ x=>x.Refresh , new Action(async () => await ReloadData()) },
				{ x=>x.Model, command },
				{ x=>x.loading, loading },
				{ x=>x.EventCallBack, CreateGame },
				{ x=>x.OnSubmitFile, SubmitFile },
				{ x=>x.OnDeleteImage, DeleteImage }
			};
		var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
		var dialog = DialogService.Show<GameFormDialog>("Create Game", parameters, options);
		var state = await dialog.Result;
		if (!state.Canceled)
			await ReloadData();
	}

	public async Task OnUpdate(Game g)
	{
		var command = mapper.Map<Game, GameViewModel>(g);
		var parameters = new DialogParameters<GameFormDialog>
			{
				{ x=>x.Refresh , new Action(async () => await ReloadData()) },
				{ x=>x.Model, command },
				{ x=>x.loading, loading },
				{ x=>x.EventCallBack, UpdateGame },
				{ x=>x.OnSubmitFile, SubmitFile },
				{ x=>x.OnDeleteImage, DeleteImage }
			};
		var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
		var dialog = DialogService.Show<GameFormDialog>("Update Game", parameters, options);
		var state = await dialog.Result;
		if (!state.Canceled)
			await ReloadData();
	}

	public async Task OnDeleteChecked()
	{
		var ids = selectedItems.Select(x => x.Id).ToArray();

		foreach (var id in ids)
		{
			Game existing = await gameService.GetById(id);
			await DeleteMedia(existing);
		}

		await ReloadData();
	}

	#endregion

	#region CRUD Actions
	async Task CreateGame(Game game)
	{
		loading = true;
		try
		{
			await SaveFile(game);
			await gameService.PostAsync(game);
			Snackbar.Add("Created Game", Severity.Success);
		}
		catch (Exception ex)
		{
			Snackbar.Add("Failed to create Game", Severity.Error);
			loading = false;
		}

		await ReloadData();
		loading = false;
	}

	async Task UpdateGame(Game game)
	{
		loading = true;
		try
		{
			await SaveFile(game);
			await gameService.PutAsync(game);
			Snackbar.Add("Updated Game", Severity.Success);
		}
		catch (Exception ex)
		{
			Snackbar.Add("Failed to update Game", Severity.Error);
			loading = false;
		}

		await ReloadData();
		loading = false;
	}

	public async Task Delete(Game g)
	{
		await DeleteMedia(g);
		Snackbar.Add("Deleted Game", Severity.Info);
		await ReloadData();
	}

	private async Task DeleteMedia(Game g)
	{
		await gameService.DeleteAsync(g.Id);
	}

	private async Task SaveFile(Game game)
	{
		if (currentImage is not null)
		{
			var result = await documentService.CreateDocument(currentImage, game);
			game.Image = result.Match<Document>(
				s => s,
				f => null);
		}
		currentImage = null;
	}

	private async Task SubmitFile(IBrowserFile file)
	{
		await Task.Yield();
		currentImage = file;
	}

	private async Task DeleteImage(Game model)
	{
		if (model.Image != null)
		{
			await documentService.DeleteMediaDocument(model);
		}
	}
	#endregion
}

