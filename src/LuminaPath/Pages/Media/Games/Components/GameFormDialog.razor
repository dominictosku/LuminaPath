@using LuminaPath.Core.Common.Interfaces
@using LuminaPath.Core.Models
@using LuminaPath.Infrastructure.Services
@using LuminaPath.Pages.Media.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using LuminaPath.Core.Common.Entities.Results
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using Severity = MudBlazor.Severity
@using Color = MudBlazor.Color
@inherits MediaFormDialog<Game, MediaDocument>
@inject GameService gameService

<MudDialog>
	<DialogContent>
		<MudForm @ref="form" Model="Model">
			<div class="d-fex">
				<MudText Typo="Typo.body2">Image</MudText>
				@if (Model.Image is not null)
				{
					<div style="float:left; position: relative; width: 160px; height: 80px; margin: 10px;">
						<MudTooltip Delay="500" Text="@Model.Name">
							<MudImage ObjectFit="ObjectFit.Cover" Height="80" Width="160"
							Src="@Model.Image.Url"
							Alt="@Model.Name"
							Elevation="25"
							Class="mr-2 rounded-lg" />
						</MudTooltip>
						<div style="position: absolute;top: 0px;left: 0px; z-index: 2990;">
							<MudIconButton OnClick="@(() => PreviewImage())" Icon="@Icons.Material.Filled.Image" aria-label="preview" Color="Color.Info" Size="MudBlazor.Size.Small"></MudIconButton>
						</div>
						<div style="position: absolute;top: 0px;right: 0px; z-index: 2990;">
							<MudIconButton OnClick="@(async () => await DeleteImage())" Icon="@Icons.Material.Filled.Delete" aria-label="delete" Color="Color.Error" Size="MudBlazor.Size.Small"></MudIconButton>
						</div>
					</div>
				}
			</div>
			<MudGrid>
				<MudItem xs="12">
					<MudAutocomplete Label="Title" @bind-Value="Model.Name" Required="true"
					SearchFunc="@SearchAsync" Immediate="true" CoerceValue="true" ResetValueOnEmptyText="true"
					AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary"
					Validation="@(new Func<string, IEnumerable<string>>(Validate))"
					For="@(() => Model.Name)" />
					@if (success1)
					{
						<MudText Color="Color.Success">Success</MudText>
					}
				</MudItem>
				<MudItem xs="12">
					<MudTextField Label="Description"
					Lines="3"
					For="@(() => Model.Description)"
					@bind-Value="Model.Description">
					</MudTextField>
				</MudItem>
				<MudItem xs="12">
					<div class="d-flex flex-row gap-4 mb-2">
						<MudFileUpload T="IBrowserFile" FilesChanged="SubmitFile">
							<ActivatorContent>
								<MudButton Variant="Variant.Filled"
								Color="Color.Primary"
								StartIcon="@Icons.Material.Filled.CloudUpload"
								Disabled="_uploading">
									Upload Files
								</MudButton>
							</ActivatorContent>
						</MudFileUpload>
					</div>
				</MudItem>
			</MudGrid>
		</MudForm>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel">Cancel</MudButton>
		<MudButton OnClick="Submit" Disabled="@loading">
			@if (loading)
			{
				<span class="spinner-border spinner-border-sm mr-1"></span>
			}
			Save
		</MudButton>
	</DialogActions>
</MudDialog>

@code {
	MudForm form;
	private bool success1;


	private List<string> games = new();

	private async Task<IEnumerable<string>> SearchAsync(string value, CancellationToken token)
	{
		var dropdownGames = await gameService.GetDropdownGames(value);

		games = dropdownGames.Select(x => x.Name).ToList();

		return games;
	}

	private IEnumerable<string> Validate(string value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			yield return "The Title is required";
			yield break;
		}

		if (games.Contains(value))
		{
			yield return "Game already exists";
		}
	}
}