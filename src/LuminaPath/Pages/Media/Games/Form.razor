@using Core.Models.Gaming
@using Core.Interfaces
@using LuminaPath.ViewModel
@inject ILogger<Form> logger
@inject IAzureStorage Storage

<EditForm Model="@Game" OnValidSubmit="@OnValidSubmit" FormName="GameCreate">
    <DataAnnotationsValidator />
    <img src="@Game.ImageUrl" width="250" height="250" />
    <div class="form-group">
        <label>Image:</label>
        <div>
            <InputFile OnChange="@LoadFiles" class="form-control col-sm-3" />
        </div>
    </div>
    <div class="form-group">
        <label>Title :</label>
        <div>
            <InputText @bind-Value="@Game.Name" class="form-control col-sm-3" />
            <ValidationMessage For="@(() => Game.Name)" />
        </div>
    </div>
    <div class="form-group">
        <label>Description :</label>
        <div>
            <InputText @bind-Value="@Game.Description" class="form-control col-sm-3" />
            <ValidationMessage For="@(() => Game.Description)" />
        </div>
    </div>

    <div class="form-group">
        <button disabled="@loading" class="btn btn-primary">
            @if (loading)
            {
                <span class="spinner-border spinner-border-sm mr-1"></span>
            }
            @ButtonText
        </button>
        <NavLink href="/Media/Games" class="btn btn-link">Back</NavLink>
    </div>

</EditForm>

@code {
    [Parameter]
    public GameViewModel Game { get; set; }
    [Parameter]
    public string ButtonText { get; set; }
    [Parameter]
    public bool loading { get; set; } = false;
    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        loading = true;
        var file = e.File;
        await UploadFile(file);
        loading = false;
    }

    private async Task UploadFile(IBrowserFile file)
    {
        Stream fs = file.OpenReadStream();
        try
        {
            var blob = await Storage.UploadAsync(fs, Game.Name);
            Game.ImageUrl = blob.Blob.Uri;
        }
        catch (Exception e)
        {
            logger.LogError("Could not {0}. Error: {1}", "Upload File", e);
        }
    }
}