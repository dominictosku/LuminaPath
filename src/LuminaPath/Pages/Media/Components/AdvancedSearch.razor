@using Core.Entities

<MudExpansionPanel @bind-IsExpanded="_advancedSearchExpanded"
                   Style="border-radius: var(--mud-default-borderradius) !important;"
                   Class="mud-elevation-25 pa-2 mb-3" Text="Filter">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField @bind-Value="Model.SearchString" 
                          Placeholder="Search Media"
                          Clearable="true"
                          TextChanged="TextChanged">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudDatePicker Clearable="true" @bind-Value="@Model.From"
                           Placeholder="From"
                           TextChanged="TextChanged">
            </MudDatePicker>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudDatePicker @bind-Value="@Model.To"
                             Clearable="true"
                             Placeholder="To"
                           TextChanged="TextChanged">
            </MudDatePicker>
        </MudItem>
    </MudGrid>
</MudExpansionPanel>

@code
{
    [EditorRequired][Parameter]
    public MediaFilter Model { get; set; } = default!;
    [EditorRequired][Parameter]
    public EventCallback<string> OnConditionChanged { get; set; }

    public DateTime From { get; set; }
    public DateTime To { get; set; }

    private bool _advancedSearchExpanded;

    private async Task TextChanged(string date)
    {
        if (_advancedSearchExpanded)
        {
            await OnConditionChanged.InvokeAsync(date);
        }
    }

}