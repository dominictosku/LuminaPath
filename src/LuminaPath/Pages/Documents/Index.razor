@page "/Documents"
@using AutoMapper
@using LuminaPath.Core.Common.Entities
@using LuminaPath.Infrastructure.Services
@using LuminaPath.Pages.Documents.Components
@using LuminaPath.UI.Shared.Interfaces
@using LuminaPath.UI.Shared.Media
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Administrator, Editor")]
@inject DocumentService DocumentService
@inject GameService gameService
@inject NavigationManager navigation
@inject IMapper mapper
@inject ILogger<Index> logger
@implements ITableActions<MediaDocument>

<PageTitle>MediaDocuments</PageTitle>

<h1>MediaDocuments</h1>
<MudButton OnClick="SwitchView" Variant="Variant.Filled" Color="Color.Primary">@ToggleText</MudButton>
<AdvancedSearch Model="_filter" OnConditionChanged="ReloadData" />
<LuminaPath.Pages.Media.Components.LuminaGrid ServerData="@(ServerReload)"
             Loading="@loading"
             MultiSelection="true"
             @bind-SelectedItems="selectedItems"
             @bind-SelectedItem="_currentDto"
             @ref="_table">
    <ToolBarContent>
        <TableActions TItem="MediaDocument" Page="this" loading="loading" selectedItems="selectedItems" />
    </ToolBarContent>
    <Columns>
        <SelectColumn ShowInFooter="false"></SelectColumn>
        <TemplateColumn CellStyle="width:60px" Title="Actions" Sortable="false">
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" DisableElevation="true" Size="Size.Small"
                         Dense="true"
                         EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
                    <MudMenuItem OnClick="@(() => OnUpdate(context.Item))">Edit</MudMenuItem>

                    <MudMenuItem OnClick="@(() => Delete(context.Item))">Delete</MudMenuItem>
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.Name" Title="Title">
            <CellTemplate>
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body2">@context.Item.Name</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Description</MudText>
                </div>
            </CellTemplate>
        </PropertyColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>No items found</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager />
    </PagerContent>
</LuminaPath.Pages.Media.Components.LuminaGrid>

<style>
    @@import url("https://cdn.jsdelivr.net/npm/@@fancyapps/ui@5.0/dist/fancybox/fancybox.css");

    .fancybox__container {
        --fancybox-bg: rgba(24, 24, 27, 0.85);
        z-index: 9999;
    }

    .mud-table-toolbar {
        height: 120px !important;
    }
</style>

@code{
    private MudDataGrid<MediaDocument> _table = default!;
    private MediaDocument _currentDto = new();
    private MediaFilter _filter = new();

    [Inject]
    public IStorageService Storage { get; set; } = default!;

    [Inject]
    public ILogger<Index> Logger { get; set; } = default!;

    public bool IsGrid = true;
    public bool loading;
    public HashSet<MediaDocument> selectedItems = new();
    public string ToggleText => IsGrid ? "Grid View" : "Table View";

    private async Task<GridData<MediaDocument>> ServerReload(GridState<MediaDocument> state)
    {
        selectedItems = new HashSet<MediaDocument>();
        loading = true;
        try
        {
            var result = await GetData(state.Page + 1);

            return new GridData<MediaDocument> { TotalItems = result.Count(), Items = result };
        }
        finally
        {
            loading = false;
        }
    }

    public async Task ReloadData()
    {
        await _table.ReloadServerData();
    }

    private async Task SwitchView()
    {
        IsGrid = !IsGrid;
        await ReloadData();
    }

    private async Task<PaginatedList<MediaDocument>> GetData(int pageIndex)
    {
        var paging = new Paging(pageIndex, 15);
        return await DocumentService.GetAllPaginated(paging);
    }

    public void Dummy()
    {

    }

    #region Events
    public async Task OnCreate()
    {
        var command = new MediaDocument();
        var parameters = new DialogParameters<DocumentFormDialog>
        {
            { x=>x.Refresh , new Action(async () => await ReloadData()) },
            { x=>x.Model, command },
            { x=>x.loading, loading },
            { x=>x.EventCallBack, Create }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<DocumentFormDialog>("Create MediaDocument", parameters, options);
        var state = await dialog.Result;
        if (!state.Canceled)
            await ReloadData();
    }

    public async Task OnUpdate(MediaDocument entity)
    {
        var command = entity;
        var parameters = new DialogParameters<DocumentFormDialog>
        {
            { x=>x.Refresh , new Action(async () => await ReloadData()) },
            { x=>x.Model, command },
            { x=>x.loading, loading },
            { x=>x.EventCallBack, Update }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<DocumentFormDialog>("Update MediaDocument", parameters, options);
        var state = await dialog.Result;
        if (!state.Canceled)
            await ReloadData();
    }

    public async Task OnDeleteChecked()
    {
        var ids = selectedItems.Select(x => x.Id).ToArray();

        foreach (var id in ids)
        {
            await gameService.DeleteAsync(id);
        }

        await ReloadData();
    }

    #endregion

    #region CRUD Actions
    async Task Create(MediaDocument entity)
    {
        loading = true;
        try
        {
            Snackbar.Add("Created MediaDocument", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to create MediaDocument", Severity.Error);
            loading = false;
        }

        await ReloadData();
        loading = false;
    }

    async Task Update(MediaDocument entity)
    {
        loading = true;
        try
        {
            Snackbar.Add("Updated Game", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to update Game", Severity.Error);
            loading = false;
        }

        await ReloadData();
        loading = false;
    }

    public async Task Delete(MediaDocument entity)
    {
        await DocumentService.DeleteDocument(entity);

        Snackbar.Add("Deleted MediaDocument", Severity.Info);
        await ReloadData();
    }
    #endregion
}

