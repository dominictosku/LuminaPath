# Copy this file to .env before running Docker Compose.
# Most settings already have safe defaults in docker-compose.yml.
# Full optional reference: docs/05-runbooks/configuration.md

# Required first-run values
POSTGRES_PASSWORD=
LUMINAPATH_ADMIN_EMAIL=
LUMINAPATH_ADMIN_PASSWORD=

# Optional file-based secrets. These paths must exist inside the container.
# POSTGRES_PASSWORD_FILE=/run/secrets/luminapath_postgres_password
# LUMINAPATH_ADMIN_PASSWORD_FILE=/run/secrets/luminapath_admin_password

# Common optional overrides
# BACKEND_HTTP_PORT=8080
# FRONTEND_HTTP_PORT=4200
# RUN_MIGRATIONS_ON_STARTUP=false
# AUTH_REQUIRE_ADMIN_APPROVAL=true

# Set only when browsers call the API from a different origin than the API host.
# The Docker frontend uses /api and proxies internally, so this is usually blank.
# FRONTEND_PUBLIC_URL=https://luminapath.yourdomain.com

# Storage defaults to local file-system storage.
# STORAGE_PROVIDER=FileSystem
# STORAGE_PATH=/app/App_Data/storage
# STORAGE_PROVIDER=Azure
# AZURE_BLOB_CONNECTION_STRING=
# AZURE_BLOB_CONTAINER_NAME=media

# Optional Angular frontend runtime values.
# LUMINAPATH_API_ENDPOINT=/api
# LUMINAPATH_API_PROXY_TARGET=http://api:8080

# Optional local vLLM AI stack. Use with docker-compose.vllm.yml and an amd/nvidia profile.
# COMPOSE_PROFILES=amd
# VLLM_MODEL=NousResearch/Hermes-3-Llama-3.1-8B
# VLLM_API_KEY=local-vllm
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# Optional pgAdmin tool container. Use with docker-compose.tools.yml.
# PGADMIN_DEFAULT_EMAIL=admin@example.com
# PGADMIN_DEFAULT_PASSWORD=admin
