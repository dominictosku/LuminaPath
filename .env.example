# Copy this file to .env before running Docker Compose.

# Images
LUMINAPATH_API_IMAGE=luminapath-api:local
LUMINAPATH_FRONTEND_IMAGE=luminapath-frontend:local

# Public ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
BACKEND_HTTP_PORT=8080
FRONTEND_HTTP_PORT=4200
POSTGRES_PORT=5432
PGADMIN_HTTP_PORT=5050

# PostgreSQL
POSTGRES_VERSION=17-alpine
POSTGRES_DB=luminapath
POSTGRES_USER=luminapath
POSTGRES_PASSWORD=change-me

# ASP.NET backend
ASPNETCORE_ENVIRONMENT=Production
RUN_MIGRATIONS_ON_STARTUP=true
HTTPS_REDIRECT=false        # nginx handles TLS, backend stays on plain HTTP internally
FRONTEND_PUBLIC_URL=https://localhost
IONIC_PUBLIC_URL=https://localhost
CAPACITOR_ANDROID_PUBLIC_URL=http://localhost
CAPACITOR_ANDROID_HTTPS_PUBLIC_URL=https://localhost
AUTH_COOKIE_SAMESITE=None
AUTH_COOKIE_SECURE_POLICY=Always

# Storage
STORAGE_PROVIDER=FileSystem
STORAGE_PATH=/app/App_Data/storage
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=media

# Angular Docker frontend
LUMINAPATH_API_ENDPOINT=/api
LUMINAPATH_API_PROXY_TARGET=http://api:8080
# Optional pgAdmin
PGADMIN_VERSION=latest
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
